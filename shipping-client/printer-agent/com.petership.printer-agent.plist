<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- PeterShip printer agent as a macOS login service. Copy to ~/Library/LaunchAgents/ and
     launchctl load it. Edit the node path if `which node` says somewhere else. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.petership.printer-agent</string>
  <key>ProgramArguments</key><array><string>/usr/local/bin/node</string><string>agent.mjs</string></array>
  <key>WorkingDirectory</key><string>/Users/counter/PeterShip/printer-agent</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/counter/PeterShip/printer-agent/agent.log</string>
  <key>StandardErrorPath</key><string>/Users/counter/PeterShip/printer-agent/agent.log</string>
</dict></plist>
