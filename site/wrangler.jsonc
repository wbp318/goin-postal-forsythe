{
  // Cloudflare config. Secrets (EASYSHIP_TOKEN, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, COUNTER_PIN)
  // are NOT here. Locally they go in .dev.vars (gitignored); in production set them with
  // `npx wrangler secret put NAME` or in the Cloudflare dashboard.
  "name": "goin-postal-forsythe",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    // Orders: quote -> paid -> labeled. Create the real namespace with
    // `npx wrangler kv namespace create ORDERS` and paste its id here.
    { "binding": "ORDERS", "id": "REPLACE_WITH_KV_ID" }
  ],
  "d1_databases": [
    // Shipping client records: shipments, customers, drop-offs, tracking, rules, staff, print queue.
    // Create with `npx wrangler d1 create goin-postal`, paste the id, then
    // `npx wrangler d1 execute goin-postal --file db/schema.sql`.
    { "binding": "DB", "database_name": "goin-postal", "database_id": "REPLACE_WITH_D1_ID" }
  ],
  "vars": {
    "STORE_ID": "forsythe",
    "SITE_URL": "http://localhost:4321"
  },
  // A second store is the same code with its own storage, secrets and facts. Add a block here per store
  // (scripts/new-store.py prints the commands) and deploy it with `--env <slug>`, or give that store its
  // own Cloudflare project pointing at this repo with these values set in the dashboard. The store's
  // name, address, hours and ship-from address come from the STORE_JSON secret (site/stores/<slug>.json).
  "env": {
    "west-carroll": {
      "name": "goin-postal-west-carroll",
      "kv_namespaces": [{ "binding": "ORDERS", "id": "REPLACE_WITH_THAT_STORES_KV_ID" }],
      "d1_databases": [{ "binding": "DB", "database_name": "goin-postal-west-carroll", "database_id": "REPLACE_WITH_THAT_STORES_D1_ID" }],
      "vars": { "STORE_ID": "west-carroll", "SITE_URL": "https://REPLACE.goinpostal.site" }
    }
  }
}
