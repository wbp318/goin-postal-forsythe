---
import '../styles/global.css';
import { LANGS } from '../i18n/strings';
// The picker's order: English, then Vietnamese, Afrikaans, Spanish, French, Portuguese and Dutch at the top (the owners' ask), the rest as listed.
const LANG_MENU_TOP = ['en', 'vi', 'af', 'es', 'fr', 'pt', 'nl'];
const LANG_MENU_ORDER: string[] = [...LANG_MENU_TOP, ...LANGS.map((l) => l.code).filter((c) => !LANG_MENU_TOP.includes(c))];
import { store } from '../data/store';
interface Props { title: string; description?: string }
const { title, description = `Shipping, packing, mailboxes and printing at ${store.address}.` } = Astro.props;
// The brand reads "Goin' Postal" plus the store's own word: Forsythe, Oak Grove.
const brandRest = store.name.replace(/^Goin' Postal\s*/i, '') || store.name;
// The nav tab for the page being viewed is drawn pressed (aria-current).
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const cur = (p: string) => (here === p || (p !== '/' && here.startsWith(p + '/')) ? 'page' : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#main" data-i18n="a11y.skip">Skip to content</a>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="/">Goin' Postal <span>{brandRest}</span></a>
        <nav>
          <a href="/ship" class="ps-tab" aria-current={cur('/ship')} data-i18n="home.cta">Ship a package</a>
          <a href="/track" aria-current={cur('/track')} data-i18n="nav.track">Track</a>
          <a href="/cards" aria-current={cur('/cards')} data-i18n="nav.cards">Business cards</a>
          <a href="/#services" data-i18n="nav.services">Services</a>
          <a href="/#hours" data-i18n="nav.hours">Hours</a>
          <a href="/contact" aria-current={cur('/contact')} data-i18n="nav.contact">Contact</a>
          <a href="/account" aria-current={cur('/account')} data-i18n="nav.account">Account</a>
          <a href="/petership" aria-current={cur('/petership')} data-i18n="nav.about">About PeterShip</a>
          {Astro.url.pathname.startsWith('/counter') && store.siblings && store.siblings.length > 0 && (
            <select id="storeSwitch" aria-label="Store" title="Store">
              <option value="">{store.name}</option>
              {store.siblings.map((s) => <option value={s.url}>{s.name}</option>)}
            </select>
          )}
          <label class="lang-label" for="lang"><span lang="en">Language</span> / <span lang="vi">Ngôn ngữ</span></label>
          <select id="lang" aria-label="Language / Ngôn ngữ" title="Language / Ngôn ngữ">
            {[...LANGS].sort((a, b) => LANG_MENU_ORDER.indexOf(a.code) - LANG_MENU_ORDER.indexOf(b.code)).map((l) => <option value={l.code}>{l.name}</option>)}
          </select>
          <span class="a11y" role="group" aria-label="Text size">
            <span class="a11y-label" data-i18n="a11y.text">Text size</span>
            <button type="button" class="size" data-size="0" aria-label="Smaller text">A&minus;</button>
            <button type="button" class="size" data-size="1" aria-label="Normal text">A</button>
            <button type="button" class="size" data-size="2" aria-label="Larger text">A+</button>
            <button type="button" class="size" data-size="3" aria-label="Even larger text">A++</button>
            <button type="button" class="size" data-size="4" aria-label="Largest text">A+++</button>
            <button type="button" class="size contrast" id="contrast" aria-pressed="false"><span data-i18n="a11y.contrast">High contrast</span></button>
          </span>
        </nav>
      </div>
    </header>
    <main class="wrap" id="main">
      <slot />
    </main>
    <footer>
      <div class="wrap">
        {store.name} · {store.address}.
        <span data-i18n="footer">Goin' Postal's name and logo belong to GP Brands. Independently owned and operated.</span>
        · <a href="/counter" data-i18n="st.in.link">Staff sign-in</a>
      </div>
    </footer>
    <script>
      import { apply, setLang, t, tf, type Lang } from '../i18n';
      (window as any).t = t; (window as any).tf = tf; // for the inline scripts on the order pages
      apply();
      // Staff pages keep working when the shop's internet drops: see public/counter-sw.js.
      if (location.pathname.startsWith('/counter/') && 'serviceWorker' in navigator) navigator.serviceWorker.register('/counter-sw.js', { scope: '/counter/' }).catch(() => {});
      // Staff pages keep working when the shop's internet drops: see public/counter-sw.js.
      if (location.pathname.startsWith('/counter/') && 'serviceWorker' in navigator) navigator.serviceWorker.register('/counter-sw.js', { scope: '/counter/' }).catch(() => {});
      // Text size and contrast, remembered on this device.
      const root = document.documentElement;
      const get = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
      const set = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
      function size(n: string) { root.dataset.size = n; set('gp-size', n); document.querySelectorAll<HTMLElement>('.size[data-size]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.size === n))); }
      function contrast(on: boolean) { root.dataset.contrast = on ? 'high' : ''; set('gp-contrast', on ? '1' : '0'); document.getElementById('contrast')!.setAttribute('aria-pressed', String(on)); }
      size(get('gp-size') ?? '2');
      contrast(get('gp-contrast') === '1'); // off unless the visitor turned it on (v1.70.0: the glossy look is the default; High contrast is one click away)
      document.querySelectorAll<HTMLElement>('.size[data-size]').forEach((b) => b.addEventListener('click', () => size(b.dataset.size!)));
      document.getElementById('contrast')!.addEventListener('click', () => contrast(root.dataset.contrast !== 'high'));
      document.getElementById('lang')!.addEventListener('change', (e) => { const el = e.target as HTMLSelectElement; setLang(el.value as Lang); el.blur(); });
    </script>
      <script>
      // Store switcher (T23): the same counter page on the other store's deployment.
      const sw = document.getElementById('storeSwitch') as HTMLSelectElement | null;
      sw?.addEventListener('change', () => { if (sw.value) location.href = sw.value.replace(/\/$/, '') + location.pathname; });
    </script>
  </body>
</html>
