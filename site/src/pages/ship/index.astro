---
import { store } from '../../data/store';
import Base from '../../layouts/Base.astro';
const cancelled = Astro.url.searchParams.get('cancelled');
---
<Base title={`Ship a package · ${store.name}`} description="Compare USPS, UPS, FedEx and DHL rates and buy a label online. Print at home or show a QR code at the counter.">
  <section class="hero">
    <h1 data-i18n="ship.h1">Ship a package</h1>
    <p class="lead" data-i18n="ship.lead">Compare USPS, UPS, FedEx and DHL in one place. Pay online and print at home, or show us the QR code and we print it at the counter.</p>
    {cancelled && <p class="card" data-i18n="ship.cancelled">Payment was cancelled. Your quote is below if you want to try again.</p>}
  </section>

  <form id="quote" class="ship-form">
    <fieldset>
      <legend data-i18n="ship.where">Where is it going?</legend>
      <label><span data-i18n="ship.recipient">Recipient name</span> <input name="contact_name" required /></label>
      <label><span data-i18n="ship.street">Street address</span> <input name="line_1" required maxlength="35" /></label>
      <label><span data-i18n="ship.apt">Apt, suite (optional)</span> <input name="line_2" maxlength="35" /></label>
      <div class="row">
        <label><span data-i18n="ship.city">City</span> <input name="city" required /></label>
        <label><span data-i18n="ship.state">State</span> <input name="state" placeholder="LA" maxlength="2" /></label>
        <label><span data-i18n="ship.zip">ZIP / postal code</span> <input name="postal_code" required /></label>
      </div>
      <label><span data-i18n="ship.country">Country</span>
        <select name="country_alpha2">
          <option value="US" selected>United States</option>
          <option value="CA">Canada</option>
          <option value="MX">Mexico</option>
          <option value="GB">United Kingdom</option>
          <option value="AU">Australia</option>
          <option value="DE">Germany</option>
          <option value="FR">France</option>
          <option value="JP">Japan</option>
          <option value="OTHER">Other country</option>
        </select>
      </label>
      <label class="hidden" id="otherCountry"><span data-i18n="ship.other">Two-letter country code</span> <input name="country_other" maxlength="2" placeholder="e.g. IT" /></label>
    </fieldset>

    <fieldset>
      <legend data-i18n="ship.what">What is it?</legend>
      <div class="row">
        <label><span data-i18n="ship.weight">Weight (lb)</span> <input name="weight_lb" type="number" step="0.1" min="0.1" max="150" required /></label>
        <label><span data-i18n="ship.length">Length (in)</span> <input name="length_in" type="number" min="1" required /></label>
        <label><span data-i18n="ship.width">Width (in)</span> <input name="width_in" type="number" min="1" required /></label>
        <label><span data-i18n="ship.height">Height (in)</span> <input name="height_in" type="number" min="1" required /></label>
      </div>
      <label><span data-i18n="ship.desc">What's inside (needed for international)</span> <input name="description" maxlength="80" placeholder="Clothing" /></label>
      <label><span data-i18n="ship.value">Value in USD</span> <input name="value_usd" type="number" min="1" placeholder="25" /></label>
    </fieldset>

    <button class="btn" type="submit" data-i18n="ship.getrates">Get rates</button>
    <p id="err" class="err" hidden></p>
  </form>

  <section id="results" hidden>
    <h2 data-i18n="ship.rates">Rates</h2>
    <p id="intlNote" class="card" hidden data-i18n="ship.intl">International shipments are paid in the shop. Reserve the rate here, bring the package and the pickup code in, and we handle customs forms and payment with you at the counter.</p>
    <p id="addrNote" class="card" hidden></p>
    <p id="packNote" class="muted" hidden></p>
    <p id="mockNote" class="card" hidden data-i18n="ship.mock">Demo rates for testing. Live carrier rates appear once the store connects its accounts.</p>
    <div id="rates" class="rates"></div>
    <form id="buy" class="buy" hidden>
      <label><span data-i18n="ship.email">Your email (for the receipt and label)</span> <input name="email" type="email" required /></label>
      <label class="check" id="insRow" hidden><input name="insure" type="checkbox" /> <span data-i18n="ship.insure">Insure it for the full value</span> <span id="insFee" class="muted"></span></label>
      <p id="insCovered" class="muted" hidden></p>
      <p id="feeRow" class="muted" hidden></p>
      <p id="totalRow" class="price"><span data-i18n="ship.total">Total</span>: <strong id="totalAmt"></strong></p>
      <label class="check"><input name="sms" type="checkbox" /> <span data-i18n="ship.sms">Text me when it ships and when it is delivered</span> <span id="smsFee" class="muted"></span></label>
      <label id="phoneRow" hidden><span data-i18n="ship.phone">Your mobile number</span> <input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="318 555 0100" /></label>
      <button class="btn" type="submit" id="buyBtn" data-i18n="ship.continue">Continue</button>
    </form>
  </section>

  <script>
    import { t } from '../../i18n';
    const f = document.getElementById('quote') as HTMLFormElement;
    const err = document.getElementById('err')!;
    const results = document.getElementById('results')!;
    const ratesEl = document.getElementById('rates')!;
    const buy = document.getElementById('buy') as HTMLFormElement;
    const buyBtn = document.getElementById('buyBtn')!;
    const countrySel = f.querySelector('[name=country_alpha2]') as HTMLSelectElement;
    const other = document.getElementById('otherCountry')!;
    countrySel.addEventListener('change', () => other.classList.toggle('hidden', countrySel.value !== 'OTHER'));

    let payload: any = null;
    let picked: string | null = null;
    let pickedPrice = 0;
    let international = false;
    let extras: any = null;
    const insBox = buy.querySelector('[name=insure]') as HTMLInputElement;
    function total() {
      const ins = insBox.checked && extras && !extras.insurance.covered ? extras.insurance.fee : 0;
      const smsOn = (buy.querySelector('[name=sms]') as HTMLInputElement).checked;
      const text = smsOn && extras?.text_updates_price ? extras.text_updates_price : 0;
      const subtotal = pickedPrice + ins + text;
      const f = extras?.online_fee && (extras.online_fee.percent || extras.online_fee.flat) && !international ? Math.round((subtotal * extras.online_fee.percent / 100 + extras.online_fee.flat) * 100) / 100 : 0;
      const feeRow = document.getElementById('feeRow')!;
      feeRow.hidden = !f;
      if (f) feeRow.textContent = t('ship.fee').replace('{fee}', f.toFixed(2)).replace('{pct}', String(extras.online_fee.percent));
      document.getElementById('totalAmt')!.textContent = `$${(subtotal + f).toFixed(2)}`;
    }
    insBox.addEventListener('change', total);

    function read() {
      const d = Object.fromEntries(new FormData(f).entries()) as Record<string, string>;
      const country = d.country_alpha2 === 'OTHER' ? d.country_other.toUpperCase() : d.country_alpha2;
      return {
        destination: { contact_name: d.contact_name, line_1: d.line_1, line_2: d.line_2, city: d.city, state: d.state, postal_code: d.postal_code, country_alpha2: country },
        parcel: { weight_lb: d.weight_lb, length_in: d.length_in, width_in: d.width_in, height_in: d.height_in, description: d.description, value_usd: d.value_usd },
      };
    }

    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true; results.hidden = true; buy.hidden = true; picked = null;
      payload = read();
      const res = await fetch('/api/rates', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      const j = await res.json();
      if (!res.ok) { err.textContent = j.error; err.hidden = false; return; }
      international = j.international;
      extras = j.extras;
      document.getElementById('smsFee')!.textContent = extras?.text_updates_price ? t('ship.textfee').replace('{fee}', extras.text_updates_price.toFixed(2)) : '';
      const insRow = document.getElementById('insRow')!, insCovered = document.getElementById('insCovered')!;
      if (extras?.insurance.covered) { insRow.hidden = true; insBox.checked = false; insCovered.hidden = false; insCovered.textContent = t('ship.inscovered').replace('{n}', String(extras.insurance.included_usd)); }
      else { insRow.hidden = false; insCovered.hidden = true; document.getElementById('insFee')!.textContent = t('ship.insfee').replace('{fee}', extras.insurance.fee.toFixed(2)).replace('{value}', String(extras.insurance.declared_usd)); }
      document.getElementById('intlNote')!.hidden = !international;
      const an = document.getElementById('addrNote')!, ad = j.address;
      if (ad && (ad.errors.length || ad.warnings.length)) { an.textContent = [...ad.errors, ...ad.warnings].join(' '); an.className = ad.errors.length ? 'err' : 'card'; an.hidden = false; } else an.hidden = true;
      const pk = j.packing, pn = document.getElementById('packNote')!;
      if (pk && pk.dim_applies) { const top = pk.billable.reduce((a: any, b: any) => (b.lb > a.lb ? b : a)); pn.textContent = t('ship.packing.dim').replace('{actual}', String(pk.actual_lb)).replace('{billable}', String(top.lb)).replace('{carrier}', top.carrier) + (pk.better ? ' ' + t('ship.packing.better').replace('{box}', pk.better.box.name).replace('{saves}', String(pk.better.saves_lb)) : ''); pn.hidden = false; }
      else if (pk && pk.oversize) { pn.textContent = t('ship.packing.oversize'); pn.hidden = false; }
      else pn.hidden = true;
      document.getElementById('mockNote')!.hidden = !j.demo;
      buyBtn.dataset.i18n = international ? 'ship.reserve' : 'ship.pay';
      buyBtn.textContent = t(buyBtn.dataset.i18n);
      ratesEl.innerHTML = '';
      for (const r of j.rates) {
        const el = document.createElement('label');
        el.className = 'rate card';
        el.innerHTML = `<input type="radio" name="rate" value="${r.id}">
          <span class="carrier">${r.carrier}</span>
          <span class="service">${r.service}</span>
          <span class="days">${r.min_days ?? '?'}–${r.max_days ?? '?'} ${t('ship.days')}</span>
          <span class="price">$${r.total_charge.toFixed(2)}</span>`;
        el.querySelector('input')!.addEventListener('change', () => { picked = r.id; pickedPrice = r.total_charge; buy.hidden = false; total(); });
        ratesEl.appendChild(el);
      }
      results.hidden = false;
      results.scrollIntoView({ behavior: 'smooth' });
    });

    const smsBox = buy.querySelector('[name=sms]') as HTMLInputElement;
    const phoneRow = document.getElementById('phoneRow') as HTMLElement;
    smsBox.addEventListener('change', () => { phoneRow.hidden = !smsBox.checked; if (smsBox.checked) (buy.querySelector('[name=phone]') as HTMLInputElement).focus(); total(); });
    buy.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!picked) return;
      buyBtn.setAttribute('disabled', '');
      const email = (buy.querySelector('[name=email]') as HTMLInputElement).value;
      const sms = (buy.querySelector('[name=sms]') as HTMLInputElement).checked;
      const phone = (buy.querySelector('[name=phone]') as HTMLInputElement).value;
      const insure = insBox.checked;
      const res = await fetch('/api/orders', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...payload, email, sms, phone, rate_id: picked, insure }) });
      const j = await res.json();
      if (!res.ok) { err.textContent = j.error; err.hidden = false; buyBtn.removeAttribute('disabled'); return; }
      location.href = j.next;
    });
  </script>
</Base>
