---
export const prerender = false;
import { store } from '../../data/store';
import Base from '../../layouts/Base.astro';
import { env } from '../../lib/env';
import { readSession } from '../../lib/session';
import { getCustomer, listCustomerAddresses } from '../../shipping/store';
const cancelled = Astro.url.searchParams.get('cancelled');
// Signed-in customers (T20) get their saved addresses and their email filled in.
const meId = await readSession(env, Astro.request.headers.get('cookie'));
const me = meId ? await getCustomer(env, meId) : null;
const saved = me ? (await listCustomerAddresses(env, me.id)).map((a) => ({ id: a.id, label: a.label, to: JSON.parse(a.address_json) })) : [];
const wantTo = Number(Astro.url.searchParams.get('to')) || 0;
---
<Base title={`Ship a package · ${store.name}`} description="Compare USPS, UPS, FedEx and DHL rates and buy a label online. Print at home or show a QR code at the counter.">
  <section class="hero">
    <p class="ps-kicker" data-i18n="home.ps.kicker">PeterShip, our shipping counter on the web</p>
    <h1 data-i18n="ship.h1">Ship a package</h1>
    <p class="lead" data-i18n="ship.lead">Compare USPS, UPS, FedEx and DHL in one place. Pay online and print at home, or show us the QR code and we print it at the counter.</p>
    {cancelled && <p class="card" data-i18n="ship.cancelled">Payment was cancelled. Your quote is below if you want to try again.</p>}
  </section>

  {me && <p class="card"><span data-i18n="acct.hello">Signed in as</span> <strong>{me.name}</strong> · <a href="/account" data-i18n="acct.h1">Your account</a>{saved.length > 0 && <> · <label><span data-i18n="acct.useaddr">Ship to a saved address</span> <select id="savedSel"><option value="">…</option>{saved.map((a) => <option value={a.id} selected={a.id === wantTo}>{a.label}: {a.to.contact_name}, {a.to.city}</option>)}</select></label></>}</p>}
  <form id="quote" class="ship-form">
    <fieldset>
      <legend data-i18n="ship.from">Return address (who is sending it)</legend>
      <p class="muted" data-i18n="ship.from.lead">Printed on the label as the sender. The carrier brings the package back here if it cannot be delivered.</p>
      <label><span data-i18n="ship.sender">Your name</span> <input name="from_contact_name" required maxlength="35" autocomplete="name" value={me?.name ?? ''} /></label>
      <label><span data-i18n="ship.street">Street address</span> <input name="from_line_1" required maxlength="35" autocomplete="address-line1" /></label>
      <label><span data-i18n="ship.apt">Apt, suite (optional)</span> <input name="from_line_2" maxlength="35" autocomplete="address-line2" /></label>
      <div class="row">
        <label><span data-i18n="ship.city">City</span> <input name="from_city" required autocomplete="address-level2" /></label>
        <label><span data-i18n="ship.state">State</span> <input name="from_state" required placeholder="LA" maxlength="2" autocomplete="address-level1" /></label>
        <label><span data-i18n="ship.zip">ZIP / postal code</span> <input name="from_postal_code" required autocomplete="postal-code" inputmode="numeric" maxlength="10" /></label>
      </div>
    </fieldset>
    <fieldset>
      <legend data-i18n="ship.where">Where is it going?</legend>
      <label><span data-i18n="ship.recipient">Recipient name</span> <input name="contact_name" required autocomplete="shipping name" /></label>
      <label class="typeahead"><span data-i18n="ship.street">Street address</span> <input name="line_1" required maxlength="35" autocomplete="shipping address-line1" placeholder="1800 Forsythe Ave, Monroe" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="addrList" /><ul id="addrList" class="suggest" role="listbox" hidden></ul></label>
      <label><span data-i18n="ship.apt">Apt, suite (optional)</span> <input name="line_2" maxlength="35" autocomplete="shipping address-line2" /></label>
      <div class="row">
        <label><span data-i18n="ship.city">City</span> <input name="city" required autocomplete="shipping address-level2" /></label>
        <label><span data-i18n="ship.state">State</span> <input name="state" placeholder="LA" maxlength="2" autocomplete="shipping address-level1" /></label>
        <label><span data-i18n="ship.zip">ZIP / postal code</span> <input name="postal_code" required autocomplete="shipping postal-code" inputmode="numeric" /></label>
      </div>
      <input type="hidden" name="country_alpha2" value="US" />
    </fieldset>

    <fieldset>
      <legend data-i18n="ship.what">What is it?</legend>
      <div class="row">
        <label><span data-i18n="ship.weight">Weight (lb)</span> <input name="weight_lb" type="number" step="0.1" min="0.1" max="150" required /></label>
        <label><span data-i18n="ship.length">Length (in)</span> <input name="length_in" type="number" min="1" required /></label>
        <label><span data-i18n="ship.width">Width (in)</span> <input name="width_in" type="number" min="1" required /></label>
        <label><span data-i18n="ship.height">Height (in)</span> <input name="height_in" type="number" min="1" required /></label>
      </div>
      <label><span data-i18n="ship.desc">What's inside</span> <input name="description" maxlength="80" placeholder="Clothing" /></label>
      <label><span data-i18n="ship.value">Value in USD</span> <input name="value_usd" type="number" min="1" placeholder="25" /></label>
    </fieldset>

    <button class="btn" type="submit" data-i18n="ship.getrates">Get rates</button>
    <p id="err" class="err" hidden></p>
  </form>

  <section id="results" hidden>
    <h2 data-i18n="ship.rates">Rates</h2>
    <p id="addrNote" class="card" hidden></p>
    <p id="packNote" class="muted" hidden></p>
    <p id="mockNote" class="card" hidden data-i18n="ship.mock">Demo rates for testing. Live carrier rates appear once the store connects its accounts.</p>
    <div id="rates" class="rates"></div>
    <p id="bench" class="muted" hidden></p>
    <form id="buy" class="buy" hidden>
      <label><span data-i18n="ship.email">Your email (for the receipt and label)</span> <input name="email" type="email" required autocomplete="email" value={me?.email ?? ''} /></label>
      {me && <label class="check"><input name="save_address" type="checkbox" /> <span data-i18n="acct.savethis">Save this address to my account</span></label>}
      <label class="check" id="insRow" hidden><input name="insure" type="checkbox" /> <span data-i18n="ship.insure">Insure it for the full value</span> <span id="insFee" class="muted"></span></label>
      <p id="insCovered" class="muted" hidden></p>
      <p id="feeRow" class="muted" hidden></p>
      <p id="totalRow" class="price"><span data-i18n="ship.total">Total</span>: <strong id="totalAmt"></strong></p>
      <label class="check"><input name="sms" type="checkbox" /> <span data-i18n="ship.sms">Text me when it ships and when it is delivered</span> <span id="smsFee" class="muted"></span></label>
      <label id="phoneRow" hidden><span data-i18n="ship.phone">Your mobile number</span> <input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="318 555 0100" /></label>
      <button class="btn" type="submit" id="buyBtn" data-i18n="ship.continue">Continue</button>
    </form>
  </section>

  <script type="application/json" id="savedJson" set:html={JSON.stringify(saved)} />
  <script>
    import { t } from '../../i18n';
    const f = document.getElementById('quote') as HTMLFormElement;
    const err = document.getElementById('err')!;
    const results = document.getElementById('results')!;
    const ratesEl = document.getElementById('rates')!;
    const buy = document.getElementById('buy') as HTMLFormElement;
    const buyBtn = document.getElementById('buyBtn')!;
    // Address autofill (v1.73.0): a five-digit US ZIP fills the city and state through /api/zip; the
    // autocomplete attributes above let the browser offer its saved addresses for the rest.
    const zipEl = f.querySelector('[name=postal_code]') as HTMLInputElement, cityEl = f.querySelector('[name=city]') as HTMLInputElement, stateEl = f.querySelector('[name=state]') as HTMLInputElement;
    // Street typeahead (v1.74.0): what is typed in the street box goes to /api/address-suggest; picking a
    // suggestion fills street, city, state and ZIP. Arrow keys and Enter work; Escape closes.
    const streetEl = f.querySelector('[name=line_1]') as HTMLInputElement, list = document.getElementById('addrList') as HTMLUListElement;
    let items: any[] = [], active = -1, timer = 0, seq = 0;
    const close = () => { list.hidden = true; list.innerHTML = ''; items = []; active = -1; streetEl.setAttribute('aria-expanded', 'false'); };
    const choose = (i: number) => { const s = items[i]; if (!s) return; streetEl.value = s.line_1; if (s.city) cityEl.value = s.city; if (s.state) stateEl.value = s.state; if (s.postal_code) zipEl.value = s.postal_code; lastZip = zipEl.value.slice(0, 5); close(); (f.querySelector('[name=line_2]') as HTMLInputElement).focus(); };
    const paint = () => { list.querySelectorAll('li').forEach((li, i) => li.setAttribute('aria-selected', String(i === active))); };
    streetEl.addEventListener('input', () => {
      const q = streetEl.value.trim();
      clearTimeout(timer);
      if (q.length < 4 || /^\d+\s?$/.test(q)) { close(); return; }
      timer = window.setTimeout(async () => {
        const mine = ++seq;
        try {
          const j = await (await fetch(`/api/address-suggest?q=${encodeURIComponent(q)}&country=US`)).json();
          if (mine !== seq) return;
          items = j.suggestions ?? [];
          if (!items.length) { close(); return; }
          list.innerHTML = items.map((s: any, i: number) => `<li role="option" data-i="${i}" aria-selected="false">${s.label.replace(/</g, '&lt;')}</li>`).join('');
          list.hidden = false; active = -1; streetEl.setAttribute('aria-expanded', 'true');
        } catch { close(); }
      }, 250);
    });
    list.addEventListener('mousedown', (e) => { const li = (e.target as HTMLElement).closest('li'); if (li) { e.preventDefault(); choose(Number(li.dataset.i)); } });
    streetEl.addEventListener('keydown', (e) => {
      if (list.hidden) return;
      if (e.key === 'ArrowDown') { e.preventDefault(); active = Math.min(active + 1, items.length - 1); paint(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); active = Math.max(active - 1, 0); paint(); }
      else if (e.key === 'Enter' && active >= 0) { e.preventDefault(); choose(active); }
      else if (e.key === 'Escape') close();
    });
    streetEl.addEventListener('blur', () => setTimeout(close, 150));
    let lastZip = '';
    zipEl.addEventListener('input', async () => {
      const z = zipEl.value.trim().slice(0, 5);
      if (!/^\d{5}$/.test(z) || z === lastZip) return;
      lastZip = z;
      try {
        const j = await (await fetch(`/api/zip?zip=${z}`)).json();
        if (j.city && !cityEl.value) cityEl.value = j.city;
        if (j.state && !stateEl.value) stateEl.value = j.state;
      } catch {}
    });

    // The return address's ZIP fills its city and state the same way.
    const fromZip = f.querySelector('[name=from_postal_code]') as HTMLInputElement, fromCity = f.querySelector('[name=from_city]') as HTMLInputElement, fromState = f.querySelector('[name=from_state]') as HTMLInputElement;
    let lastFromZip = '';
    fromZip.addEventListener('input', async () => {
      const z = fromZip.value.trim().slice(0, 5);
      if (!/^\d{5}$/.test(z) || z === lastFromZip) return;
      lastFromZip = z;
      try {
        const j = await (await fetch(`/api/zip?zip=${z}`)).json();
        if (j.city && !fromCity.value) fromCity.value = j.city;
        if (j.state && !fromState.value) fromState.value = j.state;
      } catch {}
    });

    let payload: any = null;
    let picked: string | null = null;
    let pickedPrice = 0;
    let extras: any = null;
    const insBox = buy.querySelector('[name=insure]') as HTMLInputElement;
    function total() {
      const ins = insBox.checked && extras && !extras.insurance.covered ? extras.insurance.fee : 0;
      const smsOn = (buy.querySelector('[name=sms]') as HTMLInputElement).checked;
      const text = smsOn && extras?.text_updates_price ? extras.text_updates_price : 0;
      const subtotal = pickedPrice + ins + text;
      const f = extras?.online_fee && (extras.online_fee.percent || extras.online_fee.flat) ? Math.round((subtotal * extras.online_fee.percent / 100 + extras.online_fee.flat) * 100) / 100 : 0;
      const feeRow = document.getElementById('feeRow')!;
      feeRow.hidden = !f;
      if (f) feeRow.textContent = t('ship.fee').replace('{fee}', f.toFixed(2)).replace('{pct}', String(extras.online_fee.percent));
      document.getElementById('totalAmt')!.textContent = `$${(subtotal + f).toFixed(2)}`;
    }
    insBox.addEventListener('change', total);

    function read() {
      const d = Object.fromEntries(new FormData(f).entries()) as Record<string, string>;
      return {
        online: true,
        origin: { contact_name: d.from_contact_name, line_1: d.from_line_1, line_2: d.from_line_2, city: d.from_city, state: d.from_state, postal_code: d.from_postal_code, country_alpha2: 'US' },
        destination: { contact_name: d.contact_name, line_1: d.line_1, line_2: d.line_2, city: d.city, state: d.state, postal_code: d.postal_code, country_alpha2: 'US' },
        parcel: { weight_lb: d.weight_lb, length_in: d.length_in, width_in: d.width_in, height_in: d.height_in, description: d.description, value_usd: d.value_usd },
      };
    }

    // Saved addresses (T20): picking one fills the destination; ?to=ID picks it on load.
    const savedSel = document.getElementById('savedSel') as HTMLSelectElement | null;
    const SAVED: { id: number; to: Record<string, string> }[] = JSON.parse(document.getElementById('savedJson')?.textContent || '[]');
    function fillSaved() {
      const a = SAVED.find((x) => String(x.id) === savedSel?.value);
      if (!a) return;
      for (const k of ['contact_name', 'line_1', 'line_2', 'city', 'state', 'postal_code']) { const el = f.querySelector<HTMLInputElement>(`[name=${k}]`); if (el) el.value = a.to[k] ?? ''; }
    }
    savedSel?.addEventListener('change', fillSaved); if (savedSel?.value) fillSaved();
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true; results.hidden = true; buy.hidden = true; picked = null;
      payload = read();
      const res = await fetch('/api/rates', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      const j = await res.json();
      if (!res.ok) { err.textContent = j.error; err.hidden = false; return; }
      extras = j.extras;
      document.getElementById('smsFee')!.textContent = extras?.text_updates_price ? t('ship.textfee').replace('{fee}', extras.text_updates_price.toFixed(2)) : '';
      const insRow = document.getElementById('insRow')!, insCovered = document.getElementById('insCovered')!;
      if (extras?.insurance.covered) { insRow.hidden = true; insBox.checked = false; insCovered.hidden = false; insCovered.textContent = t('ship.inscovered').replace('{n}', String(extras.insurance.included_usd)); }
      else { insRow.hidden = false; insCovered.hidden = true; document.getElementById('insFee')!.textContent = t('ship.insfee').replace('{fee}', extras.insurance.fee.toFixed(2)).replace('{value}', String(extras.insurance.declared_usd)); }
      const an = document.getElementById('addrNote')!, ad = j.address;
      if (ad && (ad.errors.length || ad.warnings.length)) { an.textContent = [...ad.errors, ...ad.warnings].join(' '); an.className = ad.errors.length ? 'err' : 'card'; an.hidden = false; } else an.hidden = true;
      const pk = j.packing, pn = document.getElementById('packNote')!;
      if (pk && pk.dim_applies) { const top = pk.billable.reduce((a: any, b: any) => (b.lb > a.lb ? b : a)); pn.textContent = t('ship.packing.dim').replace('{actual}', String(pk.actual_lb)).replace('{billable}', String(top.lb)).replace('{carrier}', top.carrier) + (pk.better ? ' ' + t('ship.packing.better').replace('{box}', pk.better.box.name).replace('{saves}', String(pk.better.saves_lb)) : ''); pn.hidden = false; }
      else if (pk && pk.oversize) { pn.textContent = t('ship.packing.oversize'); pn.hidden = false; }
      else pn.hidden = true;
      document.getElementById('mockNote')!.hidden = !j.demo;
      buyBtn.dataset.i18n = 'ship.pay';
      buyBtn.textContent = t(buyBtn.dataset.i18n);
      ratesEl.innerHTML = '';
      for (const r of j.rates) {
        const el = document.createElement('label');
        el.className = 'rate card';
        el.innerHTML = `<input type="radio" name="rate" value="${r.id}">
          <span class="carrier">${r.carrier}</span>
          <span class="service">${r.service}</span>
          <span class="days">${r.min_days ?? '?'}–${r.max_days ?? '?'} ${t('ship.days')}</span>
          <span class="price">$${r.total_charge.toFixed(2)}</span>`;
        el.querySelector('input')!.addEventListener('change', () => { picked = r.id; pickedPrice = r.total_charge; buy.hidden = false; total(); });
        ratesEl.appendChild(el);
      }
      const bench = document.getElementById('bench')!;
      if (j.benchmark) { const b = j.benchmark; bench.hidden = false; bench.textContent = t(b.diff != null && b.diff <= 0 ? 'ship.bench.under' : 'ship.bench').replace('{ps}', b.pirate_ship.toFixed(2)).replace('{service}', b.service).replace('{est}', b.estimated ? t('ship.bench.est') : ''); } else bench.hidden = true;
      results.hidden = false;
      results.scrollIntoView({ behavior: 'smooth' });
    });

    const smsBox = buy.querySelector('[name=sms]') as HTMLInputElement;
    const phoneRow = document.getElementById('phoneRow') as HTMLElement;
    smsBox.addEventListener('change', () => { phoneRow.hidden = !smsBox.checked; if (smsBox.checked) (buy.querySelector('[name=phone]') as HTMLInputElement).focus(); total(); });
    buy.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!picked) return;
      buyBtn.setAttribute('disabled', '');
      const email = (buy.querySelector('[name=email]') as HTMLInputElement).value;
      const sms = (buy.querySelector('[name=sms]') as HTMLInputElement).checked;
      const phone = (buy.querySelector('[name=phone]') as HTMLInputElement).value;
      const insure = insBox.checked;
      const res = await fetch('/api/orders', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...payload, email, sms, phone, rate_id: picked, insure, save_address: (buy.querySelector('[name=save_address]') as HTMLInputElement | null)?.checked === true }) });
      const j = await res.json();
      if (!res.ok) { err.textContent = j.error; err.hidden = false; buyBtn.removeAttribute('disabled'); return; }
      location.href = j.next;
    });
  </script>
</Base>
