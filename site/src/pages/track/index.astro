---
import { store } from '../../data/store';
export const prerender = false;
import Base from '../../layouts/Base.astro';
import CarrierBadges from '../../components/CarrierBadges.astro';
import { env } from '../../lib/env';
import { readSession } from '../../lib/session';
import { getCustomer, listTracked } from '../../shipping/store';

// Public tracking page. Same look as the done page, no login. Takes the pickup code (GP-XXXXXX) or
// the carrier tracking number; /track?q=... fills it in so the done page and emails can link straight here.
const q = Astro.url.searchParams.get('q') ?? '';
// Recently tracked (Peter, Nov 14 2026): signed-in customers see what they looked up; everyone else is asked to sign in or sign up.
const meId = await readSession(env, Astro.request.headers.get('cookie')).catch(() => null);
const me = meId ? await getCustomer(env, meId) : null;
const tracked = me ? await listTracked(env, me.id, 10) : [];
---
<Base title={`Track a package · ${store.name}`} description={`Track a package shipped from ${store.name} with your pickup code or tracking number.`}>
  <!-- The search, laid out like the home page's tracking box: centered, wide, Track beside it (Peter, Nov 14 2026). -->
  <section class="track-hero track-page" aria-labelledby="track-h1">
    <h1 id="track-h1" data-i18n="track.title">Track a package</h1>
    <p class="lead" data-i18n="track.lead">Type the pickup code from your order page, or the carrier tracking number from your label.</p>
    <form id="track" class="track-form" autocomplete="off">
      <label class="sr-only" for="track-q" data-i18n="track.field">Pickup code or tracking number</label>
      <input id="track-q" name="q" value={q} placeholder="Pickup code or tracking number" data-i18n-ph="track.field" required minlength="4" maxlength="40" inputmode="text" autocapitalize="characters" />
      <button class="btn kraft" type="submit" data-i18n="track.button">Track</button>
    </form>
    <!-- The carriers' logos (Peter, Nov 15 2026), same as under the home page's tracking box. -->
    <div class="track-carriers"><span class="muted" data-i18n="carr.track">Tracking numbers from</span><CarrierBadges /></div>
    <p id="msg" class="err" role="alert"></p>
    <div id="elsewhere" hidden>
      <p data-i18n="track.elsewhere">We didn't ship that one here, but it looks like a tracking number from the carrier below. Follow it on their site:</p>
      <p class="btnrow" id="elsewhere-links"></p>
    </div>
  </section>

  <div id="result" class="grid hidden">
    <div class="card">
      <h3 id="r-status"></h3>
      <p><span id="r-service"></span> <span data-i18n="track.to">to</span> <strong id="r-to"></strong></p>
      <p><span data-i18n="done.tracking">Tracking</span>: <span class="code" id="r-tracking"></span></p>
      <p class="muted"><span data-i18n="done.code">Pickup code</span> <span id="r-id"></span></p>
    </div>
    <div class="card">
      <h3 data-i18n="track.history">History</h3>
      <ol class="timeline" id="r-events"></ol>
    </div>
  </div>

  <section class="recent" aria-labelledby="recent-h">
    <h2 id="recent-h" data-i18n="track.recent">Recently tracked</h2>
    {me ? (
      <div class="card">
        <ul class="recent-list" id="recentList">
          {tracked.map((r) => <li><a href={`/track?q=${encodeURIComponent(r.query)}`} class="code">{r.query}</a> <span class="muted">{r.label ?? r.carrier ?? ''}</span></li>)}
        </ul>
        {!tracked.length && <p class="muted" id="recentNone" data-i18n="track.recent.none">Packages you track will show up here.</p>}
        <p><a href="/account#orders" data-i18n="nav.allships">View all shipments</a></p>
      </div>
    ) : (
      <div class="card recent-cta">
        <svg class="recent-icon" viewBox="0 0 64 64" width="64" height="64" aria-hidden="true"><path d="M32 6 56 18v28L32 58 8 46V18Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/><path d="M8 18l24 12 24-12M32 30v28M20 12l24 12" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/></svg>
        <h3 data-i18n="track.save.h">Save your tracking here</h3>
        <p data-i18n="track.save.p">Sign in or create a free account to see every package you've tracked and shipped, in one place.</p>
        <p class="btnrow"><a class="btn" href="/account?next=/track" data-i18n="acct.signin">Sign in</a> <a class="btn kraft" href="/account?next=/track" data-i18n="acct.create">Create an account</a></p>
      </div>
    )}
  </section>

  <script>
    import { t } from '../../i18n';
    import { carriersFor } from '../../lib/carrierTrack';
    const form = document.getElementById('track') as HTMLFormElement;
    const msg = document.getElementById('msg')!;
    const result = document.getElementById('result')!;
    const $ = (id: string) => document.getElementById(id)!;
    const STATUS: Record<string, string> = {
      labeled: 'track.s.labeled', printed: 'track.s.labeled', label_created: 'track.s.labeled', in_transit: 'track.s.transit',
      out_for_delivery: 'track.s.out', delivered: 'track.s.delivered', exception: 'track.s.exception', returned: 'track.s.returned', voided: 'track.s.voided', unknown: 'track.s.unknown',
    };
    const fmt = (iso: string) => new Date(iso).toLocaleString(undefined, { dateStyle: 'medium', timeStyle: 'short' });

    async function lookup(q: string) {
      msg.textContent = '';
      result.classList.add('hidden');
      const elsewhere = document.getElementById('elsewhere')!; elsewhere.hidden = true;
      const res = await fetch(`/api/track?q=${encodeURIComponent(q)}`);
      const j = await res.json();
      if (!res.ok) {
        // Not one of ours: if it looks like a carrier's tracking number, link to that carrier's own tracking (Peter, Nov 14 2026).
        const links = res.status === 404 ? carriersFor(q) : [];
        if (links.length) {
          const box = document.getElementById('elsewhere-links')!;
          box.innerHTML = '';
          for (const l of links) {
            const a = document.createElement('a');
            a.className = 'btn'; a.href = l.url; a.target = '_blank'; a.rel = 'noopener';
            a.textContent = t('track.oncarrier').replace('{carrier}', l.carrier);
            box.appendChild(a);
          }
          elsewhere.hidden = false;
          return;
        }
        msg.textContent = res.status === 404 ? t('track.notfound') : j.error; return;
      }
      $('r-status').textContent = t(STATUS[j.status] ?? 'track.s.unknown');
      $('r-service').textContent = `${j.carrier} ${j.service}`.trim();
      $('r-to').textContent = j.to;
      $('r-tracking').textContent = j.tracking_number ?? '—';
      $('r-id').textContent = j.id;
      const ol = $('r-events');
      ol.innerHTML = '';
      for (const e of j.events) {
        const li = document.createElement('li');
        li.innerHTML = `<time>${fmt(e.at)}</time><strong></strong><span></span>`;
        li.querySelector('strong')!.textContent = e.description;
        li.querySelector('span')!.textContent = e.location ?? '';
        ol.appendChild(li);
      }
      result.classList.remove('hidden');
      const list = document.getElementById('recentList');
      if (list && ![...list.querySelectorAll('a')].some((a) => a.textContent === q.toUpperCase())) {
        const li = document.createElement('li'); const a = document.createElement('a'); const sp = document.createElement('span');
        a.href = `/track?q=${encodeURIComponent(q)}`; a.className = 'code'; a.textContent = q.toUpperCase(); sp.className = 'muted'; sp.textContent = ` ${j.service} · ${j.to}`;
        li.append(a, sp); list.prepend(li); document.getElementById('recentNone')?.remove();
      }
      history.replaceState(null, '', `/track?q=${encodeURIComponent(q)}`);
    }

    form.addEventListener('submit', (ev) => { ev.preventDefault(); lookup((form.elements.namedItem('q') as HTMLInputElement).value.trim()); });
    const initial = (form.elements.namedItem('q') as HTMLInputElement).value.trim();
    if (initial) lookup(initial);
  </script>
</Base>
