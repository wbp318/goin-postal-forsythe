---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { store } from '../../data/store';
import { env } from '../../lib/env';
import { consumeLoginTokenFull, peekLoginToken, readSession, signSession, sessionCookie, safeNext } from '../../lib/session';
import { upsertCustomer, setPasswordHash, markEmailVerified, getLogin, setCustomerName, phoneHolder } from '../../shipping/store';
import { marketingConsent } from '../../shipping/store';
import { CONSENT_WORDING, loggedWording } from '../../lib/consent';
import { recordConsent } from '../../shipping/store';
import { listSavedDesigns } from '../../shipping/store';
import { renderCard, sanitizeDesign, CARD_OPTIONS } from '../../lib/cards';
import { listCardOrdersFor, cardTotal } from '../../lib/cardOrders';
import { mailboxesFor, waitingReservation } from '../../shipping/store';
import { sizeById, addressFor, boxStatus, day } from '../../lib/mailbox';
import { findCustomer, getCustomer, customerQuotes, listCustomerAddresses, accountForContact, accountOpenShipments, accountOpenFees, listStatements, pickupsForAccount, listReturnLinks, listProducts, listFulfillmentOrders, listApiKeys } from '../../shipping/store';

// Customer account (T20): sign in by magic link, see saved addresses and past orders, ship again.
const token = Astro.url.searchParams.get('token');
// A sign-up link (it carries the new password) waits for the Confirm button below, so opening the link alone
// changes nothing. Plain sign-in links work on opening, as before.
const pending = token ? await peekLoginToken(env, token) : null;
const confirmFor = pending?.pw && Astro.request.method !== 'POST' ? pending : null;
if (token && !confirmFor) {
  const t = await consumeLoginTokenFull(env, token);
  const email = t?.email ?? null;
  let c = email ? await findCustomer(env, email, null) : null;
  // A sign-up link only ever makes a new account. If the email has one already, nothing on it changes; the
  // person who opened the link is signed in and can set a password under Profile.
  const fresh = t?.pw && email && !c ? t : null;
  if (fresh) { await upsertCustomer(env, { name: fresh.name || 'Customer', email: fresh.email }); c = await findCustomer(env, fresh.email, null); }
  if (c) {
    await markEmailVerified(env, c.id);
    if (fresh?.pw) {
      await setPasswordHash(env, c.id, fresh.pw);
      // The mobile number given at sign-up (Peter, Nov 15 2026).
      // A number already on another customer's record stays theirs.
      if (fresh.phone && !c.phone && !(await phoneHolder(env, fresh.phone, c.id))) await setCustomerName(env, c.id, c.name, fresh.phone);
      // Deals and news as left ticked on the Confirm page, logged with the exact wording. A box left unticked
      // records nothing.
      const form = await Astro.request.formData().catch(() => null);
      const lang = fresh.mkt?.lang;
      if (form?.get('mkt_email')) await recordConsent(env, { customer_id: c.id, channel: 'email', granted: true, contact: c.email ?? fresh.email, wording: loggedWording('email', lang), source: 'signup' });
      if (form?.get('mkt_sms') && (fresh.phone || c.phone)) await recordConsent(env, { customer_id: c.id, channel: 'sms', granted: true, contact: c.phone ?? fresh.phone ?? null, wording: loggedWording('sms', lang), source: 'signup' });
    }
    const to = t?.pw && !fresh ? '/account?existing=1' : safeNext(Astro.url.searchParams.get('next'));
    Astro.cookies; // Astro needs the cookies API touched before set-cookie on a redirect in some adapters
    return new Response(null, { status: 302, headers: { Location: to, 'Set-Cookie': sessionCookie(await signSession(env, c.id), Astro.url.protocol === 'https:') } });
  }
  return Astro.redirect('/account?expired=1');
}
const id = await readSession(env, Astro.request.headers.get('cookie'));
const me = id ? await getCustomer(env, id) : null;
const expired = Astro.url.searchParams.get('expired');
const existing = Astro.url.searchParams.get('existing');
const quotes = me ? (await customerQuotes(env, me, { byPhone: false })).slice(0, 30) : [];
const saved = me ? await listCustomerAddresses(env, me.id) : [];
// The seller dashboard (business accounts online): everything the counter keeps for the account, read-only here.
const biz = me?.email ? await accountForContact(env, me.email, null) : null; // by the signed-in email
const unbilled = biz ? [...(await accountOpenShipments(env, biz)), ...(await accountOpenFees(env, biz.id))] : [];
const unbilledTotal = Math.round(unbilled.reduce((a, l) => a + l.total, 0) * 100) / 100;
const statements = biz ? await listStatements(env, biz.id) : [];
const pickups = biz ? (await pickupsForAccount(env, biz.id, 10)) : [];
const links = biz ? (await listReturnLinks(env, biz.id)).filter((l) => l.active) : [];
const stock = biz ? await listProducts(env, biz.id) : [];
const fulfil = biz ? (await listFulfillmentOrders(env, biz.id, true)).slice(0, 20) : [];
const keys = biz ? (await listApiKeys(env, biz.id)).filter((k) => k.active) : [];
const fmt = (iso: string) => iso.slice(0, 10);
const consent = me ? await marketingConsent(env, me.id) : null;
// Saved designs (Peter, Nov 15 2026): business cards today; t-shirts, banners, yard signs and promo items join
// this list when they're ordered online. Each shows its picture, what was picked last time, and Edit / Reorder / Delete.
const savedDesigns = me ? await listSavedDesigns(env, me.id) : [];
// Mailboxes (Peter, Nov 15 2026): the holder's boxes once the store assigns them, and a reservation still waiting.
const myBoxes = me ? (await mailboxesFor(env, me.id)).map((b) => ({ ...b, sizeName: sizeById(b.size)?.name ?? b.size, address: addressFor(b.box_no), state: boxStatus(b, day(new Date())) })) : [];
const myRes = me ? await waitingReservation(env, me.id) : null;
const longDate = (ymd: string) => new Date(ymd + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
// Business card orders on this account (newest first), for My orders.
const cardOrders = me ? await listCardOrdersFor(env, me.id) : [];
const savedProducts = [...new Set(savedDesigns.map((d) => d.product))];
const savedCards = savedDesigns.filter((d) => d.product === 'card').map((d) => {
  let svg = ''; try { svg = renderCard(sanitizeDesign(JSON.parse(d.design_json)), 'front'); } catch {}
  const picks: Record<string, string> = d.last_options_json ? JSON.parse(d.last_options_json) : {};
  const extras = Object.values(picks).map((code) => CARD_OPTIONS.find((o) => o.code === code)).filter((o) => o && !o.default).map((o) => o!);
  return { ...d, svg, extras };
});
---
<Base title={`Your account · ${store.name}`} description="Sign in with your email, keep your addresses, see your orders, ship again in two clicks.">
  <section class="hero">
    <h1 data-i18n={me ? 'acct.h1' : 'acct.signin'}>{me ? 'Your account' : 'Sign in'}</h1>
    <p class="lead" data-i18n={me ? 'acct.lead.in' : 'acct.lead'}>{me ? 'Your profile, orders, designs and addresses.' : 'Sign in with your email and password, or create a free account.'}</p>
    {expired && <p class="card" data-i18n="acct.expired">That link has expired or was already used. Ask for a new one.</p>}
    {existing && <p class="card" data-i18n="acct.existing">This email already had an account, so nothing in it was changed. You're signed in now; you can set a password under Profile.</p>}
    {confirmFor && (
      <form method="post" class="card auth" id="confirmSignup">
        <h3 data-i18n="acct.confirm.h">Confirm your new account</h3>
        <p><strong>{confirmFor.email}</strong></p>
        <p data-i18n="acct.confirm.p">Press Confirm to finish making your account. If you didn't ask for one, close this page and nothing changes.</p>
        <label class="check"><input name="mkt_email" type="checkbox" checked={!!confirmFor.mkt?.email} /> <span data-i18n="mkt.email">{CONSENT_WORDING.email}</span></label>
        {confirmFor.phone && <label class="check"><input name="mkt_sms" type="checkbox" checked={!!confirmFor.mkt?.sms} /> <span data-i18n="mkt.sms">{CONSENT_WORDING.sms}</span></label>}
        <button class="btn" type="submit" data-i18n="acct.confirm.btn">Confirm</button>
      </form>
    )}
  </section>
  {!me ? (
    <div class="grid">
      <!-- Sign in with a password, or create an account (Peter, Nov 14 2026). The email link stays as "forgot password". -->
      <form id="login" class="card auth">
        <h3 data-i18n="acct.signin">Sign in</h3>
        <label><span data-i18n="f.email">Email</span> <input name="email" type="email" required autocomplete="email" /></label>
        <label><span data-i18n="acct.pw">Password</span> <input name="password" type="password" required autocomplete="current-password" /></label>
        <button class="btn" type="submit" data-i18n="acct.signin">Sign in</button>
        <p><button type="button" class="linkish" id="forgotBtn" data-i18n="acct.forgot">Forgot your password? Email me a sign-in link</button></p>
        <p id="msg" role="alert"></p>
      </form>
      <form id="signup" class="card auth">
        <h3 data-i18n="acct.create.h">Create a free account</h3>
        <label><span data-i18n="f.name">Name</span> <input name="name" maxlength="60" autocomplete="name" /></label>
        <label><span data-i18n="f.email">Email</span> <input name="email" type="email" required autocomplete="email" /></label>
        <!-- Mobile number at sign-up (Peter, Nov 15 2026): so the store can call or text about an order right away. -->
        <label><span data-i18n="acct.mobile">Mobile number</span> <input name="phone" type="tel" inputmode="tel" required autocomplete="tel" placeholder="318 555 0100" /></label>
        <p class="muted" data-i18n="acct.mobile.p">So we can call or text you about your order. Not for marketing unless you say yes.</p>
        <!-- Deals and news at sign-up (Peter, Nov 15 2026). Email starts ticked (US law, CAN-SPAM, allows it; every
             email carries an unsubscribe link). Texts must start unticked: under the TCPA a pre-ticked box is not
             consent, and the carriers reject texting registrations that pre-tick it. -->
        <fieldset class="mkt signup-mkt">
          <legend data-i18n="mkt.h">Deals and news (optional)</legend>
          <label class="check"><input name="mkt_email" type="checkbox" checked /> <span data-i18n="mkt.email">{CONSENT_WORDING.email}</span></label>
          <label class="check"><input name="mkt_sms" type="checkbox" /> <span data-i18n="mkt.sms">{CONSENT_WORDING.sms}</span></label>
        </fieldset>
        <label><span data-i18n="acct.pw">Password</span> <input name="password" type="password" required minlength="8" autocomplete="new-password" /></label>
        <p class="muted" data-i18n="acct.pw.hint">At least 8 characters. A short sentence is easy to remember.</p>
        <button class="btn kraft" type="submit" data-i18n="acct.create">Create an account</button>
        <p id="smsg" role="status"></p>
      </form>
      <div class="card">
        <h3 data-i18n="acct.why">What an account is for</h3>
        <ul>
          <li data-i18n="acct.why1">Your addresses, saved, so the next label is two clicks.</li>
          <li data-i18n="acct.why2">Every order you made here, with tracking.</li>
          <li data-i18n="acct.why3">The same email you already use at the counter. Nothing to set up.</li>
        </ul>
      </div>
    </div>
  ) : (<>
    <!-- Account tabs (Peter, Nov 15 2026): Profile, My orders, My designs, Addresses, and Business for business
         accounts. One shows at a time; the address bar remembers which (#orders, #designs...), so old links still
         land in the right place. Without JavaScript every section shows, one under another. -->
    <nav class="acct-tabs" role="tablist" aria-label="Account">
      <a href="#profile" role="tab" data-tab="profile" data-i18n="acct.tab.profile">Profile</a>
      <a href="#orders" role="tab" data-tab="orders" data-i18n="acct.tab.orders">My orders</a>
      <a href="#designs" role="tab" data-tab="designs" data-i18n="acct.tab.designs">My designs</a>
      <a href="#addresses" role="tab" data-tab="addresses" data-i18n="acct.tab.addresses">Addresses</a>
      {(myBoxes.length > 0 || myRes) && <a href="#mailbox" role="tab" data-tab="mailbox" data-i18n="acct.tab.mailbox">My mailbox</a>}
      {biz && <a href="#business" role="tab" data-tab="business" data-i18n="acct.tab.business">Business</a>}
    </nav>
    <p id="msg" role="alert"></p>
    <section class="acct-panel" id="profile" data-panel="profile" role="tabpanel">
      <div class="grid acct-profile">
      <div class="card">
        <h3 data-i18n="acct.you">You</h3>
        <form id="namef">
          <label><span data-i18n="f.name">Name</span> <input name="name" value={me.name} maxlength="60" required /></label>
          <label><span data-i18n="f.email">Email</span> <input value={me.email ?? ''} disabled /></label>
          <label><span data-i18n="f.phone">Phone</span> <input name="phone" type="tel" value={me.phone ?? ''} maxlength="20" /></label>
          <p class="btnrow"><button class="btn small" type="submit" data-i18n="acct.save">Save</button> <button class="btn small kraft" type="button" id="logout" data-i18n="acct.logout">Sign out</button></p>
        </form>
        <!-- Marketing choices (Peter, Nov 14 2026): change them anytime; each change is logged with its wording. -->
        <!-- Password (Peter, Nov 14 2026): set one after signing in by link, or change it. -->
        <form id="pwf" class="pwf">
          <h3 data-i18n="acct.pw">Password</h3>
          <p class="muted" data-i18n="acct.pw.set.p">Set a password to sign in quickly next time, or change the one you have.</p>
          <label><span data-i18n="acct.pw">Password</span> <input name="password" type="password" required minlength="8" autocomplete="new-password" /></label>
          <p class="btnrow"><button class="btn small" type="submit" data-i18n="acct.pw.save">Save password</button></p>
        </form>
        <fieldset class="mkt" id="mktf">
          <legend data-i18n="mkt.h">Deals and news (optional)</legend>
          <label class="check"><input type="checkbox" data-channel="email" checked={consent?.email} /> <span data-i18n="mkt.email">{CONSENT_WORDING.email}</span></label>
          <label class="check"><input type="checkbox" data-channel="sms" checked={consent?.sms} /> <span data-i18n="mkt.sms">{CONSENT_WORDING.sms}</span></label>
        </fieldset>
      </div>
      </div>
    </section>
    <section class="acct-panel" id="orders" data-panel="orders" role="tabpanel">
      <div class="card">
        <h3 data-i18n="acct.myorders.cards">Business cards</h3>
        {!cardOrders.length && <p class="muted" data-i18n="acct.nocards">No card orders yet.</p>}
        {cardOrders.length > 0 && <table class="list">{cardOrders.map((o) => <tr><td>{fmt(o.created_at)}</td><td><a href={`/cards/done?order=${o.id}`}>{o.id}</a></td><td>{o.quantity} <span data-i18n="shop.cards">cards</span></td><td>${cardTotal(o).toFixed(2)}</td><td><span class={`acct-status s-${o.status}`} data-i18n={`acct.cs.${o.status}`}>{o.status}</span></td></tr>)}</table>}
      </div>
      <div class="card">
        <h3 data-i18n="acct.myorders.h">Shipping</h3>
        {!quotes.length && <p class="muted" data-i18n="acct.noorders">No orders yet under this email.</p>}
        <table class="list">{quotes.map((q) => <tr><td>{fmt(q.created_at)}</td><td><a href={q.shipment_status ? `/track?q=${q.id}` : `/ship/done?order=${q.id}`}>{q.id}</a></td><td>{q.carrier} {q.service}</td><td>{q.destination}</td><td>${Number(q.price).toFixed(2)}</td><td>{q.shipment_status ?? q.status}</td><td>{q.shipment_status && q.shipment_status !== 'voided' ? <button type="button" class="btn small kraft" data-resend={q.id} data-i18n="acct.resend">Email me the label again</button> : null}</td></tr>)}</table>
      </div>
    </section>
    <section class="acct-panel" id="designs" data-panel="designs" role="tabpanel">
      <div class="card">
        <h3 data-i18n="saved.h">Your saved designs</h3>
        <p class="muted" data-i18n="saved.p">Everything you design or order is kept here. Edit it, or order the same again in a click.</p>
        {savedCards.length ? <>
          <!-- One place for every product (Peter, Nov 15 2026), with a filter per product that has designs. -->
          <div class="saved-filters" role="group" aria-label="Filter">
            <button type="button" class="chip on" data-filter="all" data-i18n="saved.all">All</button>
            {savedProducts.map((pr) => <button type="button" class="chip" data-filter={pr} data-i18n={`saved.p.${pr}`}>{pr}</button>)}
          </div>
          <div class="saved-grid">
            {savedCards.map((c) => (
              <div class="saved-item" data-saved={c.id} data-product={c.product}>
                <div class="card-wrap" set:html={c.svg} />
                <span class="saved-tag" data-i18n={`saved.p.${c.product}`}>Business card</span>
                <p class="saved-name">{c.name}</p>
                {c.last_quantity
                  ? <p class="muted"><span data-i18n="saved.last">Last ordered</span> {fmt(c.last_ordered_at ?? c.updated_at)}: {c.last_quantity} <span data-i18n="shop.cards">cards</span>{c.extras.map((o) => <> · <span data-i18n={`cards.opt.${o.code}`}>{o.name}</span></>)}</p>
                  : <p class="muted"><span data-i18n="saved.saved">Saved</span> {fmt(c.updated_at)}</p>}
                <p class="btnrow">
                  <a class="btn small" href={`/cards/design?saved=${c.id}`} data-i18n="saved.edit">Edit</a>
                  <button type="button" class="btn small kraft" data-reorder={c.id} data-i18n={c.last_quantity ? 'saved.reorder' : 'saved.order'}>{c.last_quantity ? 'Reorder' : 'Order'}</button>
                  <button type="button" class="linkish" data-deldesign={c.id} data-i18n="saved.delete">Delete</button>
                </p>
              </div>
            ))}
          </div>
        </> : <p data-i18n="saved.none">No saved designs yet. Design business cards and press "Save to my account", or order them, and they'll be kept here.</p>}
        <p class="muted" data-i18n="saved.soon">T-shirts, banners, yard signs and promo items will be saved here too once they can be ordered online.</p>
        <p><a href="/cards" data-i18n="shop.browse">Browse designs</a></p>
        <p id="savedMsg" role="alert"></p>
      </div>
    </section>
    {(myBoxes.length > 0 || myRes) && <section class="acct-panel" id="mailbox" data-panel="mailbox" role="tabpanel">
      {myBoxes.map((b) => (
        <div class="card mb-mine">
          <h3><span data-i18n="mb.box">Mailbox</span> #{b.box_no} <span class={`acct-status mb-${b.state}`} data-i18n={`mb.state.${b.state}`}>{b.state}</span></h3>
          <p><span data-i18n="mb.youraddr">Your address:</span><br /><strong class="mb-address">{b.address}</strong> <button type="button" class="linkish" data-copy={b.address} data-i18n="mb.copy">Copy</button></p>
          <dl class="mb-facts">
            <dt data-i18n="mb.pick.size">Size</dt><dd data-i18n={`mb.size.${b.size}`}>{b.sizeName}</dd>
            <dt data-i18n="mb.paidthru">Paid through</dt><dd>{longDate(b.paid_through)}</dd>
            <dt data-i18n="mb.term">Term</dt><dd>{b.term === 12 ? <span data-i18n="mb.year">1 year</span> : <span data-i18n="mb.six">6 months</span>}</dd>
          </dl>
          <p class="muted" data-i18n="mb.renew.p">Renew at the counter for 6 months or a year. We'll text and email you before it's due.</p>
        </div>
      ))}
      {myRes && <div class="card">
        <h3 data-i18n="mb.reserve.h">Reserve a mailbox</h3>
        <p><span data-i18n="mb.reserved">Reserved:</span> <strong data-i18n={`mb.size.${myRes.size}`}>{sizeById(myRes.size)?.name}</strong> · {myRes.term === 12 ? <span data-i18n="mb.year">1 year</span> : <span data-i18n="mb.six">6 months</span>} · <span data-i18n="mb.code">code</span> <strong>{myRes.code}</strong></p>
        <p data-i18n="mb.reserved.p">Bring your two IDs to the counter and we'll get your box ready. We'll call you if we have questions.</p>
        <p><a href="/mailbox" data-i18n="mb.what">What to bring</a></p>
      </div>}
    </section>}
    <section class="acct-panel" id="addresses" data-panel="addresses" role="tabpanel">
      <div class="card">
        <h3 data-i18n="acct.addresses">Saved addresses</h3>
        <ul id="addrs">{saved.map((a) => { const d = JSON.parse(a.address_json); return <li data-id={a.id}><strong>{a.label}</strong>: {d.contact_name}, {d.line_1}{d.line_2 ? ` ${d.line_2}` : ''}, {d.city} {d.state} {d.postal_code} · <a href={`/ship?to=${a.id}`} data-i18n="acct.shipto">Ship to this address</a> · <button type="button" class="btn small" data-del={a.id}>×</button></li>; })}</ul>
        {!saved.length && <p class="muted" data-i18n="acct.noaddr">None yet. Tick "save this address" when you ship, or add one here.</p>}
        <form id="addf" class="ship-form">
          <div class="row">
            <label><span data-i18n="acct.label">Label</span> <input name="label" maxlength="40" placeholder="Mom" /></label>
            <label><span data-i18n="ship.recipient">Recipient name</span> <input name="contact_name" required /></label>
          </div>
          <div class="row">
            <label><span data-i18n="ship.street">Street address</span> <input name="line_1" required maxlength="35" /></label>
            <label><span data-i18n="ship.apt">Apt, suite (optional)</span> <input name="line_2" maxlength="35" /></label>
          </div>
          <div class="row">
            <label><span data-i18n="ship.city">City</span> <input name="city" required /></label>
            <label><span data-i18n="ship.state">State</span> <input name="state" maxlength="2" required /></label>
            <label><span data-i18n="ship.zip">ZIP / postal code</span> <input name="postal_code" required /></label>
          </div>
          <p><button class="btn small" type="submit" data-i18n="acct.addaddr">Add address</button></p>
        </form>
      </div>
    </section>
    {biz && <section class="acct-panel" id="business" data-panel="business" role="tabpanel">
      <div class="card" id="biz">
        <h3><span data-i18n="acct.biz.h3">Business account</span>: {biz.business_name}</h3>
        <p class="muted"><span data-i18n="acct.biz.lead">What the store keeps for your account. Labels are billed to your monthly statement; the counter makes keys and links for you.</span>{biz.discount_percent ? <> <span data-i18n="acct.biz.discount">Your discount:</span> {biz.discount_percent}%.</> : null}</p>
        <h4 data-i18n="acct.biz.unbilled">Unbilled so far</h4>
        {unbilled.length ? <><p><strong>${unbilledTotal.toFixed(2)}</strong> · {unbilled.length} <span data-i18n="acct.biz.lines">lines</span></p><table class="list">{unbilled.slice(-15).map((l) => <tr><td>{l.created_at.slice(0, 10)}</td><td>{l.id.startsWith('FEE-') ? l.service : <a href={`/track?q=${l.id}`}>{l.id}</a>}</td><td>{l.id.startsWith('FEE-') ? l.to : `${l.carrier} ${l.service} · ${l.to}`}</td><td>${l.total.toFixed(2)}</td></tr>)}</table></> : <p class="muted" data-i18n="acct.biz.nothing">Nothing unbilled.</p>}
        <h4 data-i18n="acct.biz.statements">Statements</h4>
        {statements.length ? <table class="list">{statements.slice(0, 12).map((s) => <tr><td>{s.period}</td><td>${s.total.toFixed(2)}</td><td>{s.paid_at ? <span data-i18n="acct.biz.paid">paid</span> : s.stripe_invoice_url ? <a href={s.stripe_invoice_url} target="_blank" rel="noopener" data-i18n="acct.biz.pay">Pay</a> : <span data-i18n="acct.biz.due">due</span>}</td></tr>)}</table> : <p class="muted" data-i18n="acct.biz.nostatements">No statements yet.</p>}
        {pickups.length > 0 && <><h4 data-i18n="st.nav.pickups">Pickups</h4><table class="list">{pickups.map((p) => <tr><td>{p.scheduled_date}</td><td data-i18n={`st.pu.${p.window}`}>{p.window}</td><td>{p.packages}</td><td data-i18n={`st.pu.status.${p.status}`}>{p.status.replace('_', ' ')}</td></tr>)}</table></>}
        {links.length > 0 && <><h4 data-i18n="acct.biz.returns">Your returns link</h4><p data-i18n="acct.biz.returns.lead">Give this to your customers; they get a prepaid return label and it lands on your statement.</p>{links.map((l) => <p><code>{env.SITE_URL}/return/{l.token}</code></p>)}</>}
        {stock.length > 0 && <><h4 data-i18n="acct.biz.stock">Your stock on our shelf</h4><table class="list">{stock.map((p) => <tr><td>{p.sku}</td><td>{p.name}</td><td><strong>{p.on_hand}</strong></td></tr>)}</table></>}
        {fulfil.length > 0 && <><h4 data-i18n="acct.biz.fulfil">Orders we ship for you</h4><table class="list">{fulfil.map((o) => <tr><td>{o.created_at.slice(0, 10)}</td><td>{o.reference ?? o.code}</td><td>{JSON.parse(o.lines_json).map((l: any) => `${l.qty}× ${l.sku}`).join(', ')}</td><td>{o.shipment_id ? <a href={`/track?q=${o.shipment_id}`}>{o.shipment_id}</a> : <span data-i18n={`st.pu.status.${o.status === 'open' ? 'scheduled' : 'cancelled'}`}>{o.status}</span>}</td></tr>)}</table></>}
        <h4 data-i18n="acct.biz.api">API keys</h4>
        {keys.length ? <p>{keys.map((k) => <span><code>{k.prefix}…</code> {k.label}{k.webhook_url ? ' · webhook' : ''} </span>)} · <a href="/developers" data-i18n="acct.biz.docs">API docs</a></p> : <p class="muted"><span data-i18n="acct.biz.nokeys">No keys yet. Ask the counter for one to connect your shop.</span> <a href="/developers" data-i18n="acct.biz.docs">API docs</a></p>}
      </div>
    </section>}
  </>)}
  <script>
    import { t } from '../../i18n';
    const $ = (id: string) => document.getElementById(id);
    const msg = () => $('msg')!;
    async function api(body: Record<string, unknown>) {
      const res = await fetch('/api/account', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const j = await res.json(); if (!res.ok) throw new Error(j.error); return j;
    }
    // Where to go after signing in: the page the customer came from (a path on this site only), else this account page.
    const nextParam = new URLSearchParams(location.search).get('next') ?? undefined;
    const goNext = (n?: string) => { location.href = n && /^\/(?![\/\\])/.test(n) ? n : (nextParam && /^\/(?![\/\\])/.test(nextParam) ? nextParam : '/account'); };
    const codeMsg = (e: any) => ({ bad_login: t('acct.badlogin'), locked: t('acct.locked'), pw_short: t('acct.weak'), pw_long: t('acct.weak'), pw_common: t('acct.weak'), phone: t('acct.mobile.bad') } as Record<string, string>)[e.code] ?? e.message;
    async function apiCoded(body: Record<string, unknown>) {
      const res = await fetch('/api/account', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const j = await res.json().catch(() => ({})); if (!res.ok) throw Object.assign(new Error(j.error ?? 'Try again'), { code: j.code }); return j;
    }
    const devLink = (el: HTMLElement, link?: string) => { if (link) { const a = document.createElement('a'); a.href = link; a.textContent = ' (dev: open it)'; el.append(a); } };
    // Account tabs: show the one named in the address bar (#orders, #designs...), Profile otherwise.
    const tabs = [...document.querySelectorAll<HTMLElement>('.acct-tabs [data-tab]')];
    if (tabs.length) {
      const panels = [...document.querySelectorAll<HTMLElement>('.acct-panel')];
      const show = (name: string) => {
        if (!panels.some((x) => x.dataset.panel === name)) name = 'profile';
        panels.forEach((x) => { x.hidden = x.dataset.panel !== name; });
        tabs.forEach((x) => { const on = x.dataset.tab === name; x.classList.toggle('on', on); x.setAttribute('aria-selected', String(on)); });
      };
      tabs.forEach((x) => x.addEventListener('click', (e) => { e.preventDefault(); history.replaceState(null, '', `#${x.dataset.tab}`); show(x.dataset.tab!); }));
      window.addEventListener('hashchange', () => show(location.hash.slice(1)));
      show(location.hash.slice(1));
    }
    // My mailbox: copy the address.
    document.querySelectorAll<HTMLElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = t('mb.copied'); } catch {}
    }));
    // My designs: filter by product.
    document.querySelectorAll<HTMLElement>('.saved-filters [data-filter]').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('.saved-filters [data-filter]').forEach((x) => x.classList.toggle('on', x === b));
      document.querySelectorAll<HTMLElement>('.saved-item').forEach((it) => { it.hidden = b.dataset.filter !== 'all' && it.dataset.product !== b.dataset.filter; });
    }));
    // Saved designs: Reorder fills the review page with the same card, quantity and options (priced again today);
    // Delete asks first.
    document.querySelectorAll<HTMLElement>('[data-reorder]').forEach((b) => b.addEventListener('click', async () => {
      try {
        const j = await api({ action: 'design_get', id: Number(b.dataset.reorder) });
        localStorage.setItem('gp-card-order', JSON.stringify({ at: Date.now(), design: j.design.design, quantity: j.design.quantity ?? 100, options: j.design.options ?? {}, notes: '', saved_id: j.design.id }));
        if (!j.design.quantity) { location.href = `/cards/design?saved=${j.design.id}`; return; }
        location.href = '/cards/review';
      } catch (e: any) { const m = $('savedMsg')!; m.className = 'err'; m.textContent = e.message; }
    }));
    document.querySelectorAll<HTMLElement>('[data-deldesign]').forEach((b) => b.addEventListener('click', async () => {
      if (!confirm(t('saved.confirmdel'))) return;
      try { await api({ action: 'design_delete', id: Number(b.dataset.deldesign) }); b.closest('.saved-item')?.remove(); }
      catch (e: any) { const m = $('savedMsg')!; m.className = 'err'; m.textContent = e.message; }
    }));
    $('login')?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const f = ev.target as HTMLFormElement;
      try { const j = await apiCoded({ action: 'password_login', email: (f.querySelector('[name=email]') as HTMLInputElement).value, password: (f.querySelector('[name=password]') as HTMLInputElement).value, next: nextParam }); goNext(j.next); }
      catch (e: any) { msg().className = 'err'; msg().textContent = codeMsg(e); }
    });
    $('signup')?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const f = ev.target as HTMLFormElement, sm = $('smsg')!;
      const val = (n: string) => (f.querySelector(`[name=${n}]`) as HTMLInputElement).value;
      try { const box = (n: string) => (f.querySelector(`[name=${n}]`) as HTMLInputElement | null)?.checked === true;
      const j = await apiCoded({ action: 'signup', name: val('name'), email: val('email'), phone: val('phone'), password: val('password'), mkt_email: box('mkt_email'), mkt_sms: box('mkt_sms'), lang: document.documentElement.lang, next: nextParam }); sm.className = 'card'; sm.textContent = t('acct.confirm.sent'); devLink(sm, j.mock_link); f.querySelector('button[type=submit]')!.setAttribute('disabled', ''); }
      catch (e: any) { sm.className = 'err'; sm.textContent = codeMsg(e); }
    });
    $('pwf')?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const f = ev.target as HTMLFormElement, input = f.querySelector('[name=password]') as HTMLInputElement;
      try { await apiCoded({ action: 'set_password', password: input.value }); input.value = ''; msg().className = ''; msg().textContent = t('acct.pw.saved'); }
      catch (e: any) { msg().className = 'err'; msg().textContent = codeMsg(e); }
    });
    $('forgotBtn')?.addEventListener('click', async () => {
      const emailEl = document.querySelector('#login [name=email]') as HTMLInputElement;
      if (!emailEl.value.trim() || !emailEl.checkValidity()) { emailEl.reportValidity(); return; }
      try { const j = await apiCoded({ action: 'login', email: emailEl.value.trim(), next: nextParam }); msg().className = ''; msg().textContent = t('ship.gate.sent'); devLink(msg(), j.mock_link); }
      catch (e: any) { msg().className = 'err'; msg().textContent = codeMsg(e); }
    });
    // (the email-link sign-in form below is kept for pages that still post it)
    $('login-link')?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const email = (document.querySelector('#login-link [name=email]') as HTMLInputElement).value;
      try { const j = await api({ action: 'login', email, next: new URLSearchParams(location.search).get('next') ?? undefined }); msg().className = ''; msg().textContent = 'Check your email for the link.'; if (j.mock_link) { const a = document.createElement('a'); a.href = j.mock_link; a.textContent = ' (dev: open it)'; msg().appendChild(a); } }
      catch (e: any) { msg().className = 'err'; msg().textContent = e.message; }
    });
    document.querySelectorAll<HTMLInputElement>('#mktf input[data-channel]').forEach((box) => box.addEventListener('change', async () => {
      try { await api({ action: 'consent', channel: box.dataset.channel, granted: box.checked, lang: document.documentElement.lang }); msg().className = ''; msg().textContent = '✓'; }
      catch (e: any) { box.checked = !box.checked; msg().className = 'err'; msg().textContent = e.message; }
    }));
    $('logout')?.addEventListener('click', async () => { await api({ action: 'logout' }); location.href = '/account'; });
    $('namef')?.addEventListener('submit', async (ev) => { ev.preventDefault(); const d = Object.fromEntries(new FormData(ev.target as HTMLFormElement).entries()); try { await api({ action: 'name', ...d }); msg().className = ''; msg().textContent = 'Saved.'; } catch (e: any) { msg().className = 'err'; msg().textContent = e.message; } });
    $('addf')?.addEventListener('submit', async (ev) => { ev.preventDefault(); const d = Object.fromEntries(new FormData(ev.target as HTMLFormElement).entries()) as Record<string, string>; try { await api({ action: 'save_address', label: d.label, address: { contact_name: d.contact_name, line_1: d.line_1, line_2: d.line_2, city: d.city, state: d.state, postal_code: d.postal_code } }); location.reload(); } catch (e: any) { msg().className = 'err'; msg().textContent = e.message; } });
    document.querySelectorAll<HTMLButtonElement>('[data-resend]').forEach((b) => b.addEventListener('click', async () => { b.disabled = true; try { await api({ action: 'resend_label', order: b.dataset.resend }); msg().className = ''; msg().textContent = 'Sent. Check your email.'; } catch (e: any) { msg().className = 'err'; msg().textContent = e.message; b.disabled = false; } }));
    document.querySelectorAll<HTMLButtonElement>('[data-del]').forEach((b) => b.addEventListener('click', async () => { try { await api({ action: 'delete_address', id: b.dataset.del }); b.closest('li')!.remove(); } catch (e: any) { msg().className = 'err'; msg().textContent = e.message; } }));
  </script>
</Base>
