---
export const prerender = false;
import { env } from '../../../lib/env';
import Base from '../../../layouts/Base.astro';
import { getCardOrder } from '../../../lib/cardOrders';
import { renderCard, chosenOptions, routeCard, PRINTER_NAMES } from '../../../lib/cards';

// Staff page for a card order. Already paid online through Stripe. The print sheet is at /sheet.
const o = await getCardOrder(env, Astro.params.code ?? '');
if (!o) return new Response('No such order', { status: 404 });
const route = routeCard(o);
---
<Base title={`Counter · ${o.id}`}>
  <section class="hero">
    <h1>{o.id}</h1>
    <p class="lead"><span data-i18n="st.o.status">Status:</span> <strong data-i18n={`st.status.${o.status}`}>{o.status.replace('_', ' ')}</strong> · {o.quantity} <span data-i18n="st.k.cards">cards</span> · ${(o.total ?? o.price).toFixed(2)} <span data-i18n={o.status === 'awaiting_payment' ? 'st.k.notpaid' : 'st.k.paidonline'}>{o.status === 'awaiting_payment' ? 'NOT PAID, do not print' : 'paid online'}</span></p>
    <p class="staff-nav"><span data-i18n="st.staff">Staff:</span> <a href="/counter/queue" data-i18n="st.nav.queue">Queue</a> · <a href="/counter/batch" data-i18n="st.nav.batch">Batch</a> · <a href="/counter/pickups" data-i18n="st.nav.pickups">Pickups</a> · <a href="/counter/customers" data-i18n="st.nav.customers">Customers</a> · <a href="/counter/accounts" data-i18n="st.nav.accounts">Accounts</a> · <a href="/counter/dropoff" data-i18n="st.nav.dropoffs">Drop-offs</a> · <a href="/counter/mailboxes" data-i18n="st.nav.mailboxes">Mailboxes</a> · <a href="/counter/exceptions" data-i18n="st.nav.exceptions">Exceptions</a> · <a href="/counter/claims" data-i18n="st.nav.claims">Claims</a> · <a href="/counter/reports" data-i18n="st.nav.reports">Reports</a> · <a href="/counter/close" data-i18n="st.nav.close">End of day</a> · <a href="/counter/invoices" data-i18n="st.nav.invoices">Invoices</a> · <a href="/counter/rules" data-i18n="st.nav.prices">Prices</a> · <a href="/counter/staff" data-i18n="st.nav.staff">Staff</a> · <a href="/counter/export" data-i18n="st.nav.export">Export</a></p>
  </section>
  <div class="grid">
    <div>
      <div class="card-wrap" set:html={renderCard(o.design, 'front')} />
      <div class="card-wrap" set:html={renderCard(o.design, 'back') || '<p class="muted" data-i18n="st.k.blankback">Blank back</p>'} />
    </div>
    <div class="card">
      <p><strong data-i18n="st.o.customer">Customer:</strong> {o.customer.name} · {o.customer.email} {o.customer.phone}</p>
      {o.options?.some((x) => x.code === 'rush') && <p class="rush" data-i18n="st.k.rush">RUSH: ready next business day</p>}
      <p><strong data-i18n="st.k.options">Options:</strong> {chosenOptions(o.options).map((x, i) => <span>{i ? ', ' : ''}<span data-i18n={`cards.opt.${x.code}`}>{x.name}</span>{x.price ? ` ($${x.price.toFixed(2)})` : ''}</span>)}</p>
      {o.notes && <p><strong data-i18n="st.k.notes">Notes:</strong> {o.notes}</p>}
      <p><a class="btn" href={`/counter/card/${o.id}/sheet`} target="_blank" data-i18n="st.k.sheet">Open print sheet (10 up, letter)</a></p>
      <p><strong data-i18n="st.k.route">Print it:</strong> <span data-i18n={`st.k.printer.${route.printer}`}>{PRINTER_NAMES[route.printer]}</span> <span class="muted">({route.why})</span></p>
      {o.printer && <p><strong data-i18n="st.k.sentto">Sent to</strong> {o.printer.name} · {o.printer.sent_at.slice(0, 10)} · {o.printer.by}{o.printer.ref ? ` · ${o.printer.ref}` : ''}</p>}
      <label><span data-i18n="st.pin">Staff PIN</span> <input id="pin" type="password" inputmode="numeric" autocomplete="off" /></label>
      {o.status === 'paid' && <>
        <div class="row">
          <label><span data-i18n="st.k.printerkind">Printer</span> <select id="pkind"><option value="shop" selected={route.printer === 'shop'} data-i18n="st.k.printer.shop">In the shop (laser, 10-up sheet)</option><option value="trade" selected={route.printer === 'trade'} data-i18n="st.k.printer.trade">Trade printer, shipped in (4over)</option><option value="local" selected={route.printer === 'local'} data-i18n="st.k.printer.local">Sir Speedy Monroe (rush)</option></select></label>
          <label><span data-i18n="st.k.printref">Their order number (optional)</span> <input id="pref" maxlength="60" /></label>
        </div>
        <p><button class="btn" data-action="sent" data-i18n="st.k.sent">Sent to the printer</button> <button class="btn kraft" data-action="printed" data-i18n="st.printed">Mark printed</button></p>
      </>}
      {o.status === 'sent' && <p><button class="btn kraft" data-action="printed" data-i18n="st.k.arrived">Cards arrived, mark printed</button></p>}
      {(o.status === 'paid' || o.status === 'sent' || o.status === 'printed') && <p><button class="btn" data-action="picked_up" data-i18n="st.k.pickedup">Picked up</button></p>}
      <p id="msg"></p>
    </div>
  </div>
  <style>.rush { background: #fde68a; color: #3b2c00; font-weight: 700; padding: 6px 10px; border-radius: 6px; }</style>
  <script define:vars={{ id: o.id }}>
    const msg = document.getElementById('msg');
    document.querySelectorAll('[data-action]').forEach((b) => b.addEventListener('click', async () => {
      b.disabled = true;
      const res = await fetch('/api/cards', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ order: id, pin: document.getElementById('pin').value, action: b.dataset.action, printer: document.getElementById('pkind')?.value, name: document.getElementById('pkind')?.selectedOptions[0]?.textContent, ref: document.getElementById('pref')?.value }) });
      const j = await res.json();
      if (!res.ok) { msg.textContent = j.error; b.disabled = false; return; }
      location.reload();
    }));
  </script>
</Base>
