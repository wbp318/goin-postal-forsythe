---
export const prerender = false;
import Base from '../../layouts/Base.astro';

// Staff page: drop-off capture. A customer brings a prepaid or return package; scan or type its
// barcode and we record it with the time. A USB or Bluetooth barcode scanner acts as a keyboard,
// so a scan types the number into the focused field and presses Enter.
---
<Base title="Counter · Drop-offs">
  <section class="hero">
    <h1 data-i18n="st.d.h1">Drop-offs</h1>
    <p class="staff-nav"><span data-i18n="st.staff">Staff:</span> <a href="/counter/queue" data-i18n="st.nav.queue">Queue</a> · <a href="/counter/customers" data-i18n="st.nav.customers">Customers</a> · <a href="/counter/accounts" data-i18n="st.nav.accounts">Accounts</a> · <a href="/counter/dropoff" data-i18n="st.nav.dropoffs">Drop-offs</a> · <a href="/counter/exceptions" data-i18n="st.nav.exceptions">Exceptions</a> · <a href="/counter/reports" data-i18n="st.nav.reports">Reports</a> · <a href="/counter/close" data-i18n="st.nav.close">End of day</a> · <a href="/counter/invoices" data-i18n="st.nav.invoices">Invoices</a> · <a href="/counter/rules" data-i18n="st.nav.prices">Prices</a> · <a href="/counter/staff" data-i18n="st.nav.staff">Staff</a> · <a href="/counter/export" data-i18n="st.nav.export">Export</a></p>
    <p class="lead" data-i18n="st.d.lead">Scan the label's barcode, or type the tracking number. Each scan is recorded with the time, so a customer asking "did my package go out?" gets an answer.</p>
  </section>

  <div class="grid">
    <form id="accept" class="card" autocomplete="off">
      <label><span data-i18n="st.pin">Staff PIN</span> <input id="pin" type="password" inputmode="numeric" autocomplete="off" /></label>
      <label><span data-i18n="st.d.barcode">Barcode or tracking number</span> <input name="barcode" required minlength="8" maxlength="40" autofocus autocapitalize="characters" placeholder="Scan here" data-i18n-ph="st.d.scanhere" /></label>
      <label><span data-i18n="st.d.carrier">Carrier</span> <select name="carrier"><option value="" data-i18n="st.d.guess">Guess from the barcode</option><option>USPS</option><option>UPS</option><option>FedEx</option><option>DHL</option><option>Amazon</option></select></label>
      <label><span data-i18n="st.d.custname">Customer name (optional)</span> <input name="customer_name" maxlength="60" /></label>
      <label><span data-i18n="st.d.custphone">Customer phone (optional)</span> <input name="customer_phone" maxlength="20" inputmode="tel" /></label>
      <label><span data-i18n="st.yourname">Your name or initials</span> <input name="staff" maxlength="20" /></label>
      <label class="check"><input name="receipt" type="checkbox" checked /> <span data-i18n="st.d.receipt">Print a receipt at the counter</span></label>
      <label class="check"><input name="text" type="checkbox" /> <span data-i18n="st.d.text">Text the receipt to the phone above</span></label>
      <p class="btnrow"><button class="btn" type="submit" data-i18n="st.d.accept">Accept drop-off</button></p>
      <p id="msg" role="alert"></p>
      <p id="outbox" class="muted hidden"></p>
    </form>

    <div class="card">
      <h3 data-i18n="st.d.recent">Recent</h3>
      <p class="btnrow">
        <button class="btn kraft" data-handed="USPS">USPS <span data-i18n="st.d.pickedup">picked up</span></button>
        <button class="btn kraft" data-handed="UPS">UPS <span data-i18n="st.d.pickedup">picked up</span></button>
        <button class="btn kraft" data-handed="FedEx">FedEx <span data-i18n="st.d.pickedup">picked up</span></button>
        <button class="btn kraft" data-handed="DHL">DHL <span data-i18n="st.d.pickedup">picked up</span></button>
      </p>
      <p class="muted" data-i18n="st.d.pickedup.lead">Tap a carrier when its driver leaves. Every drop-off for that carrier still at the counter is marked as handed over at that time.</p>
      <ol class="timeline" id="recent"></ol>
    </div>
  </div>

  <script>
    import { t, tf } from '../../i18n';
    const form = document.getElementById('accept') as HTMLFormElement;
    const msg = document.getElementById('msg')!;
    const pin = () => (document.getElementById('pin') as HTMLInputElement).value;
    const recent = document.getElementById('recent')!;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const fmt = (iso: string) => new Date(iso).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    const beep = (ok: boolean) => { try { const c = new AudioContext(); const o = c.createOscillator(); o.frequency.value = ok ? 880 : 220; o.connect(c.destination); o.start(); o.stop(c.currentTime + 0.12); } catch {} };

    async function api(body: Record<string, unknown>) {
      const res = await fetch('/api/dropoff', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: pin(), ...body }) });
      const j = await res.json();
      if (!res.ok) throw new Error(j.error);
      return j;
    }

    async function refresh() {
      if (!pin()) return;
      try {
        const { dropoffs } = await api({ action: 'recent' });
        recent.innerHTML = '';
        for (const d of dropoffs) {
          const li = document.createElement('li');
          li.innerHTML = `<time>${fmt(d.accepted_at)}</time><strong></strong><span></span>`;
          li.querySelector('strong')!.textContent = `${d.carrier ?? '?'} ${d.barcode}`;
          li.querySelector('span')!.textContent = [d.customer_name, d.handed_to_carrier_at ? `${t('st.d.handed')} ${fmt(d.handed_to_carrier_at)}` : t('st.d.atcounter')].filter(Boolean).join(' · ');
          const acts = document.createElement('span');
          acts.innerHTML = `<a href="/counter/receipt/${d.id}">${t('st.d.receiptlink')}</a> · <button type="button" class="btn small kraft" data-reprint="${d.id}">${t('st.d.printagain')}</button>${d.customer_phone ? ` <button type="button" class="btn small kraft" data-retext="${d.id}">${t('st.d.textagain')}</button>` : ''}`;
          li.appendChild(acts);
          recent.appendChild(li);
        }
      } catch (e: any) { msg.className = 'err'; msg.textContent = e.message; }
    }

    // Offline outbox: a scan that cannot reach the site is kept on this device and sent when the connection is back.
    const OUTBOX = 'dropoff_outbox';
    const outbox = (): any[] => { try { return JSON.parse(localStorage.getItem(OUTBOX) || '[]'); } catch { return []; } };
    const saveOutbox = (list: any[]) => { try { localStorage.setItem(OUTBOX, JSON.stringify(list)); } catch {} showOutbox(); };
    function showOutbox() { const n = outbox().length; const el = document.getElementById('outbox')!; el.classList.toggle('hidden', !n); el.textContent = n ? tf('st.off.waiting', { n }) : ''; }
    const isNetworkError = (e: any) => e instanceof TypeError || /fetch|network|Failed/i.test(String(e?.message));
    let flushing = false;
    async function flushOutbox() {
      if (flushing || !pin()) return; flushing = true;
      try {
        let list = outbox();
        while (list.length) {
          const item = list[0];
          try { const j = await api({ action: 'accept', ...item }); list = list.slice(1); saveOutbox(list); msg.className = ''; msg.textContent = tf('st.off.sent', { barcode: j.dropoff.barcode, id: j.dropoff.id }); }
          catch (e: any) { if (isNetworkError(e)) break; list = list.slice(1); saveOutbox(list); msg.className = 'err'; msg.textContent = `${item.barcode}: ${e.message}`; }
        }
        if (!outbox().length) refresh();
      } finally { flushing = false; }
    }
    window.addEventListener('online', flushOutbox);
    setInterval(flushOutbox, 15000);
    showOutbox();
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const body = Object.fromEntries(new FormData(form).entries());
      msg.textContent = '';
      try {
        if (outbox().length) throw new TypeError('offline'); // keep order: earlier scans go first
        const j = await api({ action: 'accept', ...body });
        beep(true);
        msg.className = '';
        const r = j.receipt ?? {};
        const bits = [tf('st.d.accepted', { carrier: j.dropoff.carrier ?? '', barcode: j.dropoff.barcode, id: j.dropoff.id })];
        if (j.duplicate) bits.push(t('st.d.dup'));
        if (r.printed) bits.push(r.agent ? t('st.d.rsent') : t('st.d.rqueued'));
        if (r.texted) bits.push(r.text_mock ? t('st.d.tlogged') : t('st.d.tsent'));
        if (r.error) bits.push(`${t('st.d.rproblem')} ${r.error}`);
        msg.textContent = bits.join(' · ');
        for (const n of ['barcode', 'customer_name', 'customer_phone']) field(n).value = '';
        field('text').checked = false;
        field('barcode').focus();
        refresh();
      } catch (e: any) {
        if (isNetworkError(e)) {
          // No connection: keep the scan here with its time, clear the form, carry on scanning.
          saveOutbox([...outbox(), { ...body, scanned_at: new Date().toISOString() }]);
          beep(true); msg.className = ''; msg.textContent = tf('st.off.kept', { barcode: String(body.barcode) });
          for (const n of ['barcode', 'customer_name', 'customer_phone']) field(n).value = '';
          field('barcode').focus();
          flushOutbox();
          return;
        }
        beep(false); msg.className = 'err'; msg.textContent = e.message;
      }
    });
    document.querySelectorAll<HTMLButtonElement>('[data-handed]').forEach((b) => b.addEventListener('click', async () => {
      try { const j = await api({ action: 'handed', carrier: b.dataset.handed }); msg.className = ''; msg.textContent = tf('st.d.marked', { n: j.count, carrier: b.dataset.handed! }); refresh(); }
      catch (e: any) { msg.className = 'err'; msg.textContent = e.message; }
    }));
    recent.addEventListener('click', async (ev) => {
      const b = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-reprint],[data-retext]');
      if (!b) return;
      b.disabled = true;
      try {
        const j = await api(b.dataset.reprint ? { action: 'receipt', id: b.dataset.reprint } : { action: 'text', id: b.dataset.retext });
        msg.className = ''; msg.textContent = b.dataset.reprint ? (j.receipt.agent ? t('st.d.sentprinter') : t('st.d.queuednoagent')) : (j.receipt.text_mock ? t('st.d.tlogged') : t('st.d.tsent'));
      } catch (e: any) { msg.className = 'err'; msg.textContent = e.message; }
      b.disabled = false;
    });
    // Remember the receipt choice per tablet.
    const rbox = field('receipt');
    try { if (localStorage.getItem('dropoff_receipt') === 'off') rbox.checked = false; } catch {}
    rbox.addEventListener('change', () => { try { localStorage.setItem('dropoff_receipt', rbox.checked ? 'on' : 'off'); } catch {} });
    document.getElementById('pin')!.addEventListener('change', refresh);
    document.addEventListener('langchange', () => { if (pin()) refresh(); });
  </script>
</Base>
