---
export const prerender = false;
import Base from '../../../layouts/Base.astro';
import { env } from '../../../lib/env';
import { getMailbox, listMailboxNotices, listMailboxItems, listMailboxIds } from '../../../shipping/store';
import { ID_KINDS, NEVER_ACCEPTED, idExpired } from '../../../lib/mailboxIds';
import { store } from '../../../data/store';

// Staff page for one mailbox subscription: check the two IDs against the Form 1583 rules (v1.77.0),
// record the form, give the box number, notes, cancel. Payment already happened on Stripe and renews there.
const m = await getMailbox(env, Astro.params.code ?? '');
if (!m) return new Response('No such mailbox', { status: 404 });
const notices = await listMailboxNotices(env, m.code);
const items = await listMailboxItems(env, m.code, 30);
const ids = await listMailboxIds(env, m.code);
const scanWhere = env.AZURE_ID_SCANS_SAS ? 'ID scans go to the owners\' private Azure container. Reading one takes the PIN and is logged.' : 'ID scans stay in private storage on the site, never behind a link. Reading one takes the PIN and is logged.';
const inbox = items.filter((i) => i.status === 'arrived');
const fmt = (iso: string | null) => (iso ? new Date(iso).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '');
---
<Base title={`Counter · ${m.code}`}>
  <section class="hero">
    <h1>{m.code}</h1>
    <p class="lead"><span data-i18n="st.o.status">Status:</span> <strong data-i18n={`st.m.status.${m.status}`}>{m.status.replace('_', ' ')}</strong> · <span data-i18n={`mb.size.${m.size}`}>{m.size}</span> · ${m.price.toFixed(2)} <span data-i18n={m.term === 'yearly' ? 'mb.peryear' : 'mb.permonth2'}>{m.term === 'yearly' ? 'a year' : 'a month'}</span>{m.current_period_end && <> · <span data-i18n="st.m.th.renews">Renews</span> {fmt(m.current_period_end)}</>}{m.status === 'awaiting_payment' && <> · <strong data-i18n="st.k.notpaid">NOT PAID, do not print</strong></>}</p>
    <p class="staff-nav"><span data-i18n="st.staff">Staff:</span> <a href="/counter/queue" data-i18n="st.nav.queue">Queue</a> · <a href="/counter/batch" data-i18n="st.nav.batch">Batch</a> · <a href="/counter/fulfillment" data-i18n="st.nav.fulfillment">Fulfillment</a> · <a href="/counter/pickups" data-i18n="st.nav.pickups">Pickups</a> · <a href="/counter/customers" data-i18n="st.nav.customers">Customers</a> · <a href="/counter/accounts" data-i18n="st.nav.accounts">Accounts</a> · <a href="/counter/dropoff" data-i18n="st.nav.dropoffs">Drop-offs</a> · <a href="/counter/scan" data-i18n="st.nav.scan">Scan a QR</a> · <a href="/counter/mailboxes" data-i18n="st.nav.mailboxes">Mailboxes</a> · <a href="/counter/exceptions" data-i18n="st.nav.exceptions">Exceptions</a> · <a href="/counter/claims" data-i18n="st.nav.claims">Claims</a> · <a href="/counter/reports" data-i18n="st.nav.reports">Reports</a> · <a href="/counter/close" data-i18n="st.nav.close">End of day</a> · <a href="/counter/invoices" data-i18n="st.nav.invoices">Invoices</a> · <a href="/counter/rules" data-i18n="st.nav.prices">Prices</a> · <a href="/counter/staff" data-i18n="st.nav.staff">Staff</a> · <a href="/counter/export" data-i18n="st.nav.export">Export</a></p>
  </section>
  <div class="grid">
    <div class="card">
      <p><strong data-i18n="st.o.customer">Customer:</strong> {m.customer_name}{m.business_name ? ` (${m.business_name})` : ''} · {m.email}{m.phone ? ` · ${m.phone}` : ''}{m.customer_id && <> · <a href={`/counter/customers?q=${encodeURIComponent(m.email)}`} data-i18n="st.nav.customers">Customers</a></>}</p>
      <p><strong data-i18n="st.m.th.box">Box</strong> {m.box_number ? <strong>#{m.box_number}</strong> : <span class="muted" data-i18n="st.m.nobox">not given yet</span>}{m.box_number && <> · <span data-i18n="mb.done.addr">Your address is</span> {m.business_name || m.customer_name}, {store.address.replace(/,\s*/, ` #${m.box_number}, `)}</>}</p>
      <p><strong>Form 1583</strong> {m.form_1583_at ? <><span data-i18n="st.m.recorded">recorded</span> {fmt(m.form_1583_at)} ({m.form_1583_by})</> : <span class="muted" data-i18n="st.m.need1583">needs Form 1583</span>}</p>
      {ids.length > 0 && <><h4 data-i18n="st.id.onfile">IDs on file</h4>
      <ul>{ids.map((i) => <li><strong data-i18n={`st.id.${i.slot}`}>{i.slot === 'primary' ? 'Photo ID' : 'Second ID'}</strong>: {i.issuer} <span data-i18n={`st.idk.${i.kind}`}>{i.kind}</span>{i.last4 ? ` …${i.last4}` : ''}{i.expires && <> · <span data-i18n="st.id.expires">Expires</span> {i.expires}</>}{i.shows_address ? <> · <span data-i18n="st.id.address">Shows the current home address</span></> : null} · <span data-i18n="st.id.checked">checked</span> {fmt(i.verified_at)} ({i.verified_by}){idExpired(i.expires) && <> · <strong class="err" data-i18n="st.id.expired">EXPIRED: the holder must bring a current one</strong></>}
        <span class="btnrow" data-idrow={i.id}> {i.scan_id ? <button class="btn small kraft" type="button" data-idview data-i18n="st.id.view">View the scan</button> : <label class="btn small kraft" style="cursor: pointer"><span data-i18n="st.id.upscan">Upload the scan</span> <input type="file" accept="image/*,application/pdf" data-idscan style="display: none" /></label>}</span></li>)}</ul>
      <p class="muted" data-i18n={env.AZURE_ID_SCANS_SAS ? 'st.id.where.azure' : 'st.id.where.kv'}>{scanWhere}</p></>}
      {m.form_1583_at && ids.length === 0 && m.ids_seen && <p class="muted">{m.ids_seen}</p>}
      {m.notes && <p><strong data-i18n="st.k.notes">Notes:</strong> <span style="white-space: pre-line">{m.notes}</span></p>}
      <h3 data-i18n="st.m.arrived">Something arrived</h3>
      <p class="muted" data-i18n="st.m.arrived.lead">One tap texts the holder (when there is a phone) and emails them, and keeps the time here.</p>
      <p class="btnrow"><button class="btn" type="button" data-notice="mail" data-i18n="st.m.mailin">Mail in</button> <button class="btn" type="button" data-notice="package" data-i18n="st.m.packagein">Package in</button></p>
      <label><span data-i18n="st.m.noticenote">Say what (optional, goes in the text)</span> <input id="noticenote" maxlength="120" placeholder="2 boxes from Amazon" /></label>
      <p id="nmsg" role="alert"></p>
      {notices.length > 0 && <ol class="timeline">{notices.map((n) => <li><time>{fmt(n.at)}</time><strong data-i18n={`st.m.kind.${n.kind}`}>{n.kind}</strong><span>{[n.note, n.by_name, n.texted ? 'texted' : '', n.emailed ? 'emailed' : '', n.error].filter(Boolean).join(' · ')}</span></li>)}</ol>}
      {m.stripe_subscription_id && <p class="muted">Stripe {m.stripe_subscription_id}</p>}
    </div>
    <div class="card" id="maillog">
      <h3 data-i18n="st.mi.h3">Log what came in</h3>
      <p class="muted" data-i18n="st.mi.lead">One row per piece, with a photo if you take one. The holder sees it signed in on their account page, like Informed Delivery. Tick notify to text and email them too.</p>
      <form id="itemf" autocomplete="off">
        <div class="row">
          <label><span data-i18n="st.mi.kind">What</span> <select name="kind"><option value="letter" data-i18n="acct.mb.kind.letter">Letter</option><option value="package" data-i18n="acct.mb.kind.package">Package</option><option value="magazine" data-i18n="acct.mb.kind.magazine">Magazine</option><option value="other" data-i18n="acct.mb.kind.other">Something else</option></select></label>
          <label><span data-i18n="st.mi.sender">From (as printed on it)</span> <input name="sender" maxlength="80" placeholder="Entergy" /></label>
        </div>
        <label><span data-i18n="st.mi.note">Note</span> <input name="note" maxlength="200" /></label>
        <label><span data-i18n="st.mi.photo">Photo</span> <input id="itemphoto" type="file" accept="image/*" capture="environment" /></label>
        <label><input type="checkbox" name="notify" checked /> <span data-i18n="st.mi.notify">Text and email the holder</span></label>
        <p class="btnrow"><button class="btn" type="submit" data-i18n="st.mi.add">Put it in the box</button> <span id="imsg" role="alert"></span></p>
      </form>
      <h4><span data-i18n="st.mi.inbox">In the box</span> ({inbox.length})</h4>
      {inbox.length === 0 && <p class="muted" data-i18n="acct.mb.nothing">Nothing waiting. We log each piece as it comes in.</p>}
      <ul class="items">{inbox.map((i) => <li data-item={i.id}>{i.photo_id && <a href={`/api/mailbox?photo=${i.photo_id}`} target="_blank" rel="noopener"><img src={`/api/mailbox?photo=${i.photo_id}`} alt="" loading="lazy" style="max-height: 64px; max-width: 96px; vertical-align: middle; border-radius: 4px" /></a>} <strong data-i18n={`acct.mb.kind.${i.kind}`}>{i.kind}</strong>{i.sender ? <> <span data-i18n="acct.mb.from">from</span> {i.sender}</> : null}{i.note ? ` · ${i.note}` : ''} · <time>{fmt(i.arrived_at)}</time> · {i.arrived_by}{i.notified ? ' · notified' : ''}
        {i.scan_id ? <> · <a href={`/api/mailbox?photo=${i.scan_id}`} target="_blank" rel="noopener" data-i18n="st.mi.scanned">scanned</a> {fmt(i.scanned_at)}</> : i.scan_requested_at ? <> · <strong class="err" data-i18n="st.mi.scanreq">SCAN REQUESTED</strong> {fmt(i.scan_requested_at)}</> : null}
        <span class="btnrow"> <label class="btn small kraft" style="cursor: pointer"><span data-i18n="st.mi.upload">Upload scan</span> <input type="file" accept="image/*,application/pdf" data-scanfile style="display: none" /></label></span></li>)}</ul>
    </div>
    <form class="card" id="acts" autocomplete="off">
      <label><span data-i18n="st.pin">Staff PIN</span> <input id="pin" type="password" inputmode="numeric" autocomplete="off" /></label>
      {m.status !== 'cancelled' && !m.form_1583_at && <>
        <p class="muted" data-i18n="st.id.lead">Two IDs, as USPS Form 1583 asks: one with a photo, one showing the current home address, neither expired. Only the kind, the issuer, the last four and the expiry are kept here, never the whole number. Fill in the paper form with the customer and keep the store copy.</p>
        <p class="muted"><span data-i18n="st.id.never">Never accepted:</span> {NEVER_ACCEPTED.join(', ')}.</p>
        {(['primary', 'secondary'] as const).map((slot) => <fieldset class="idset" data-slot={slot}>
          <legend data-i18n={`st.id.${slot}`}>{slot === 'primary' ? 'Photo ID' : 'Second ID'}</legend>
          <div class="row">
            <label><span data-i18n="st.id.kind">What is it</span> <select name={`${slot}.kind`}><option value=""></option>{ID_KINDS.filter((k) => slot === 'secondary' || k.photo).map((k) => <option value={k.id} data-i18n={`st.idk.${k.id}`}>{k.name}</option>)}</select></label>
            <label><span data-i18n="st.id.issuer">Issued by (state, country, insurer, landlord)</span> <input name={`${slot}.issuer`} maxlength="40" placeholder={slot === 'primary' ? 'LA' : 'State Farm'} /></label>
          </div>
          <div class="row">
            <label><span data-i18n="st.id.last4">Last 4 of the number</span> <input name={`${slot}.last4`} maxlength="4" inputmode="numeric" autocomplete="off" /></label>
            <label><span data-i18n="st.id.expires">Expires</span> <input name={`${slot}.expires`} type="date" /></label>
          </div>
          <label><input type="checkbox" name={`${slot}.shows_address`} /> <span data-i18n="st.id.address">Shows the current home address</span></label>
          <label><span data-i18n="st.id.scan">Scan of the ID (photo or PDF, kept in secure storage)</span> <input type="file" name={`${slot}.image`} accept="image/*,application/pdf" capture="environment" /></label>
        </fieldset>)}
        <p><button class="btn" type="button" data-action="form1583" data-i18n="st.m.record1583">Record Form 1583</button></p>
      </>}
      {m.status !== 'cancelled' && m.form_1583_at && <details class="idreplace">
        <summary data-i18n="st.id.replace">Replace this ID</summary>
        <fieldset class="idset" data-slot="replace">
          <div class="row">
            <label><span data-i18n="st.id.primary">Photo ID</span>/<span data-i18n="st.id.secondary">Second ID</span> <select name="replace.slot"><option value="primary" data-i18n="st.id.primary">Photo ID</option><option value="secondary" data-i18n="st.id.secondary">Second ID</option></select></label>
            <label><span data-i18n="st.id.kind">What is it</span> <select name="replace.kind"><option value=""></option>{ID_KINDS.map((k) => <option value={k.id} data-i18n={`st.idk.${k.id}`}>{k.name}</option>)}</select></label>
          </div>
          <div class="row">
            <label><span data-i18n="st.id.issuer">Issued by (state, country, insurer, landlord)</span> <input name="replace.issuer" maxlength="40" /></label>
            <label><span data-i18n="st.id.last4">Last 4 of the number</span> <input name="replace.last4" maxlength="4" inputmode="numeric" autocomplete="off" /></label>
            <label><span data-i18n="st.id.expires">Expires</span> <input name="replace.expires" type="date" /></label>
          </div>
          <label><input type="checkbox" name="replace.shows_address" /> <span data-i18n="st.id.address">Shows the current home address</span></label>
          <label><span data-i18n="st.id.scan">Scan of the ID (photo or PDF, kept in secure storage)</span> <input type="file" name="replace.image" accept="image/*,application/pdf" capture="environment" /></label>
          <p><button class="btn" type="button" data-action="id_replace" data-i18n="st.id.save">Save the new ID</button></p>
        </fieldset>
      </details>}
      {m.status !== 'cancelled' && m.form_1583_at && !m.box_number && <>
        <label><span data-i18n="st.m.boxnum">Box number</span> <input name="box_number" maxlength="10" inputmode="numeric" /></label>
        <p><button class="btn" type="button" data-action="box" data-i18n="st.m.givebox">Give this box</button></p>
      </>}
      <label><span data-i18n="st.k.notes">Notes:</span> <textarea name="notes" rows="3" maxlength="500">{m.notes}</textarea></label>
      <p><button class="btn kraft" type="button" data-action="note" data-i18n="st.m.savenote">Save notes</button></p>
      {m.status !== 'cancelled' && <>
        <label><span data-i18n="st.m.reason">Reason to cancel</span> <input name="reason" maxlength="200" /></label>
        <p><button class="btn" type="button" data-action="cancel" data-i18n="st.m.cancel">Cancel the subscription</button></p>
      </>}
      <p id="msg" role="alert"></p>
    </form>
  </div>
  <style>
    .idset { border: 1px solid var(--line, #bbb); padding: 8px 12px; margin: 8px 0 }
    .idset legend { font-weight: bold }
    .idreplace summary { cursor: pointer; margin: 8px 0 }
  </style>
  <script define:vars={{ code: m.code }}>
    const form = document.getElementById('acts'), msg = document.getElementById('msg');
    const pin = () => document.getElementById('pin').value;
    // The mail log: shrink the photo to 1280 px JPEG in the browser, send everything as JSON, reload.
    async function shrink(file) {
      const bmp = await createImageBitmap(file);
      const scale = Math.min(1, 1280 / Math.max(bmp.width, bmp.height));
      const c = document.createElement('canvas'); c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
      c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
      let q = 0.82, out = c.toDataURL('image/jpeg', q);
      while (out.length > 780_000 && q > 0.4) { q -= 0.1; out = c.toDataURL('image/jpeg', q); }
      return out;
    }
    // An ID scan: images shrunk like photos, PDFs as they are (4 MB limit on the server).
    const asDataUrl = (file) => file.type === 'application/pdf' ? new Promise((ok, no) => { const r = new FileReader(); r.onload = () => ok(r.result); r.onerror = no; r.readAsDataURL(file); }) : shrink(file);
    document.querySelectorAll('[data-idrow] [data-idscan]').forEach((inp) => inp.addEventListener('change', async () => {
      const file = inp.files[0]; if (!file) return;
      msg.className = ''; msg.textContent = '…';
      try {
        const res = await fetch('/api/mailbox', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code, pin: pin(), action: 'id_scan', id: inp.closest('[data-idrow]').dataset.idrow, image: await asDataUrl(file) }) });
        const j = await res.json();
        if (!res.ok) throw new Error(j.error);
        location.reload();
      } catch (e) { msg.className = 'err'; msg.textContent = e.message; }
    }));
    document.querySelectorAll('[data-idrow] [data-idview]').forEach((b) => b.addEventListener('click', async () => {
      msg.className = ''; msg.textContent = '…';
      try {
        const res = await fetch('/api/mailbox', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code, pin: pin(), action: 'id_scan_read', id: b.closest('[data-idrow]').dataset.idrow }) });
        const j = await res.json();
        if (!res.ok) throw new Error(j.error);
        const blob = await (await fetch(j.data)).blob();
        window.open(URL.createObjectURL(blob), '_blank', 'noopener');
        msg.textContent = '';
      } catch (e) { msg.className = 'err'; msg.textContent = e.message; }
    }));
    const itemf = document.getElementById('itemf'), imsg = document.getElementById('imsg');
    itemf.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const btn = itemf.querySelector('button'); btn.disabled = true; imsg.className = ''; imsg.textContent = '…';
      try {
        const d = Object.fromEntries(new FormData(itemf).entries());
        const file = document.getElementById('itemphoto').files[0];
        const image = file ? await shrink(file) : '';
        const res = await fetch('/api/mailbox', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code, pin: pin(), action: 'item', kind: d.kind, sender: d.sender, note: d.note, image, notify: d.notify === 'on' }) });
        const j = await res.json();
        if (!res.ok) throw new Error(j.error);
        location.reload();
      } catch (e) { imsg.className = 'err'; imsg.textContent = e.message; btn.disabled = false; }
    });
    // Open-and-scan: a photo (shrunk) or a PDF from the counter scanner, as a data URL, for one item.
    document.querySelectorAll('#maillog [data-scanfile]').forEach((inp) => inp.addEventListener('change', async () => {
      const file = inp.files[0]; if (!file) return;
      imsg.className = ''; imsg.textContent = '…';
      try {
        const image = file.type === 'application/pdf' ? await new Promise((ok, no) => { const r = new FileReader(); r.onload = () => ok(r.result); r.onerror = no; r.readAsDataURL(file); }) : await shrink(file);
        const res = await fetch('/api/mailbox', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code, pin: pin(), action: 'scan', id: inp.closest('[data-item]').dataset.item, image }) });
        const j = await res.json();
        if (!res.ok) throw new Error(j.error);
        location.reload();
      } catch (e) { imsg.className = 'err'; imsg.textContent = e.message; }
    }));
    document.querySelectorAll('[data-notice]').forEach((b) => b.addEventListener('click', async () => {
      b.disabled = true;
      const res = await fetch('/api/mailbox', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code, pin: document.getElementById('pin').value, action: 'notice', kind: b.dataset.notice, note: document.getElementById('noticenote').value }) });
      const j = await res.json();
      if (!res.ok) { const n = document.getElementById('nmsg'); n.className = 'err'; n.textContent = j.error; b.disabled = false; return; }
      location.reload();
    }));
    form.querySelectorAll('[data-action]').forEach((b) => b.addEventListener('click', async () => {
      b.disabled = true;
      // "primary.kind" style names become nested objects: { primary: { kind } }. The ID form sends two of them.
      const d = {};
      for (const [k, v] of new FormData(form).entries()) {
        const [a, c] = k.split('.');
        const val = v instanceof File ? (v.size ? await asDataUrl(v) : '') : v;
        if (c) (d[a] ??= {})[c] = val; else d[a] = val;
      }
      if (d.replace) { d.slot = d.replace.slot; d.id = d.replace; delete d.replace; }
      const res = await fetch('/api/mailbox', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ code, pin: document.getElementById('pin').value, action: b.dataset.action, ...d }) });
      const j = await res.json();
      if (!res.ok) { msg.className = 'err'; msg.textContent = j.error; b.disabled = false; return; }
      location.reload();
    }));
  </script>
</Base>
