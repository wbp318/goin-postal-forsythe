---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { store } from '../../data/store';

// Staff page: the quote queue. Every quote a customer reserved online and every walk-up staff typed
// in, oldest first, with buy, print, void and cancel on the same screen. Walk-ups are quoted with the
// same rating engine the website uses, so the counter and the site never disagree on a price.
---
<Base title="Counter · Queue">
  <section class="hero">
    <h1>Queue</h1>
    <p class="staff-nav">Staff: <a href="/counter/queue">Queue</a> · <a href="/counter/customers">Customers</a> · <a href="/counter/dropoff">Drop-offs</a> · <a href="/counter/exceptions">Exceptions</a> · <a href="/counter/reports">Reports</a> · <a href="/counter/rules">Prices</a></p>
    <p class="lead">Who is waiting on a label. Online reservations show up here by themselves; type a walk-up in below. Oldest first.</p>
  </section>

  <div class="card">
    <p class="btnrow">
      <label>Staff PIN <input id="pin" type="password" inputmode="numeric" autocomplete="off" /></label>
      <label>Your name or initials <input id="staff" maxlength="20" /></label>
      <button class="btn" id="load">Show queue</button>
    </p>
    <p id="msg" role="alert"></p>
    <table class="list hidden" id="table">
      <thead><tr><th>Waiting</th><th>Code</th><th>Customer</th><th>To</th><th>Service</th><th>Status</th><th>Do</th></tr></thead>
      <tbody></tbody>
    </table>
    <p id="empty" class="muted hidden">Nobody is waiting.</p>
    <details id="donewrap" class="hidden"><summary>Finished in the last day</summary>
      <table class="list" id="done"><thead><tr><th>When</th><th>Code</th><th>Customer</th><th>Service</th><th>Status</th><th></th></tr></thead><tbody></tbody></table>
    </details>
  </div>

  <script type="application/json" id="storeAddr" set:html={JSON.stringify(store.origin)} />
  <h2>Walk-up</h2>
  <p class="muted">Quote a customer at the counter. Pick a rate and add it to the queue; ring it up on the POS, then press Buy label in the queue. The customer gets the same price the website would show.</p>
  <form id="walkup" class="ship-form" autocomplete="off">
    <fieldset>
      <legend>Who is shipping</legend>
      <div class="row">
        <label>Customer name <input name="name" maxlength="60" /></label>
        <label>Mobile (optional) <input name="phone" inputmode="tel" maxlength="20" /></label>
        <label>Email (optional) <input name="email" type="email" /></label>
      </div>
      <label class="check"><input name="sms" type="checkbox" /> Text them when it ships and when it is delivered</label>
    </fieldset>
    <fieldset>
      <legend>Return label?</legend>
      <label class="check"><input name="is_return" type="checkbox" id="isReturn" /> This is a <strong>return</strong>: the package is somewhere else and travels <em>to</em> us or to a local business. We pay here, then email the label to the sender.</label>
      <div id="returnFields" class="hidden">
        <p class="muted">Where the package is now (the sender). US addresses only; international returns need customs forms, so quote those on the Ship page.</p>
        <label>Sender name <input name="from_contact_name" /></label>
        <label>Street address <input name="from_line_1" maxlength="35" /></label>
        <label>Apt, suite (optional) <input name="from_line_2" maxlength="35" /></label>
        <div class="row">
          <label>City <input name="from_city" /></label>
          <label>State <input name="from_state" placeholder="TX" maxlength="2" /></label>
          <label>ZIP <input name="from_postal_code" /></label>
        </div>
        <label>Comes back to
          <select name="return_to" id="returnTo"><option value="store">Us, the store (the business picks it up here)</option><option value="other">Another address, typed below</option></select>
        </label>
      </div>
    </fieldset>
    <fieldset id="destFields">
      <legend id="destLegend">Where is it going</legend>
      <label>Recipient name <input name="contact_name" required /></label>
      <label>Street address <input name="line_1" required maxlength="35" /></label>
      <label>Apt, suite (optional) <input name="line_2" maxlength="35" /></label>
      <div class="row">
        <label>City <input name="city" required /></label>
        <label>State <input name="state" placeholder="LA" maxlength="2" /></label>
        <label>ZIP / postal code <input name="postal_code" required /></label>
        <label>Country <input name="country_alpha2" value="US" maxlength="2" required /></label>
      </div>
    </fieldset>
    <fieldset>
      <legend>What is it</legend>
      <div class="row">
        <label>Weight (lb) <input name="weight_lb" type="number" step="0.1" min="0.1" max="150" required /></label>
        <label>Length (in) <input name="length_in" type="number" min="1" required /></label>
        <label>Width (in) <input name="width_in" type="number" min="1" required /></label>
        <label>Height (in) <input name="height_in" type="number" min="1" required /></label>
      </div>
      <div class="row">
        <label>What's inside <input name="description" maxlength="80" placeholder="Clothing" /></label>
        <label>Value in USD <input name="value_usd" type="number" min="1" placeholder="25" /></label>
      </div>
    </fieldset>
    <p class="btnrow"><button class="btn" type="submit" id="rateBtn">Get rates</button> <button class="btn kraft" type="button" id="clear">Clear form</button></p>
    <p id="werr" class="err" hidden></p>
  </form>
  <section id="results" hidden>
    <p id="mockNote" class="muted" hidden>Demo rates: live carrier rates appear once the store's carrier accounts are connected.</p>
    <div id="rates" class="rates"></div>
    <p class="btnrow"><button class="btn" id="addBtn" disabled>Add to queue</button></p>
  </section>

  <script>
    const $ = (id: string) => document.getElementById(id)!;
    const pin = () => ($('pin') as HTMLInputElement).value;
    const staff = () => ($('staff') as HTMLInputElement).value;
    const msg = $('msg');
    const table = $('table'), body = table.querySelector('tbody')!, empty = $('empty');
    const doneWrap = $('donewrap'), doneBody = $('done').querySelector('tbody')!;
    const STATUS: Record<string, string> = { awaiting_payment: 'Not paid online', reserved: 'Pay on the POS', labeled: 'Label bought', printed: 'Printed', voided: 'Voided', cancelled: 'Cancelled' };
    const fmt = (iso: string) => new Date(iso).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    const ago = (iso: string) => { const m = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000)); return m < 60 ? `${m} min` : m < 1440 ? `${Math.floor(m / 60)} h ${m % 60} min` : `${Math.floor(m / 1440)} d`; };

    async function api(path: string, extra: Record<string, unknown> = {}) {
      const res = await fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: pin(), ...extra }) });
      const j = await res.json();
      if (!res.ok) throw new Error(j.error);
      return j;
    }
    const cell = (tr: HTMLTableRowElement, text: string, cls?: string) => { const td = document.createElement('td'); td.textContent = text; if (cls) td.className = cls; tr.appendChild(td); return td; };
    const button = (label: string, cls: string, onClick: () => Promise<void>) => {
      const b = document.createElement('button'); b.className = `btn small ${cls}`.trim(); b.textContent = label;
      b.addEventListener('click', async () => { b.disabled = true; msg.className = ''; msg.textContent = ''; try { await onClick(); } catch (e: any) { msg.className = 'err'; msg.textContent = e.message; } b.disabled = false; });
      return b;
    };

    async function load() {
      if (!pin()) { msg.className = 'err'; msg.textContent = 'Enter the staff PIN first.'; return; }
      try {
        const { open, done } = await api('/api/queue', { action: 'list' });
        body.innerHTML = '';
        for (const q of open) {
          const tr = document.createElement('tr');
          tr.className = q.status;
          const wait = cell(tr, ago(q.created_at));
          if (Date.now() - new Date(q.created_at).getTime() > 20 * 60000 && q.status !== 'awaiting_payment') wait.style.color = '#b91c1c';
          const code = cell(tr, ''); code.innerHTML = `<a href="/counter/${q.id}"></a>`; code.querySelector('a')!.textContent = q.id;
          cell(tr, [q.customer_name, q.phone, q.source === 'counter' ? `walk-up${q.staff ? `, ${q.staff}` : ''}` : 'online'].filter(Boolean).join(' · '));
          const dest = cell(tr, q.destination + (q.international ? ' · international' : ''));
          if (q.destination.startsWith('Return from')) dest.style.fontWeight = '700';
          cell(tr, `${q.carrier} ${q.service} · $${Number(q.price).toFixed(2)}`);
          cell(tr, STATUS[q.status] ?? q.status);
          const act = document.createElement('td'); act.className = 'btnrow';
          if (q.status === 'reserved') act.appendChild(button('Rung up. Buy label', '', async () => { await api('/api/counter', { order: q.id, action: 'paid' }); msg.textContent = `${q.id}: label bought.`; await load(); }));
          if (q.status === 'labeled') {
            act.appendChild(button('Print at the counter', '', async () => { const j = await api('/api/print', { order: q.id, action: 'queue', printer: 'counter' }); msg.textContent = j.agent ? `${q.id}: sent to the counter printer.` : `${q.id}: queued, but no printer agent is set up. Open the order and use "Open label to print".`; }));
            act.appendChild(button('Mark printed', 'kraft', async () => { await api('/api/counter', { order: q.id, action: 'printed' }); await load(); }));
            act.appendChild(button('Email label', 'kraft', async () => {
              const email = window.prompt(`Email the label for ${q.id} to:`, q.email ?? '');
              if (email === null) return;
              const j = await api('/api/counter', { order: q.id, action: 'email', email });
              msg.textContent = j.mock ? `${q.id}: label email logged (no Resend key yet) for ${j.email}.` : `${q.id}: label emailed to ${j.email}.`;
            }));
            act.appendChild(button('Void', 'kraft', async () => { if (!window.confirm(`Void the label for ${q.id} with the carrier? Refund the customer by hand if they paid.`)) return; await api('/api/counter', { order: q.id, action: 'void' }); await load(); }));
          }
          if (q.status === 'reserved' || q.status === 'awaiting_payment') act.appendChild(button('Cancel', 'kraft', async () => { if (!window.confirm(`Drop quote ${q.id}? Nothing has been bought.`)) return; await api('/api/counter', { order: q.id, action: 'cancel' }); await load(); }));
          tr.appendChild(act);
          body.appendChild(tr);
        }
        table.classList.toggle('hidden', !open.length);
        empty.classList.toggle('hidden', !!open.length);
        doneBody.innerHTML = '';
        for (const q of done) {
          const tr = document.createElement('tr');
          cell(tr, fmt(q.updated_at)); const code = cell(tr, ''); code.innerHTML = `<a href="/counter/${q.id}"></a>`; code.querySelector('a')!.textContent = q.id;
          cell(tr, q.customer_name ?? ''); cell(tr, `${q.carrier} ${q.service} · $${Number(q.price).toFixed(2)}`); cell(tr, STATUS[q.status] ?? q.status);
          const td = cell(tr, ''); if (q.status === 'printed') td.innerHTML = `<a href="/track?q=${q.id}">Track</a>`;
          doneBody.appendChild(tr);
        }
        doneWrap.classList.toggle('hidden', !done.length);
      } catch (e: any) { msg.className = 'err'; msg.textContent = e.message; }
    }
    $('load').addEventListener('click', load);
    $('pin').addEventListener('change', load);
    setInterval(() => { if (pin() && document.visibilityState === 'visible') load(); }, 30000);

    // ---- walk-up quote ----
    const f = $('walkup') as HTMLFormElement;
    const werr = $('werr'), results = $('results'), ratesEl = $('rates'), addBtn = $('addBtn') as HTMLButtonElement, rateBtn = $('rateBtn') as HTMLButtonElement;
    let payload: any = null, picked: string | null = null;
    const STORE = JSON.parse(document.getElementById('storeAddr')!.textContent!);
    const isReturn = $('isReturn') as HTMLInputElement, returnTo = $('returnTo') as HTMLSelectElement, destFields = $('destFields');
    const destRequired = f.querySelectorAll<HTMLInputElement>('#destFields [required]');
    function returnMode() {
      const r = isReturn.checked;
      $('returnFields').classList.toggle('hidden', !r);
      const toStore = r && returnTo.value === 'store';
      destFields.classList.toggle('hidden', toStore);
      destRequired.forEach((el) => { el.required = !toStore; });
      $('destLegend').textContent = r ? 'Where it comes back to' : 'Where is it going';
      f.querySelectorAll<HTMLInputElement>('#returnFields input').forEach((el) => { el.required = r && el.name !== 'from_line_2'; });
    }
    isReturn.addEventListener('change', returnMode); returnTo.addEventListener('change', returnMode);
    function read() {
      const d = Object.fromEntries(new FormData(f).entries()) as Record<string, string>;
      const r = isReturn.checked;
      return {
        kind: r ? 'return' : 'ship',
        return_to: r ? returnTo.value : undefined,
        origin: r ? { contact_name: d.from_contact_name, line_1: d.from_line_1, line_2: d.from_line_2, city: d.from_city, state: d.from_state, postal_code: d.from_postal_code, country_alpha2: 'US' } : undefined,
        customer: { name: d.name, phone: d.phone, email: d.email, sms: d.sms === 'on' },
        destination: r && returnTo.value === 'store' ? undefined : { contact_name: d.contact_name, line_1: d.line_1, line_2: d.line_2, city: d.city, state: d.state, postal_code: d.postal_code, country_alpha2: d.country_alpha2.toUpperCase() },
        parcel: { weight_lb: d.weight_lb, length_in: d.length_in, width_in: d.width_in, height_in: d.height_in, description: d.description, value_usd: d.value_usd },
      };
    }
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      werr.hidden = true; results.hidden = true; picked = null; addBtn.disabled = true; rateBtn.disabled = true;
      payload = read();
      try {
        const res = await fetch('/api/rates', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ origin: payload.origin, destination: payload.destination ?? STORE, parcel: payload.parcel }) });
        const j = await res.json();
        if (!res.ok) throw new Error(j.error);
        $('mockNote').hidden = !j.demo;
        ratesEl.innerHTML = '';
        for (const r of j.rates) {
          const el = document.createElement('label');
          el.className = 'rate card';
          el.innerHTML = `<input type="radio" name="rate"><span class="carrier"></span><span class="service"></span><span class="days"></span><span class="price"></span>`;
          el.querySelector('.carrier')!.textContent = r.carrier; el.querySelector('.service')!.textContent = r.service;
          el.querySelector('.days')!.textContent = `${r.min_days ?? '?'}–${r.max_days ?? '?'} days`; el.querySelector('.price')!.textContent = `$${r.total_charge.toFixed(2)}`;
          el.querySelector('input')!.addEventListener('change', () => { picked = r.id; addBtn.disabled = false; });
          ratesEl.appendChild(el);
        }
        if (!j.rates.length) throw new Error('No rates came back for that address and parcel.');
        results.hidden = false; results.scrollIntoView({ behavior: 'smooth' });
      } catch (e: any) { werr.textContent = e.message; werr.hidden = false; }
      rateBtn.disabled = false;
    });
    addBtn.addEventListener('click', async () => {
      if (!picked || !payload) return;
      addBtn.disabled = true; werr.hidden = true;
      try {
        const j = await api('/api/queue', { action: 'create', ...payload.customer, kind: payload.kind, return_to: payload.return_to, origin: payload.origin, destination: payload.destination, parcel: payload.parcel, rate_id: picked, staff: staff() });
        msg.className = ''; msg.textContent = payload.kind === 'return'
          ? `${j.id} added to the queue at $${j.price.toFixed(2)}. Ring it up on the POS, press Buy label, then Email label to the sender.`
          : `${j.id} added to the queue at $${j.price.toFixed(2)}. Ring it up on the POS, then press Buy label.`;
        f.reset(); returnMode(); results.hidden = true; payload = null; picked = null;
        await load(); window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch (e: any) { werr.textContent = e.message; werr.hidden = false; addBtn.disabled = false; }
    });
    $('clear').addEventListener('click', () => { f.reset(); returnMode(); results.hidden = true; werr.hidden = true; });

    // ?from=GP-CODE: "ship here again" from the customer page. Fills the form once the PIN is entered.
    const from = new URLSearchParams(location.search).get('from');
    async function prefill() {
      if (!from || !pin()) return;
      try {
        const o = await api('/api/queue', { action: 'order', order: from });
        const set = (n: string, v: unknown) => { const el = f.elements.namedItem(n) as HTMLInputElement | null; if (el && v != null && v !== '') el.value = String(v); };
        set('name', o.name); set('email', o.email); set('phone', o.phone); (f.elements.namedItem('sms') as HTMLInputElement).checked = !!o.sms;
        isReturn.checked = o.kind === 'return';
        if (o.origin) for (const k of ['contact_name', 'line_1', 'line_2', 'city', 'state', 'postal_code']) set(`from_${k}`, o.origin[k]);
        returnMode();
        for (const k of ['contact_name', 'line_1', 'line_2', 'city', 'state', 'postal_code', 'country_alpha2']) set(k, o.destination[k]);
        for (const k of ['weight_lb', 'length_in', 'width_in', 'height_in', 'description', 'value_usd']) set(k, o.parcel[k]);
        msg.className = ''; msg.textContent = `Walk-up form filled from ${from}. Check the weight and size, then Get rates.`;
        f.scrollIntoView({ behavior: 'smooth' });
      } catch (e: any) { msg.className = 'err'; msg.textContent = e.message; }
    }
    $('pin').addEventListener('change', prefill);
    if (from) { msg.className = ''; msg.textContent = `Enter the PIN to fill the walk-up form from ${from}.`; }
  </script>
</Base>
