---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { store } from '../../data/store';

// Staff page: the quote queue. Every quote a customer reserved online and every walk-up staff typed
// in, oldest first, with buy, print, void and cancel on the same screen. Walk-ups are quoted with the
// same rating engine the website uses, so the counter and the site never disagree on a price.
---
<Base title="Counter · Queue">
  <section class="hero">
    <h1 data-i18n="st.q.h1">Queue</h1>
    <p class="staff-nav"><span data-i18n="st.staff">Staff:</span> <a href="/counter/queue" data-i18n="st.nav.queue">Queue</a> · <a href="/counter/batch" data-i18n="st.nav.batch">Batch</a> · <a href="/counter/pickups" data-i18n="st.nav.pickups">Pickups</a> · <a href="/counter/customers" data-i18n="st.nav.customers">Customers</a> · <a href="/counter/accounts" data-i18n="st.nav.accounts">Accounts</a> · <a href="/counter/dropoff" data-i18n="st.nav.dropoffs">Drop-offs</a> · <a href="/counter/mailboxes" data-i18n="st.nav.mailboxes">Mailboxes</a> · <a href="/counter/exceptions" data-i18n="st.nav.exceptions">Exceptions</a> · <a href="/counter/claims" data-i18n="st.nav.claims">Claims</a> · <a href="/counter/reports" data-i18n="st.nav.reports">Reports</a> · <a href="/counter/close" data-i18n="st.nav.close">End of day</a> · <a href="/counter/invoices" data-i18n="st.nav.invoices">Invoices</a> · <a href="/counter/rules" data-i18n="st.nav.prices">Prices</a> · <a href="/counter/staff" data-i18n="st.nav.staff">Staff</a> · <a href="/counter/export" data-i18n="st.nav.export">Export</a></p>
    <p class="lead" data-i18n="st.q.lead">Who is waiting on a label. Online reservations show up here by themselves; type a walk-up in below. Oldest first.</p>
  </section>

  <div class="card">
    <p class="btnrow">
      <label><span data-i18n="st.pin">Staff PIN</span> <input id="pin" type="password" inputmode="numeric" autocomplete="off" /></label>
      <label><span data-i18n="st.yourname">Your name or initials</span> <input id="staff" maxlength="20" /></label>
      <button class="btn" id="load" data-i18n="st.q.showqueue">Show queue</button>
    </p>
    <p id="msg" role="alert"></p>
    <p id="offline" class="err hidden"></p>
    <p id="printer" class="muted"></p>
    <div id="failedwrap" class="hidden"><strong data-i18n="st.pr.failed">Print jobs the printer could not do</strong><table class="list" id="failed"><tbody></tbody></table></div>
    <table class="list hidden" id="table">
      <thead><tr><th data-i18n="st.q.th.waiting">Waiting</th><th data-i18n="st.q.th.code">Code</th><th data-i18n="st.q.th.customer">Customer</th><th data-i18n="st.q.th.to">To</th><th data-i18n="st.q.th.service">Service</th><th data-i18n="st.q.th.status">Status</th><th data-i18n="st.q.th.do">Do</th></tr></thead>
      <tbody></tbody>
    </table>
    <p id="empty" class="muted hidden" data-i18n="st.q.nobody">Nobody is waiting.</p>
    <details id="donewrap" class="hidden"><summary data-i18n="st.q.finished">Finished in the last day</summary>
      <table class="list" id="done"><thead><tr><th data-i18n="st.q.th.when">When</th><th data-i18n="st.q.th.code">Code</th><th data-i18n="st.q.th.customer">Customer</th><th data-i18n="st.q.th.service">Service</th><th data-i18n="st.q.th.status">Status</th><th></th></tr></thead><tbody></tbody></table>
    </details>
  </div>

  <script type="application/json" id="storeAddr" set:html={JSON.stringify(store.origin)} />
  <h2 data-i18n="st.q.walkup.h2">Walk-up</h2>
  <p class="muted" data-i18n="st.q.walkup.lead">Quote a customer at the counter. Pick a rate and add it to the queue; ring it up on the POS, then press Buy label in the queue. The customer gets the same price the website would show.</p>
  <form id="walkup" class="ship-form" autocomplete="off">
    <fieldset>
      <legend data-i18n="st.q.legend.who">Who is shipping</legend>
      <div class="row">
        <label><span data-i18n="st.q.name">Customer name</span> <input name="name" maxlength="60" /></label>
        <label><span data-i18n="st.q.mobile">Mobile (optional)</span> <input name="phone" inputmode="tel" maxlength="20" /></label>
        <label><span data-i18n="st.q.email">Email (optional)</span> <input name="email" type="email" /></label>
      </div>
      <label class="check"><input name="sms" type="checkbox" /> <span data-i18n="st.q.sms">Text them when it ships and when it is delivered</span></label>
      <label><span data-i18n="st.b.billto">Bill to a business account (discount applied, no POS payment)</span>
        <select name="account_id" id="accountSel"><option value="" data-i18n="st.b.noaccount">No, pay at the counter</option></select>
      </label>
    </fieldset>
    <fieldset>
      <legend data-i18n="st.q.return.legend">Return label?</legend>
      <label class="check"><input name="is_return" type="checkbox" id="isReturn" /> <span data-i18n="st.q.return.check">This is a return: the package is somewhere else and travels to us or to a local business. We pay here, then email the label to the sender.</span></label>
      <div id="returnFields" class="hidden">
        <p class="muted" data-i18n="st.q.return.lead">Where the package is now (the sender). US addresses only; international returns need customs forms, so quote those on the Ship page.</p>
        <label><span data-i18n="st.q.sender">Sender name</span> <input name="from_contact_name" /></label>
        <label><span data-i18n="ship.street">Street address</span> <input name="from_line_1" maxlength="35" /></label>
        <label><span data-i18n="ship.apt">Apt, suite (optional)</span> <input name="from_line_2" maxlength="35" /></label>
        <div class="row">
          <label><span data-i18n="ship.city">City</span> <input name="from_city" /></label>
          <label><span data-i18n="ship.state">State</span> <input name="from_state" placeholder="TX" maxlength="2" /></label>
          <label><span data-i18n="ship.zip">ZIP</span> <input name="from_postal_code" /></label>
        </div>
        <label><span data-i18n="st.q.return.to">Comes back to</span>
          <select name="return_to" id="returnTo"><option value="store" data-i18n="st.q.return.us">Us, the store (the business picks it up here)</option><option value="other" data-i18n="st.q.return.other">Another address, typed below</option></select>
        </label>
      </div>
    </fieldset>
    <fieldset id="destFields">
      <legend id="destLegend" data-i18n="ship.where">Where is it going</legend>
      <label><span data-i18n="ship.recipient">Recipient name</span> <input name="contact_name" required /></label>
      <label><span data-i18n="ship.street">Street address</span> <input name="line_1" required maxlength="35" /></label>
      <label><span data-i18n="ship.apt">Apt, suite (optional)</span> <input name="line_2" maxlength="35" /></label>
      <div class="row">
        <label><span data-i18n="ship.city">City</span> <input name="city" required /></label>
        <label><span data-i18n="ship.state">State</span> <input name="state" placeholder="LA" maxlength="2" /></label>
        <label><span data-i18n="ship.zip">ZIP / postal code</span> <input name="postal_code" required /></label>
        <label><span data-i18n="ship.country">Country</span> <input name="country_alpha2" value="US" maxlength="2" required /></label>
      </div>
    </fieldset>
    <fieldset>
      <legend data-i18n="ship.what">What is it</legend>
      <div class="row">
        <label><span data-i18n="ship.weight">Weight (lb)</span> <input name="weight_lb" type="number" step="0.1" min="0.1" max="150" required /></label>
        <label><span data-i18n="ship.length">Length (in)</span> <input name="length_in" type="number" min="1" required /></label>
        <label><span data-i18n="ship.width">Width (in)</span> <input name="width_in" type="number" min="1" required /></label>
        <label><span data-i18n="ship.height">Height (in)</span> <input name="height_in" type="number" min="1" required /></label>
      </div>
      <div class="row">
        <label><span data-i18n="ship.desc">What's inside</span> <input name="description" maxlength="80" placeholder="Clothing" /></label>
        <label><span data-i18n="ship.value">Value in USD</span> <input name="value_usd" type="number" min="1" placeholder="25" /></label>
      </div>
    </fieldset>
    <p class="btnrow"><button class="btn" type="submit" id="rateBtn" data-i18n="ship.getrates">Get rates</button> <button class="btn kraft" type="button" id="clear" data-i18n="st.q.clear">Clear form</button></p>
    <p id="werr" class="err" hidden></p>
  </form>
  <section id="results" hidden>
    <p id="addrNote" hidden></p>
    <p id="packNote" class="muted" hidden></p>
    <p id="mockNote" class="muted" hidden data-i18n="ship.mock">Demo rates: live carrier rates appear once the store's carrier accounts are connected.</p>
    <div id="rates" class="rates"></div>
    <fieldset id="extras" class="hidden">
      <legend data-i18n="st.a.legend">Add-ons</legend>
      <label class="check" id="wInsRow"><input id="wInsure" type="checkbox" /> <span data-i18n="st.a.insure">Insurance for the declared value</span> <span id="wInsFee" class="muted"></span></label>
      <p id="wInsCovered" class="muted hidden"></p>
      <div id="addonList" class="row"></div>
      <p class="price"><span data-i18n="st.a.total">Total to ring up on the POS</span>: <strong id="wTotal"></strong></p>
    </fieldset>
    <p class="btnrow"><button class="btn" id="addBtn" disabled data-i18n="st.q.add">Add to queue</button></p>
  </section>

  <script>
    import { t, tf } from '../../i18n';
    const $ = (id: string) => document.getElementById(id)!;
    const pin = () => ($('pin') as HTMLInputElement).value;
    const staff = () => ($('staff') as HTMLInputElement).value;
    const msg = $('msg');
    const table = $('table'), body = table.querySelector('tbody')!, empty = $('empty');
    const doneWrap = $('donewrap'), doneBody = $('done').querySelector('tbody')!;
    const STATUS = (k: string) => t(`st.status.${k}`);
    const fmt = (iso: string) => new Date(iso).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    const ago = (iso: string) => { const m = Math.max(0, Math.round((Date.now() - new Date(iso).getTime()) / 60000)); return m < 60 ? `${m} ${t('st.min')}` : m < 1440 ? `${Math.floor(m / 60)} ${t('st.h')} ${m % 60} ${t('st.min')}` : `${Math.floor(m / 1440)} ${t('st.d')}`; };

    async function api(path: string, extra: Record<string, unknown> = {}) {
      const res = await fetch(path, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: pin(), ...extra }) });
      const j = await res.json();
      if (!res.ok) throw new Error(j.error);
      return j;
    }
    const cell = (tr: HTMLTableRowElement, text: string, cls?: string) => { const td = document.createElement('td'); td.textContent = text; if (cls) td.className = cls; tr.appendChild(td); return td; };
    const button = (label: string, cls: string, onClick: () => Promise<void>) => {
      const b = document.createElement('button'); b.className = `btn small ${cls}`.trim(); b.textContent = label;
      b.addEventListener('click', async () => { b.disabled = true; msg.className = ''; msg.textContent = ''; try { await onClick(); } catch (e: any) { msg.className = 'err'; msg.textContent = e.message; } b.disabled = false; });
      return b;
    };

    const accountNames = new Set<string>();
    async function loadAccounts() {
      try {
        const { accounts } = await api('/api/accounts', { action: 'list' });
        const sel = $('accountSel') as HTMLSelectElement; while (sel.options.length > 1) sel.remove(1); accountNames.clear();
        for (const a of accounts) { const o = document.createElement('option'); o.value = String(a.id); o.textContent = `${a.business_name} (${a.discount_percent}% off)`; sel.appendChild(o); accountNames.add(a.business_name); }
      } catch {}
    }
    async function printerStatus() {
      try {
        const s = await api('/api/print', { action: 'status' });
        const p = $('printer');
        if (!s.key_set) p.textContent = t('st.pr.nokey');
        else if (!s.online) p.textContent = t('st.pr.offline');
        else { const a = s.agent; const since = a.last_job_at ? ago(a.last_job_at) : null; p.textContent = tf('st.pr.online', { printer: a.zebra ?? '?', last: since ? tf('st.pr.lastjob', { ago: since }) : t('st.pr.nojob') }) + (a.last_error ? ` · ${t('st.pr.lasterror')} ${a.last_error}` : ''); }
        const fb = $('failed').querySelector('tbody')!; fb.innerHTML = '';
        for (const f of s.failed) {
          const tr = document.createElement('tr');
          cell(tr, `#${f.job_id} ${f.kind}${f.shipment_id ? ` ${f.shipment_id}` : ''}`); cell(tr, f.error ?? ''); cell(tr, ago(f.at));
          const td = document.createElement('td'); td.appendChild(button(t('st.pr.retry'), 'kraft', async () => { await api('/api/print', { action: 'retry', id: f.job_id }); msg.className = ''; msg.textContent = t('st.pr.retried'); await printerStatus(); })); tr.appendChild(td);
          fb.appendChild(tr);
        }
        $('failedwrap').classList.toggle('hidden', !s.failed.length);
      } catch {}
    }
    async function load() {
      if (!pin()) { msg.className = 'err'; msg.textContent = t('st.pinfirst'); return; }
      try {
        if (!accountNames.size) await loadAccounts();
        printerStatus();
        let open: any[], done: any[], user: any;
        try {
          ({ open, done, user } = await api('/api/queue', { action: 'list' }));
          try { localStorage.setItem('queue_cache', JSON.stringify({ at: Date.now(), open, done })); } catch {}
          $('offline').classList.add('hidden');
        } catch (e: any) {
          const cached = (() => { try { return JSON.parse(localStorage.getItem('queue_cache') || 'null'); } catch { return null; } })();
          if (!(e instanceof TypeError) || !cached) throw e;
          ({ open, done } = cached); user = null;
          $('offline').textContent = tf('st.off.queue', { when: new Date(cached.at).toLocaleTimeString() }); $('offline').classList.remove('hidden');
        }
        if (user && !staff()) ($('staff') as HTMLInputElement).placeholder = user.name;
        body.innerHTML = '';
        for (const q of open) {
          const tr = document.createElement('tr');
          tr.className = q.status;
          const wait = cell(tr, ago(q.created_at));
          if (Date.now() - new Date(q.created_at).getTime() > 20 * 60000 && q.status !== 'awaiting_payment') wait.style.color = '#b91c1c';
          const code = cell(tr, ''); code.innerHTML = `<a href="/counter/${q.id}"></a>`; code.querySelector('a')!.textContent = q.id;
          cell(tr, [q.customer_name, q.phone, q.source === 'counter' ? `${t('st.walkup')}${q.staff ? `, ${q.staff}` : ''}` : t('st.online')].filter(Boolean).join(' · '));
          const dest = cell(tr, q.destination + (q.international ? ` · ${t('st.international')}` : ''));
          if (q.destination.startsWith('Return from')) dest.style.fontWeight = '700';
          cell(tr, `${q.carrier} ${q.service} · $${Number(q.price).toFixed(2)}`);
          cell(tr, STATUS(q.status));
          const act = document.createElement('td'); act.className = 'btnrow';
          if (q.status === 'reserved' && q.customer_name && q.customer_name.includes(': ') && accountNames.has(q.customer_name.split(': ')[0])) act.appendChild(button(t('st.b.bill'), '', async () => { await api('/api/counter', { order: q.id, action: 'bill' }); msg.textContent = tf('st.q.labelbought', { id: q.id }); await load(); }));
          else if (q.status === 'reserved') act.appendChild(button(t('st.buy'), '', async () => { await api('/api/counter', { order: q.id, action: 'paid' }); msg.textContent = tf('st.q.labelbought', { id: q.id }); await load(); }));
          if (q.status === 'labeled') {
            act.appendChild(button(t('st.print'), '', async () => { const j = await api('/api/print', { order: q.id, action: 'queue', printer: 'counter' }); msg.textContent = j.agent ? tf('st.q.sentprinter', { id: q.id }) : tf('st.q.noagent', { id: q.id }); }));
            act.appendChild(button(t('st.printed'), 'kraft', async () => { await api('/api/counter', { order: q.id, action: 'printed' }); await load(); }));
            act.appendChild(button(t('st.emaillabel'), 'kraft', async () => {
              const email = window.prompt(tf('st.q.emailprompt', { id: q.id }), q.email ?? '');
              if (email === null) return;
              const j = await api('/api/counter', { order: q.id, action: 'email', email });
              msg.textContent = j.mock ? tf('st.q.emaillogged', { id: q.id, email: j.email }) : tf('st.q.emailed', { id: q.id, email: j.email });
            }));
            act.appendChild(button(t('st.void'), 'kraft', async () => { const reason = window.prompt(tf('st.q.confirm.void', { id: q.id }) + '\n' + t('st.n.whyvoid')); if (!reason || !reason.trim()) return; await api('/api/counter', { order: q.id, action: 'void', reason }); await load(); }));
          }
          if (q.status === 'reserved' || q.status === 'awaiting_payment') act.appendChild(button(t('st.cancel'), 'kraft', async () => { const reason = window.prompt(tf('st.q.confirm.cancel', { id: q.id }) + '\n' + t('st.n.whycancel')); if (!reason || !reason.trim()) return; await api('/api/counter', { order: q.id, action: 'cancel', reason }); await load(); }));
          tr.appendChild(act);
          body.appendChild(tr);
        }
        table.classList.toggle('hidden', !open.length);
        empty.classList.toggle('hidden', !!open.length);
        doneBody.innerHTML = '';
        for (const q of done) {
          const tr = document.createElement('tr');
          cell(tr, fmt(q.updated_at)); const code = cell(tr, ''); code.innerHTML = `<a href="/counter/${q.id}"></a>`; code.querySelector('a')!.textContent = q.id;
          cell(tr, q.customer_name ?? ''); cell(tr, `${q.carrier} ${q.service} · $${Number(q.price).toFixed(2)}`); cell(tr, STATUS(q.status));
          const td = cell(tr, ''); if (q.status === 'printed') { td.innerHTML = `<a href="/track?q=${q.id}"></a>`; td.querySelector('a')!.textContent = t('st.track'); }
          doneBody.appendChild(tr);
        }
        doneWrap.classList.toggle('hidden', !done.length);
      } catch (e: any) { msg.className = 'err'; msg.textContent = e.message; }
    }
    $('load').addEventListener('click', load);
    $('pin').addEventListener('change', load);
    document.addEventListener('langchange', () => { if (pin()) load(); });
    setInterval(() => { if (pin() && document.visibilityState === 'visible') load(); }, 30000);

    // ---- walk-up quote ----
    const f = $('walkup') as HTMLFormElement;
    const werr = $('werr'), results = $('results'), ratesEl = $('rates'), addBtn = $('addBtn') as HTMLButtonElement, rateBtn = $('rateBtn') as HTMLButtonElement;
    let payload: any = null, picked: string | null = null, pickedPrice = 0, extras: any = null;
    const STORE = JSON.parse(document.getElementById('storeAddr')!.textContent!);
    const wInsure = $('wInsure') as HTMLInputElement, addonList = $('addonList');
    function pickedAddons() { return [...addonList.querySelectorAll<HTMLInputElement>('input[data-code]')].map((i) => ({ code: i.dataset.code!, qty: Number(i.value) || 0 })).filter((a) => a.qty > 0); }
    function wTotal() {
      const fee = wInsure.checked && extras && !extras.insurance.covered ? extras.insurance.fee : 0;
      const add = pickedAddons().reduce((a, p) => a + p.qty * (extras.addons.find((x: any) => x.code === p.code)?.price ?? 0), 0);
      $('wTotal').textContent = `$${(pickedPrice + fee + add).toFixed(2)}`;
    }
    wInsure.addEventListener('change', wTotal);
    addonList.addEventListener('input', wTotal);
    let addrForce = false;
    function renderAddress(ad: any) {
      const an = $('addrNote'); an.innerHTML = ''; an.hidden = true; addrForce = false;
      if (!ad || (!ad.errors.length && !ad.warnings.length)) return;
      an.className = ad.errors.length ? 'err' : 'card';
      an.textContent = [...ad.errors, ...ad.warnings].join(' ');
      if (ad.errors.length) {
        const b = document.createElement('button'); b.type = 'button'; b.className = 'btn small kraft'; b.style.marginLeft = '8px'; b.textContent = t('st.ad.anyway');
        b.addEventListener('click', () => { addrForce = true; an.className = 'card'; b.remove(); an.append(' ' + t('st.ad.forced')); });
        an.appendChild(b);
      }
      an.hidden = false;
    }
    function renderPacking(pk: any) {
      const pn = $('packNote'); pn.innerHTML = ''; pn.hidden = true;
      if (!pk) return;
      const bits: string[] = [];
      const top = pk.billable.reduce((a: any, b: any) => (b.lb > a.lb ? b : a));
      bits.push(tf('st.pk.billable', { actual: pk.actual_lb, usps: pk.billable.find((b: any) => b.carrier === 'USPS').lb, ups: pk.billable.find((b: any) => b.carrier === 'UPS').lb }));
      if (pk.dim_applies) bits.push(tf('st.pk.dim', { carrier: top.carrier }));
      if (pk.oversize) bits.push(t('st.pk.oversize'));
      if (pk.fits) bits.push(tf('st.pk.fits', { box: pk.fits.name, price: pk.fits.price.toFixed(2) }));
      else bits.push(t('st.pk.nofit'));
      pn.textContent = bits.join(' ');
      const use = (box: any, label: string) => {
        const b = document.createElement('button'); b.type = 'button'; b.className = 'btn small kraft'; b.textContent = label; b.style.marginLeft = '8px';
        b.addEventListener('click', () => {
          const inp = addonList.querySelector<HTMLInputElement>(`input[data-code="${box.code}"]`); if (inp) { inp.value = '1'; wTotal(); }
          const setN = (n: string, v: number) => { (f.elements.namedItem(n) as HTMLInputElement).value = String(v); };
          setN('length_in', box.dims[0]); setN('width_in', box.dims[1]); setN('height_in', box.dims[2]);
          f.requestSubmit();
        });
        pn.appendChild(b);
      };
      if (pk.better) { const s = document.createElement('span'); s.textContent = ' ' + tf('st.pk.better', { box: pk.better.box.name, saves: pk.better.saves_lb }); pn.appendChild(s); use(pk.better.box, t('st.pk.usebox')); }
      else if (pk.fits && !(pk.fits.dims[0] === Number((f.elements.namedItem('length_in') as HTMLInputElement).value) && pk.fits.dims[1] === Number((f.elements.namedItem('width_in') as HTMLInputElement).value) && pk.fits.dims[2] === Number((f.elements.namedItem('height_in') as HTMLInputElement).value))) use(pk.fits, t('st.pk.usebox'));
      pn.hidden = false;
    }
    function renderExtras(ex: any) {
      extras = ex;
      if (ex.insurance.covered) { $('wInsRow').classList.add('hidden'); wInsure.checked = false; $('wInsCovered').classList.remove('hidden'); $('wInsCovered').textContent = t('ship.inscovered').replace('{n}', String(ex.insurance.included_usd)); }
      else { $('wInsRow').classList.remove('hidden'); $('wInsCovered').classList.add('hidden'); $('wInsFee').textContent = t('ship.insfee').replace('{fee}', ex.insurance.fee.toFixed(2)).replace('{value}', String(ex.insurance.declared_usd)); }
      addonList.innerHTML = '';
      for (const a of ex.addons) {
        const l = document.createElement('label');
        l.innerHTML = `<span></span> <input type="number" min="0" max="20" value="0" inputmode="numeric" />`;
        l.querySelector('span')!.textContent = `${a.name} · $${a.price.toFixed(2)}`;
        const inp = l.querySelector('input')!; inp.dataset.code = a.code;
        addonList.appendChild(l);
      }
      $('extras').classList.remove('hidden');
    }
    const isReturn = $('isReturn') as HTMLInputElement, returnTo = $('returnTo') as HTMLSelectElement, destFields = $('destFields');
    const destRequired = f.querySelectorAll<HTMLInputElement>('#destFields [required]');
    function returnMode() {
      const r = isReturn.checked;
      $('returnFields').classList.toggle('hidden', !r);
      const toStore = r && returnTo.value === 'store';
      destFields.classList.toggle('hidden', toStore);
      destRequired.forEach((el) => { el.required = !toStore; });
      $('destLegend').textContent = r ? t('st.q.dest.back') : t('ship.where');
      f.querySelectorAll<HTMLInputElement>('#returnFields input').forEach((el) => { el.required = r && el.name !== 'from_line_2'; });
    }
    isReturn.addEventListener('change', returnMode); returnTo.addEventListener('change', returnMode);
    function read() {
      const d = Object.fromEntries(new FormData(f).entries()) as Record<string, string>;
      const r = isReturn.checked;
      return {
        kind: r ? 'return' : 'ship',
        return_to: r ? returnTo.value : undefined,
        origin: r ? { contact_name: d.from_contact_name, line_1: d.from_line_1, line_2: d.from_line_2, city: d.from_city, state: d.from_state, postal_code: d.from_postal_code, country_alpha2: 'US' } : undefined,
        customer: { name: d.name, phone: d.phone, email: d.email, sms: d.sms === 'on', account_id: d.account_id || undefined },
        destination: r && returnTo.value === 'store' ? undefined : { contact_name: d.contact_name, line_1: d.line_1, line_2: d.line_2, city: d.city, state: d.state, postal_code: d.postal_code, country_alpha2: d.country_alpha2.toUpperCase() },
        parcel: { weight_lb: d.weight_lb, length_in: d.length_in, width_in: d.width_in, height_in: d.height_in, description: d.description, value_usd: d.value_usd },
      };
    }
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      werr.hidden = true; results.hidden = true; picked = null; addBtn.disabled = true; rateBtn.disabled = true;
      payload = read();
      try {
        const res = await fetch('/api/rates', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ origin: payload.origin, destination: payload.destination ?? STORE, parcel: payload.parcel }) });
        const j = await res.json();
        if (!res.ok) throw new Error(j.error);
        $('mockNote').hidden = !j.demo;
        ratesEl.innerHTML = '';
        for (const r of j.rates) {
          const el = document.createElement('label');
          el.className = 'rate card';
          el.innerHTML = `<input type="radio" name="rate"><span class="carrier"></span><span class="service"></span><span class="days"></span><span class="price"></span>`;
          el.querySelector('.carrier')!.textContent = r.carrier; el.querySelector('.service')!.textContent = r.service;
          el.querySelector('.days')!.textContent = `${r.min_days ?? '?'}–${r.max_days ?? '?'} ${t('ship.days')}`; el.querySelector('.price')!.textContent = `$${r.total_charge.toFixed(2)}`;
          el.querySelector('input')!.addEventListener('change', () => { picked = r.id; pickedPrice = r.total_charge; addBtn.disabled = false; wTotal(); });
          ratesEl.appendChild(el);
        }
        if (!j.rates.length) throw new Error(t('st.q.norates'));
        renderExtras(j.extras);
        renderPacking(j.packing);
        renderAddress(j.address);
        results.hidden = false; results.scrollIntoView({ behavior: 'smooth' });
      } catch (e: any) { werr.textContent = e.message; werr.hidden = false; }
      rateBtn.disabled = false;
    });
    addBtn.addEventListener('click', async () => {
      if (!picked || !payload) return;
      addBtn.disabled = true; werr.hidden = true;
      try {
        const j = await api('/api/queue', { action: 'create', ...payload.customer, kind: payload.kind, return_to: payload.return_to, origin: payload.origin, destination: payload.destination, parcel: payload.parcel, rate_id: picked, staff: staff(), insure: wInsure.checked, addons: pickedAddons(), force: addrForce });
        msg.className = ''; msg.textContent = payload.customer.account_id ? tf('st.b.added', { id: j.id, price: j.price.toFixed(2) }) : tf(payload.kind === 'return' ? 'st.q.added.return' : 'st.q.added', { id: j.id, price: j.price.toFixed(2) });
        f.reset(); returnMode(); results.hidden = true; $('extras').classList.add('hidden'); payload = null; picked = null;
        await load(); window.scrollTo({ top: 0, behavior: 'smooth' });
      } catch (e: any) { werr.textContent = e.message; werr.hidden = false; addBtn.disabled = false; }
    });
    $('clear').addEventListener('click', () => { f.reset(); returnMode(); results.hidden = true; werr.hidden = true; });

    // ?from=GP-CODE: "ship here again" from the customer page. Fills the form once the PIN is entered.
    const from = new URLSearchParams(location.search).get('from');
    async function prefill() {
      if (!from || !pin()) return;
      try {
        const o = await api('/api/queue', { action: 'order', order: from });
        const set = (n: string, v: unknown) => { const el = f.elements.namedItem(n) as HTMLInputElement | null; if (el && v != null && v !== '') el.value = String(v); };
        set('name', o.name); set('email', o.email); set('phone', o.phone); (f.elements.namedItem('sms') as HTMLInputElement).checked = !!o.sms;
        isReturn.checked = o.kind === 'return';
        if (o.account_id) ($('accountSel') as HTMLSelectElement).value = String(o.account_id);
        if (o.origin) for (const k of ['contact_name', 'line_1', 'line_2', 'city', 'state', 'postal_code']) set(`from_${k}`, o.origin[k]);
        returnMode();
        for (const k of ['contact_name', 'line_1', 'line_2', 'city', 'state', 'postal_code', 'country_alpha2']) set(k, o.destination[k]);
        for (const k of ['weight_lb', 'length_in', 'width_in', 'height_in', 'description', 'value_usd']) set(k, o.parcel[k]);
        msg.className = ''; msg.textContent = tf('st.q.prefilled', { id: from });
        f.scrollIntoView({ behavior: 'smooth' });
      } catch (e: any) { msg.className = 'err'; msg.textContent = e.message; }
    }
    $('pin').addEventListener('change', prefill);
    if (from) { msg.className = ''; msg.textContent = tf('st.q.enterpin.prefill', { id: from }); }
  </script>
</Base>
