---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { EXPORT_TABLES } from '../../shipping/store';

// Full data export (to-do T10). Owner only. Every table with its row count, a CSV per table, or one
// JSON file with everything including the online orders. Nothing here is ever locked in.
const tables = EXPORT_TABLES;
---
<Base title="Counter · Export">
  <section class="hero">
    <h1 data-i18n="st.xp.h1">Export</h1>
    <p class="staff-nav"><span data-i18n="st.staff">Staff:</span> <a href="/counter/queue" data-i18n="st.nav.queue">Queue</a> · <a href="/counter/batch" data-i18n="st.nav.batch">Batch</a> · <a href="/counter/pickups" data-i18n="st.nav.pickups">Pickups</a> · <a href="/counter/customers" data-i18n="st.nav.customers">Customers</a> · <a href="/counter/accounts" data-i18n="st.nav.accounts">Accounts</a> · <a href="/counter/dropoff" data-i18n="st.nav.dropoffs">Drop-offs</a> · <a href="/counter/mailboxes" data-i18n="st.nav.mailboxes">Mailboxes</a> · <a href="/counter/exceptions" data-i18n="st.nav.exceptions">Exceptions</a> · <a href="/counter/claims" data-i18n="st.nav.claims">Claims</a> · <a href="/counter/reports" data-i18n="st.nav.reports">Reports</a> · <a href="/counter/close" data-i18n="st.nav.close">End of day</a> · <a href="/counter/invoices" data-i18n="st.nav.invoices">Invoices</a> · <a href="/counter/rules" data-i18n="st.nav.prices">Prices</a> · <a href="/counter/staff" data-i18n="st.nav.staff">Staff</a> · <a href="/counter/export" data-i18n="st.nav.export">Export</a></p>
    <p class="lead" data-i18n="st.xp.lead">Everything PeterShip keeps, in open formats, whenever you want it. A CSV opens in Excel or Numbers; the JSON file is every table at once plus the online orders, for an accountant, a lawyer, a buyer or the next system. PIN hashes, API key hashes and webhook secrets are left out. Owner PIN only; every download is written to the audit log.</p>
  </section>

  <form id="f" class="card">
    <div class="row">
      <label><span data-i18n="st.pin">Owner PIN</span> <input id="pin" type="password" inputmode="numeric" autocomplete="off" /></label>
    </div>
    <p class="btnrow">
      <button class="btn" type="submit" data-i18n="st.xp.show">Show what is there</button>
      <button class="btn kraft" type="button" id="all" data-i18n="st.xp.all">Download everything (JSON)</button>
    </p>
    <p id="msg" role="alert"></p>
  </form>

  <div id="out" class="card hidden">
    <table class="list"><thead><tr><th data-i18n="st.xp.th.table">Table</th><th data-i18n="st.xp.th.what">What is in it</th><th data-i18n="st.xp.th.rows">Rows</th><th></th></tr></thead>
      <tbody>{tables.map((t) => <tr data-table={t}><td><code>{t}</code></td><td data-i18n={`st.xp.t.${t}`}></td><td class="n"></td><td><button class="btn small kraft" type="button" data-csv={t} data-i18n="st.xp.csv">CSV</button></td></tr>)}</tbody>
    </table>
    <p class="muted" data-i18n="st.xp.note">Orders placed on the website live in a separate key-value store for 90 days and are in the JSON file under "orders"; the quotes table keeps the queue's view of them for longer.</p>
  </div>

  <script>
    import { t } from '../../i18n';
    const msg = document.getElementById('msg')!;
    const pin = () => (document.getElementById('pin') as HTMLInputElement).value;
    const call = (body: object) => fetch('/api/export', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: pin(), ...body }) });
    const download = async (res: Response) => {
      if (!res.ok) throw new Error((await res.json()).error ?? res.statusText);
      const name = /filename="([^"]+)"/.exec(res.headers.get('Content-Disposition') ?? '')?.[1] ?? 'export';
      const a = document.createElement('a'); a.href = URL.createObjectURL(await res.blob()); a.download = name; a.click(); URL.revokeObjectURL(a.href);
    };
    document.getElementById('f')!.addEventListener('submit', async (e) => {
      e.preventDefault(); msg.textContent = '';
      if (!pin()) { msg.className = 'err'; msg.textContent = t('st.pinfirst'); return; }
      try {
        const res = await call({ action: 'counts' }); const j = await res.json();
        if (!res.ok) throw new Error(j.error);
        document.getElementById('out')!.classList.remove('hidden');
        for (const [name, n] of Object.entries(j.tables)) { const td = document.querySelector(`tr[data-table="${name}"] td.n`); if (td) td.textContent = String(n); }
      } catch (err: any) { msg.className = 'err'; msg.textContent = err.message; }
    });
    document.getElementById('all')!.addEventListener('click', async () => {
      if (!pin()) { msg.className = 'err'; msg.textContent = t('st.pinfirst'); return; }
      try { await download(await call({ action: 'json' })); msg.className = 'ok'; msg.textContent = t('st.xp.done'); } catch (err: any) { msg.className = 'err'; msg.textContent = err.message; }
    });
    document.querySelectorAll<HTMLButtonElement>('button[data-csv]').forEach((b) => b.addEventListener('click', async () => {
      try { await download(await call({ action: 'csv', table: b.dataset.csv })); msg.className = 'ok'; msg.textContent = t('st.xp.done'); } catch (err: any) { msg.className = 'err'; msg.textContent = err.message; }
    }));
  </script>
</Base>
