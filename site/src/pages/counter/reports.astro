---
export const prerender = false;
import Base from '../../layouts/Base.astro';

// Staff reports: daily shipments and margin, by carrier and service, busiest hours and days,
// returning customers, drop-offs, and a CSV of every shipment for reconciling the carrier invoice.
// Everything is computed from PeterShip's own records, so it covers only labels bought through the site.
const today = new Date().toISOString().slice(0, 10);
const monthStart = today.slice(0, 8) + '01';
---
<Base title="Counter · Reports">
  <section class="hero">
    <h1 data-i18n="st.p.h1">Reports</h1>
    <p class="staff-nav"><span data-i18n="st.staff">Staff:</span> <a href="/counter/queue" data-i18n="st.nav.queue">Queue</a> · <a href="/counter/batch" data-i18n="st.nav.batch">Batch</a> · <a href="/counter/fulfillment" data-i18n="st.nav.fulfillment">Fulfillment</a> · <a href="/counter/pickups" data-i18n="st.nav.pickups">Pickups</a> · <a href="/counter/customers" data-i18n="st.nav.customers">Customers</a> · <a href="/counter/accounts" data-i18n="st.nav.accounts">Accounts</a> · <a href="/counter/dropoff" data-i18n="st.nav.dropoffs">Drop-offs</a> · <a href="/counter/scan" data-i18n="st.nav.scan">Scan a QR</a> · <a href="/counter/exceptions" data-i18n="st.nav.exceptions">Exceptions</a> · <a href="/counter/claims" data-i18n="st.nav.claims">Claims</a> · <a href="/counter/reports" data-i18n="st.nav.reports">Reports</a> · <a href="/counter/close" data-i18n="st.nav.close">End of day</a> · <a href="/counter/invoices" data-i18n="st.nav.invoices">Invoices</a> · <a href="/counter/rules" data-i18n="st.nav.prices">Prices</a> · <a href="/counter/staff" data-i18n="st.nav.staff">Staff</a> · <a href="/counter/settings" data-i18n="st.nav.settings">Settings</a> · <a href="/counter/mailboxes" data-i18n="st.nav.mailboxes">Mailboxes</a> · <a href="/counter/export" data-i18n="st.nav.export">Export</a></p>
    <p class="lead" data-i18n="st.p.lead">What shipped, what it cost, what we kept. From PeterShip's records: labels bought through the website and the counter. In-store POS sales are not here.</p>
  </section>

  <form id="range" class="card">
    <div class="row">
      <label><span data-i18n="st.pin">Staff PIN</span> <input id="pin" type="password" inputmode="numeric" autocomplete="off" /></label>
      <label><span data-i18n="st.p.from">From</span> <input name="from" type="date" value={monthStart} max={today} /></label>
      <label><span data-i18n="st.p.to">To</span> <input name="to" type="date" value={today} max={today} /></label>
    </div>
    <p class="btnrow">
      <button class="btn" type="submit" data-i18n="st.p.run">Run report</button>
      <button class="btn kraft" type="button" data-preset="today" data-i18n="st.p.today">Today</button>
      <button class="btn kraft" type="button" data-preset="week" data-i18n="st.p.week">Last 7 days</button>
      <button class="btn kraft" type="button" data-preset="month" data-i18n="st.p.month">This month</button>
      <button class="btn kraft" type="button" data-preset="lastmonth" data-i18n="st.p.lastmonth">Last month</button>
      <button class="btn kraft" type="button" data-preset="quarter" data-i18n="st.p.quarter">This quarter</button>
      <button class="btn kraft" type="button" data-preset="year" data-i18n="st.p.year">This year</button>
      <button class="btn kraft" type="button" id="csv" data-i18n="st.p.csv">Download CSV</button>
    </p>
    <p id="msg" role="alert"></p>
  </form>

  <div id="out" class="hidden">
    <div class="grid">
      <div class="card"><h3 data-i18n="st.p.shipments">Shipments</h3><p class="big" id="t-ship"></p></div>
      <div class="card"><h3 data-i18n="st.p.paid">Customers paid</h3><p class="big" id="t-rev"></p></div>
      <div class="card"><h3 data-i18n="st.p.cost">Carriers charged</h3><p class="big" id="t-cost"></p></div>
      <div class="card"><h3 data-i18n="st.p.margin">Margin</h3><p class="big" id="t-margin"></p><p class="muted" id="t-pct"></p></div>
      <div class="card"><h3 data-i18n="st.p.addons">Add-ons sold</h3><p class="big" id="t-addons"></p><p class="muted" id="t-addons-n"></p></div>
      <div class="card"><h3 data-i18n="st.p.x402">Agent payments (x402)</h3><p class="big" id="t-x402"></p><p class="muted" id="t-x402-n"></p><p class="err hidden" id="t-x402-owed"></p></div>
    </div>

    <div class="grid">
      <div class="card">
        <h3 data-i18n="st.p.byday">By day</h3>
        <table class="list"><thead><tr><th data-i18n="st.p.th.day">Day</th><th data-i18n="st.p.th.ships">Ships</th><th data-i18n="st.p.th.paid">Paid</th><th data-i18n="st.p.th.cost">Cost</th><th data-i18n="st.p.th.margin">Margin</th></tr></thead><tbody id="by-day"></tbody></table>
      </div>
      <div class="card">
        <h3 data-i18n="st.p.bycarrier">By carrier</h3>
        <table class="list"><thead><tr><th data-i18n="st.u.th.carrier">Carrier</th><th data-i18n="st.p.th.ships">Ships</th><th data-i18n="st.p.th.paid">Paid</th><th data-i18n="st.p.th.cost">Cost</th><th data-i18n="st.p.th.margin">Margin</th></tr></thead><tbody id="by-carrier"></tbody></table>
        <h3 data-i18n="st.p.byservice">By service</h3>
        <table class="list"><thead><tr><th data-i18n="st.u.th.service">Service</th><th data-i18n="st.p.th.ships">Ships</th><th data-i18n="st.p.th.paid">Paid</th><th data-i18n="st.p.th.margin">Margin</th></tr></thead><tbody id="by-service"></tbody></table>
      </div>
    </div>

    <div class="card" id="acq">
      <h3 data-i18n="st.p.acq">The numbers a buyer asks for</h3>
      <p class="muted" data-i18n="st.p.acq.lead2">Labels per week, where the money comes from, what business accounts bring, claims. Same range as above.</p>
      <div class="tiles">
        <div class="card"><h3 data-i18n="st.p.acq.accshare">From business accounts</h3><p class="big" id="a-accshare"></p><p class="muted" id="a-accn"></p></div>
        <div class="card"><h3 data-i18n="st.p.acq.claims">Claims</h3><p class="big" id="a-claims"></p><p class="muted" id="a-claimsn"></p></div>
        <div class="card"><h3 data-i18n="st.p.acq.bench">At or under Pirate Ship</h3><p class="big" id="a-bench"></p><p class="muted" id="a-benchn"></p></div>
      </div>
      <div class="grid">
        <div>
          <h3 data-i18n="st.p.acq.byweek">By week</h3>
          <table class="list"><thead><tr><th data-i18n="st.p.acq.th.week">Week of</th><th data-i18n="st.p.th.ships">Ships</th><th data-i18n="st.p.th.paid">Paid</th><th data-i18n="st.p.th.margin">Margin</th></tr></thead><tbody id="a-week"></tbody></table>
        </div>
        <div>
          <h3 data-i18n="st.p.acq.mix">Where it was paid</h3>
          <table class="list"><thead><tr><th data-i18n="st.p.acq.th.source">Source</th><th data-i18n="st.p.th.ships">Ships</th><th data-i18n="st.p.th.paid">Paid</th><th data-i18n="st.p.acq.th.share">Share</th></tr></thead><tbody id="a-mix"></tbody></table>
          <h3 data-i18n="st.p.acq.accounts">By business account</h3>
          <table class="list"><thead><tr><th data-i18n="st.b.th.business">Business</th><th data-i18n="st.p.th.ships">Ships</th><th data-i18n="st.p.th.paid">Paid</th><th data-i18n="st.p.th.margin">Margin</th></tr></thead><tbody id="a-acc"></tbody></table>
        </div>
      </div>
    </div>

    <div class="grid">
      <div class="card">
        <h3 data-i18n="st.p.hours">Busiest hours</h3>
        <p class="muted" data-i18n="st.p.hours.lead">When labels were bought, shop local time.</p>
        <div class="bars" id="by-hour"></div>
        <h3 data-i18n="st.p.days">Busiest days</h3>
        <div class="bars" id="by-weekday"></div>
      </div>
      <div class="card">
        <h3 data-i18n="st.p.customers">Customers</h3>
        <p id="returning"></p>
        <h3 data-i18n="st.p.dropoffs">Drop-offs accepted</h3>
        <table class="list"><thead><tr><th data-i18n="st.u.th.carrier">Carrier</th><th data-i18n="st.p.th.packages">Packages</th></tr></thead><tbody id="dropoffs"></tbody></table>
        <h3 data-i18n="st.p.stand">Where shipments stand</h3>
        <table class="list"><thead><tr><th data-i18n="st.p.th.status">Status</th><th data-i18n="st.p.shipments">Shipments</th></tr></thead><tbody id="status"></tbody></table>
      </div>
    </div>
    <div class="card mb-report" id="mbReport">
      <h3 data-i18n="st.r.h">Mailboxes</h3>
      <p class="muted" data-i18n="st.r.p">Boxes, money taken through the website, and mail handled, for the dates above. Renewals paid at the register only count if staff used the Edit buttons.</p>
      <div class="grid mb-r-tiles">
        <div class="card"><h4 data-i18n="st.r.boxes">Boxes in use</h4><p class="big" id="r-boxes"></p><p class="muted" id="r-boxes-p"></p></div>
        <div class="card"><h4 data-i18n="st.r.money">Taken through the website</h4><p class="big" id="r-money"></p><p class="muted" id="r-money-p"></p></div>
        <div class="card"><h4 data-i18n="st.r.mail">Mail handled</h4><p class="big" id="r-mail"></p><p class="muted" id="r-mail-p"></p></div>
      </div>
      <table class="list"><tbody id="r-rows"></tbody></table>
      <p class="btnrow"><button class="btn kraft" type="button" id="mbCsv" data-i18n="st.r.csv">Download mailbox report (CSV)</button></p>
    </div>
  </div>

  <script>
    import { t, tf } from '../../i18n';
    const form = document.getElementById('range') as HTMLFormElement;
    const msg = document.getElementById('msg')!;
    const out = document.getElementById('out')!;
    const $ = (id: string) => document.getElementById(id)!;
    const pin = () => (document.getElementById('pin') as HTMLInputElement).value;
    const field = (n: string) => form.elements.namedItem(n) as HTMLInputElement;
    const usd = (n: number) => n.toLocaleString(undefined, { style: 'currency', currency: 'USD' });
    const iso = (d: Date) => d.toISOString().slice(0, 10);

    function rows(tbody: HTMLElement, data: unknown[][]) {
      tbody.innerHTML = '';
      for (const r of data) { const tr = document.createElement('tr'); for (const c of r) { const td = document.createElement('td'); td.textContent = String(c); tr.appendChild(td); } tbody.appendChild(tr); }
      if (!data.length) { const tr = document.createElement('tr'); const td = document.createElement('td'); td.colSpan = 5; td.className = 'muted'; td.textContent = t('st.p.nothing'); tr.appendChild(td); tbody.appendChild(tr); }
    }
    function bars(el: HTMLElement, data: { label: string; n: number }[]) {
      const max = Math.max(1, ...data.map((d) => d.n));
      el.innerHTML = '';
      for (const d of data) {
        const b = document.createElement('div'); b.className = 'bar';
        b.innerHTML = `<span class="bar-label"></span><span class="bar-track"><span class="bar-fill" style="width:${(d.n / max) * 100}%"></span></span><span class="bar-n"></span>`;
        b.querySelector('.bar-label')!.textContent = d.label; b.querySelector('.bar-n')!.textContent = String(d.n);
        el.appendChild(b);
      }
    }

    // The mailbox report (Peter, Nov 16 2026), for the same dates.
    async function runMailboxes() {
      const res = await fetch('/api/mailbox', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: pin(), action: 'report', from: field('from').value, to: field('to').value }) });
      const j = await res.json().catch(() => ({}));
      if (!res.ok) return;
      const r = j.report; const m = r.money;
      document.getElementById('r-boxes')!.textContent = String(r.boxes.at_end);
      document.getElementById('r-boxes-p')!.textContent = tf('st.r.boxes.p', { start: r.boxes.at_start, n: r.boxes.new, closed: r.boxes.closed, expired: r.boxes.expired });
      document.getElementById('r-money')!.textContent = usd(m.total);
      document.getElementById('r-money-p')!.textContent = tf('st.r.money.p', { owed: usd(m.owed_now), waived: usd(m.waived), declined: usd(m.declined) });
      document.getElementById('r-mail')!.textContent = String(r.mail.letters_in + r.mail.packages_in);
      document.getElementById('r-mail-p')!.textContent = tf('st.r.mail.p', { letters: r.mail.letters_in, packages: r.mail.packages_in, wait: r.mail.avg_package_wait_days ?? '–' });
      const rows: [string, string][] = [
        ...r.boxes.by_size.map((s: any) => [tf('st.r.size', { size: t(`mb.size.${s.size}`) }), `${s.rented} / ${s.total}`] as [string, string]),
        [t('st.r.online'), `${m.online_renewals.n} · ${usd(m.online_renewals.amount)}`], [t('st.r.auto'), `${m.auto_renewals.n} · ${usd(m.auto_renewals.amount)}`],
        [t('st.r.overage'), `${m.letter_overage.n} · ${usd(m.letter_overage.amount)}`], [t('st.r.pkgfee'), `${m.package_fees.n} · ${usd(m.package_fees.amount)}`],
        [t('st.r.storage'), `${m.storage_fees.n} · ${usd(m.storage_fees.amount)}`], [t('st.r.counter'), usd(m.fees_paid_at_counter)],
        [t('st.r.out'), tf('st.r.out.v', { picked: r.mail.picked_up, fwd: r.mail.forwarded, rts: r.mail.returned })],
        [t('st.r.people'), tf('st.r.people.v', { res: r.people.reservations, fwd: r.people.forward_requests, hold: r.people.on_hold_now, rts: r.people.return_to_sender_now })],
      ];
      const tb = document.getElementById('r-rows')!; tb.innerHTML = '';
      for (const [k, v] of rows) { const tr = document.createElement('tr'); const a = document.createElement('td'); a.textContent = k; const b = document.createElement('td'); b.textContent = v; tr.append(a, b); tb.appendChild(tr); }
    }
    document.getElementById('mbCsv')!.addEventListener('click', async () => {
      const res = await fetch('/api/mailbox', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: pin(), action: 'report', format: 'csv', from: field('from').value, to: field('to').value }) });
      if (!res.ok) return;
      const url = URL.createObjectURL(await res.blob());
      const a = document.createElement('a'); a.href = url; a.download = `mailboxes-${field('from').value}-to-${field('to').value}.csv`; a.click(); URL.revokeObjectURL(url);
    });
    async function run() {
      runMailboxes();
      msg.textContent = '';
      const res = await fetch('/api/reports', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: pin(), from: field('from').value, to: field('to').value }) });
      const r = await res.json();
      if (!res.ok) { msg.className = 'err'; msg.textContent = r.error; return; }
      $('t-ship').textContent = String(r.total.shipments);
      $('t-rev').textContent = usd(r.total.revenue);
      $('t-cost').textContent = usd(r.total.cost);
      $('t-margin').textContent = usd(r.total.margin);
      $('t-addons').textContent = usd(r.addons.revenue);
      $('t-addons-n').textContent = r.addons.by_item.map((i: any) => `${i.name} × ${i.qty}`).join(' · ');
      $('t-x402').textContent = r.x402 ? `$${r.x402.usd.toFixed(3)}` : '';
      $('t-x402-n').textContent = r.x402 ? tf('st.p.x402n', { calls: r.x402.calls }) + (r.x402.by_endpoint.length ? ': ' + r.x402.by_endpoint.map((e: any) => `${e.endpoint} × ${e.calls}`).join(' · ') : '') : '';
      const owed = $('t-x402-owed'); owed.innerHTML = ''; owed.classList.toggle('hidden', !r.x402?.refunds_owed?.length);
      for (const p of r.x402?.refunds_owed ?? []) {
        const line = document.createElement('div'); line.textContent = tf('st.p.x402owed', { amount: p.amount_usd.toFixed(2), to: p.payer ?? '?', id: p.shipment_id ?? p.endpoint }) + ' ';
        const b = document.createElement('button'); b.className = 'btn small'; b.textContent = t('st.p.x402paid');
        b.addEventListener('click', async () => { await fetch('/api/reports', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: pin(), from: field('from').value, to: field('to').value, action: 'x402_refunded', id: p.id }) }); form.requestSubmit(); });
        line.appendChild(b); owed.appendChild(line);
      }
      $('t-pct').textContent = r.total.revenue ? `${Math.round((r.total.margin / r.total.revenue) * 100)}${t('st.p.pct')}` : '';
      rows($('by-day'), r.by_day.map((d: any) => [d.day, d.shipments, usd(d.revenue), usd(d.cost), usd(d.margin)]));
      rows($('by-carrier'), r.by_carrier.map((d: any) => [d.carrier, d.shipments, usd(d.revenue), usd(d.cost), usd(d.margin)]));
      // The buyer's block (T24)
      const a = r.acquirer;
      if (a) {
        $('a-accshare').textContent = `${a.accounts.share}%`; $('a-accn').textContent = tf('st.p.acq.accn', { n: a.accounts.by_account.length, ships: a.accounts.total.shipments, paid: usd(a.accounts.total.revenue) });
        $('a-claims').textContent = String(a.claims.opened); $('a-claimsn').textContent = tf('st.p.acq.claimsn', { n: a.claims.refunded, usd: usd(a.claims.refunded_usd) });
        $('a-bench').textContent = a.benchmark.quotes ? `${a.benchmark.share}%` : '–'; $('a-benchn').textContent = tf('st.p.acq.benchn', { n: a.benchmark.quotes, diff: a.benchmark.avg_diff == null ? '–' : (a.benchmark.avg_diff >= 0 ? '+' : '−') + usd(Math.abs(a.benchmark.avg_diff)) });
        rows($('a-week'), a.by_week.map((w: any) => [w.week, w.shipments, usd(w.revenue), usd(w.margin)]));
        rows($('a-mix'), a.mix.map((m: any) => [t('st.p.acq.src.' + m.source), m.shipments, usd(m.revenue), `${m.share}%`]));
        rows($('a-acc'), a.accounts.by_account.map((x: any) => [x.business_name, x.shipments, usd(x.revenue), usd(x.margin)]));
      }
      rows($('by-service'), r.by_service.map((d: any) => [d.service, d.shipments, usd(d.revenue), usd(d.margin)]));
      // Hours come in UTC; shift to this device's zone (the shop tablet is on Central time).
      const offset = Math.round(new Date().getTimezoneOffset() / 60);
      const local = Array.from({ length: 24 }, (_, h) => ({ label: `${h % 12 || 12}${h < 12 ? 'am' : 'pm'}`, n: r.by_hour[(h + offset + 24) % 24].shipments }));
      bars($('by-hour'), local.filter((_, h) => h >= 7 && h <= 20));
      const days = t('st.p.wd').split(',');
      bars($('by-weekday'), r.by_weekday.map((d: any) => ({ label: days[d.weekday], n: d.shipments })));
      $('returning').textContent = tf('st.p.returning', { c: r.returning.customers, r: r.returning.returning, p: Math.round(r.returning.share * 100) });
      rows($('dropoffs'), r.dropoffs.map((d: any) => [d.carrier, d.count]));
      rows($('status'), r.status.map((d: any) => [t(`st.status.${d.status}`), d.shipments]));
      out.classList.remove('hidden');
    }

    form.addEventListener('submit', (e) => { e.preventDefault(); run(); });
    document.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
      const now = new Date(); let to = iso(now); let from = to;
      if (b.dataset.preset === 'week') from = iso(new Date(now.getTime() - 6 * 86_400_000));
      if (b.dataset.preset === 'month') from = to.slice(0, 8) + '01';
      if (b.dataset.preset === 'lastmonth') { const first = new Date(Date.UTC(now.getFullYear(), now.getMonth() - 1, 1)); from = iso(first); to = iso(new Date(Date.UTC(now.getFullYear(), now.getMonth(), 0))); }
      if (b.dataset.preset === 'quarter') from = iso(new Date(Date.UTC(now.getFullYear(), Math.floor(now.getMonth() / 3) * 3, 1)));
      if (b.dataset.preset === 'year') from = `${now.getFullYear()}-01-01`;
      field('from').value = from; field('to').value = to; run();
    }));
    document.getElementById('csv')!.addEventListener('click', async () => {
      const res = await fetch('/api/reports', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: pin(), from: field('from').value, to: field('to').value, format: 'csv' }) });
      if (!res.ok) { msg.className = 'err'; msg.textContent = (await res.json()).error; return; }
      const a = document.createElement('a'); a.href = URL.createObjectURL(await res.blob()); a.download = `shipments-${field('from').value}-to-${field('to').value}.csv`; a.click();
    });
  </script>
</Base>
