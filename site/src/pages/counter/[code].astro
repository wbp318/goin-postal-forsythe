---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import { env } from '../../lib/env';
import { getOrder, orderTotal } from '../../lib/orders';
import { listNotes } from '../../shipping/store';
import { listPhotos } from '../../lib/photos';

// Staff page. Opened by scanning the customer's QR code. Buying or marking printed needs the PIN.
const order = await getOrder(env, Astro.params.code ?? '');
if (!order) return new Response('No such order', { status: 404 });
const notes = await listNotes(env, 'order', order.id);
const photos = await listPhotos(env, order.id);
---
<Base title={`Counter · ${order.id}`}>
  <section class="hero">
    <h1>{order.id}</h1>
    <p class="lead"><span data-i18n="st.o.status">Status:</span> <strong data-i18n={`st.status.${order.status}`}>{order.status.replace('_', ' ')}</strong> · <span data-i18n={order.international ? 'st.o.intl' : order.source === 'counter' ? 'st.o.walkup' : 'st.o.domestic'}>{order.international ? 'International, ring up on the POS' : order.source === 'counter' ? 'Walk-up, ring up on the POS' : 'Domestic, paid online'}</span>{order.name ? ` · ${order.name}` : ''}</p>
  </section>

  <div class="grid">
    <div class="card">
      <h3>{order.rate.service} · ${order.rate.total_charge.toFixed(2)}</h3>
      {order.addons?.map((l) => <p>{l.name}{l.qty > 1 ? ` × ${l.qty}` : ''} · ${l.total.toFixed(2)}</p>)}
      {order.insurance && <p><span data-i18n="done.insurance">Insurance</span> ${'to'} ${order.insurance.declared_usd} · ${order.insurance.fee.toFixed(2)}</p>}
      <p><strong data-i18n="st.o.ringup">Total:</strong> <strong>${orderTotal(order).toFixed(2)}</strong>{order.status === 'reserved' && <span class="muted"> · <span data-i18n="st.o.ringup.pos">ring this up on the POS</span></span>}</p>
      {order.kind === 'return' && <p><strong data-i18n="st.o.return">Return label.</strong> <span data-i18n="st.o.return.from">From</span> {order.origin.contact_name}, {order.origin.city}, {order.origin.state} {order.origin.postal_code}. <span data-i18n="st.o.return.email">Email it to the sender below.</span></p>}
      <p><strong data-i18n="st.o.to">To:</strong> {order.destination.contact_name}<br/>{order.destination.line_1}{order.destination.line_2 ? `, ${order.destination.line_2}` : ''}<br/>{order.destination.city}, {order.destination.state} {order.destination.postal_code} {order.destination.country_alpha2}</p>
      <p><strong data-i18n="st.o.parcel">Parcel:</strong> {order.parcel.weight_lb} lb · {order.parcel.length_in}×{order.parcel.width_in}×{order.parcel.height_in} in · {order.parcel.description ? order.parcel.description : <span data-i18n="st.o.nodesc">no description</span>} · ${order.parcel.value_usd}</p>
      <p><strong data-i18n="st.o.customer">Customer:</strong> {order.email}</p>
    </div>

    <div class="card">
      <label><span data-i18n="st.pin">Staff PIN</span> <input id="pin" type="password" inputmode="numeric" autocomplete="off" /></label>
      {order.account_name && <p><strong data-i18n="st.b.account">Business account:</strong> {order.account_name}{order.discount_percent ? ` (${order.discount_percent}% off)` : ''}</p>}
      {order.status === 'reserved' && order.account_id && <p><button class="btn" data-action="bill" data-i18n="st.b.bill">Bill to account. Buy label</button></p>}
      {order.status === 'reserved' && !order.account_id && <p><button class="btn" data-action="paid" data-i18n="st.buy.long">Rung up on the POS. Buy label</button></p>}
      {order.label?.label_url && <p><a class="btn" href={order.label.label_url} target="_blank" rel="noopener" data-i18n="st.openlabel">Open label to print</a></p>}
      {order.label && <p><button class="btn" data-print="counter" data-i18n="st.print">Print at the counter</button> <span class="muted" data-i18n="st.sendsprinter">sends it to the label printer</span></p>}
      {order.label && <p><label><span data-i18n="st.emailto">Email the label to</span> <input id="email" type="email" value={order.email} placeholder="name@example.com" /></label> <button class="btn kraft" data-email data-i18n="st.emaillabel">Email label</button>{order.emailed_at && <span class="muted"> <span data-i18n="st.lastsent">last sent</span> {order.emailed_at}</span>}</p>}
      {order.status === 'labeled' && <p><button class="btn kraft" data-action="printed" data-i18n="st.printed">Mark printed</button></p>}
      {(order.status === 'labeled' || order.status === 'printed') && <p><a class="btn small kraft" href={`/counter/claims?shipment=${order.id}`} data-i18n="st.c.openlink">Lost or damaged? Open a claim</a></p>}
      {(order.status === 'labeled' || order.status === 'printed') && <p><button class="btn small" data-action="void" data-confirm="st.confirm.void" data-i18n="st.voidlabel">Void label</button></p>}
      {(order.status === 'awaiting_payment' || order.status === 'reserved') && <p><button class="btn small" data-action="cancel" data-confirm="st.confirm.cancel" data-i18n="st.cancelquote">Cancel quote</button></p>}
      <p class="staff-nav">{order.label?.tracking_number && <><a href={`/track?q=${order.id}`} data-i18n="st.o.tracking">Tracking</a> · </>}<a href="/counter/queue" data-i18n="st.nav.queue">Queue</a> · <a href="/counter/batch" data-i18n="st.nav.batch">Batch</a> · <a href="/counter/fulfillment" data-i18n="st.nav.fulfillment">Fulfillment</a> · <a href="/counter/pickups" data-i18n="st.nav.pickups">Pickups</a> · <a href="/counter/customers" data-i18n="st.nav.customers">Customers</a> · <a href="/counter/accounts" data-i18n="st.nav.accounts">Accounts</a> · <a href="/counter/dropoff" data-i18n="st.nav.dropoffs">Drop-offs</a> · <a href="/counter/mailboxes" data-i18n="st.nav.mailboxes">Mailboxes</a> · <a href="/counter/exceptions" data-i18n="st.nav.exceptions">Exceptions</a> · <a href="/counter/claims" data-i18n="st.nav.claims">Claims</a> · <a href="/counter/reports" data-i18n="st.nav.reports">Reports</a> · <a href="/counter/close" data-i18n="st.nav.close">End of day</a> · <a href="/counter/invoices" data-i18n="st.nav.invoices">Invoices</a> · <a href="/counter/rules" data-i18n="st.nav.prices">Prices</a> · <a href="/counter/staff" data-i18n="st.nav.staff">Staff</a> · <a href="/counter/export" data-i18n="st.nav.export">Export</a></p>
      {order.status === 'printed' && <p><span data-i18n="st.o.printedat">Printed</span> {order.printed_at}.</p>}
      {order.status === 'voided' && <p><span data-i18n="st.o.voidedat">Label voided</span> {order.voided_at}{order.void_reason ? `: ${order.void_reason}` : ''}. <span data-i18n="st.o.refund">Refund the customer by hand if they paid.</span></p>}
      {order.status === 'cancelled' && <p><span data-i18n="st.o.cancelledat">Quote cancelled</span> {order.cancelled_at}{order.cancel_reason ? `: ${order.cancel_reason}` : ''}. <span data-i18n="st.o.nothingbought">Nothing was bought.</span></p>}
      {order.status === 'awaiting_payment' && <p data-i18n="st.o.notpaid">Not paid online yet. Ask the customer to finish payment, or quote it again here and ring it up on the POS.</p>}
      <p id="msg"></p>
    </div>
    <div class="card">
      <h3 data-i18n="st.n.h3">Notes</h3>
      <ol class="timeline" id="notes">{notes.map((n) => <li><time>{n.at.slice(0, 16).replace('T', ' ')} · {n.by_name}</time><span>{n.note}</span></li>)}</ol>
      {!notes.length && <p class="muted" id="nonotes" data-i18n="st.n.none">No notes yet.</p>}
      <p><input id="note" maxlength="500" data-i18n-ph="st.n.ph" placeholder="Fragile pottery, call before delivery…" /> <button class="btn small kraft" data-addnote data-i18n="st.n.add">Add note</button></p>
      <h3 data-i18n="st.ph.h3">Photos</h3>
      <p class="muted" data-i18n="st.ph.lead">Photograph the item before it is packed. Settles a damage claim and is what the carrier asks for first.</p>
      <div class="photos" id="photos">{photos.map((p) => <figure data-photo={p.id}><a href={`/api/photos?id=${p.id}`} target="_blank" rel="noopener"><img src={`/api/photos?id=${p.id}`} alt={p.caption ?? ''} loading="lazy" /></a><figcaption>{p.caption ?? ''} <span class="muted">{p.at.slice(0, 16).replace('T', ' ')} · {p.by_name}</span> <button type="button" class="btn small" data-delphoto={p.id}>×</button></figcaption></figure>)}</div>
      <p><input type="file" id="photo" accept="image/*" capture="environment" /> <input id="caption" maxlength="120" data-i18n-ph="st.ph.ph" placeholder="Before packing, small dent on lid" /> <button class="btn small kraft" data-addphoto data-i18n="st.ph.add">Add photo</button></p>
    </div>
    <style>.photos { display: flex; flex-wrap: wrap; gap: 10px; } .photos figure { margin: 0; width: 160px; } .photos img { width: 160px; height: 120px; object-fit: cover; border-radius: 6px; } .photos figcaption { font-size: .85rem; }</style>
  </div>

  <script define:vars={{ id: order.id }}>
    const msg = document.getElementById('msg');
    document.querySelectorAll('[data-action]').forEach((b) => b.addEventListener('click', async () => {
      const pin = document.getElementById('pin').value;
      let reason = '';
      if (b.dataset.action === 'void' || b.dataset.action === 'cancel') { reason = window.prompt(window.t(b.dataset.action === 'void' ? 'st.n.whyvoid' : 'st.n.whycancel')) || ''; if (!reason.trim()) return; }
      else if (b.dataset.confirm && !window.confirm(window.t(b.dataset.confirm))) return;
      b.disabled = true;
      const res = await fetch('/api/counter', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ order: id, pin, action: b.dataset.action, reason }) });
      const j = await res.json();
      if (!res.ok) { msg.textContent = j.error; b.disabled = false; return; }
      location.reload();
    }));
    document.querySelectorAll('[data-addnote]').forEach((b) => b.addEventListener('click', async () => {
      const pin = document.getElementById('pin').value;
      const note = document.getElementById('note').value;
      const res = await fetch('/api/notes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin, action: 'add', kind: 'order', target: id, note }) });
      const j = await res.json();
      if (!res.ok) { msg.textContent = j.error; return; }
      const li = document.createElement('li'); const tm = document.createElement('time'); tm.textContent = `${j.note.at.slice(0, 16).replace('T', ' ')} · ${j.note.by_name}`; const sp = document.createElement('span'); sp.textContent = j.note.note; li.append(tm, sp);
      document.getElementById('notes').prepend(li); document.getElementById('note').value = ''; const nn = document.getElementById('nonotes'); if (nn) nn.remove();
    }));
    // Intake photos: shrink to 1280 px JPEG in the browser, send as a data URL.
    async function shrink(file) {
      const bmp = await createImageBitmap(file);
      const scale = Math.min(1, 1280 / Math.max(bmp.width, bmp.height));
      const c = document.createElement('canvas'); c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
      c.getContext('2d').drawImage(bmp, 0, 0, c.width, c.height);
      let q = 0.82, out = c.toDataURL('image/jpeg', q);
      while (out.length > 780_000 && q > 0.4) { q -= 0.1; out = c.toDataURL('image/jpeg', q); }
      return out;
    }
    document.querySelectorAll('[data-addphoto]').forEach((b) => b.addEventListener('click', async () => {
      const file = document.getElementById('photo').files[0];
      if (!file) { msg.textContent = 'Pick or take a photo first'; return; }
      b.disabled = true;
      try {
        const image = await shrink(file);
        const res = await fetch('/api/photos', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: document.getElementById('pin').value, action: 'add', shipment: id, image, caption: document.getElementById('caption').value }) });
        const j = await res.json();
        if (!res.ok) { msg.textContent = j.error; b.disabled = false; return; }
        location.reload();
      } catch (e) { msg.textContent = e.message; b.disabled = false; }
    }));
    document.querySelectorAll('[data-delphoto]').forEach((b) => b.addEventListener('click', async () => {
      if (!confirm('Delete this photo?')) return;
      const res = await fetch('/api/photos', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: document.getElementById('pin').value, action: 'delete', id: b.dataset.delphoto }) });
      const j = await res.json();
      if (!res.ok) { msg.textContent = j.error; return; }
      b.closest('figure').remove();
    }));
    document.querySelectorAll('[data-email]').forEach((b) => b.addEventListener('click', async () => {
      const pin = document.getElementById('pin').value;
      const email = document.getElementById('email').value;
      b.disabled = true;
      const res = await fetch('/api/counter', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ order: id, pin, action: 'email', email }) });
      const j = await res.json();
      b.disabled = false;
      msg.textContent = res.ok ? window.tf(j.mock ? 'st.o.emaillogged' : 'st.o.emailed', { email: j.email }) : j.error;
    }));
    document.querySelectorAll('[data-print]').forEach((b) => b.addEventListener('click', async () => {
      const pin = document.getElementById('pin').value;
      b.disabled = true;
      const res = await fetch('/api/print', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ order: id, pin, action: 'queue', printer: b.dataset.print }) });
      const j = await res.json();
      b.disabled = false;
      if (!res.ok) { msg.textContent = j.error; return; }
      msg.textContent = j.agent ? window.tf('st.o.queuedkind', { printer: b.dataset.print, kind: j.kind === 'label_zpl' ? window.t('st.o.thermal') : 'PDF' }) : window.t('st.noagent');
    }));
  </script>
</Base>
