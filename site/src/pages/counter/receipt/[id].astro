---
export const prerender = false;
import Base from '../../../layouts/Base.astro';
import { store } from '../../../data/store';

// Staff page: one drop-off receipt, for printing from the browser when the printer agent is not
// running, or for showing the customer on the tablet. Loads after the PIN so a guessed number shows
// nothing. The thermal version (with a scannable barcode) goes through the print queue; this is the
// same words on paper with the number in large type.
const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id < 1) return new Response('No such receipt', { status: 404 });
---
<Base title={`Counter · Receipt ${id}`}>
  <section class="hero noprint">
    <h1><span data-i18n="st.r.h1">Drop-off receipt</span> {id}</h1>
    <p class="staff-nav"><span data-i18n="st.staff">Staff:</span> <a href="/counter/queue" data-i18n="st.nav.queue">Queue</a> · <a href="/counter/customers" data-i18n="st.nav.customers">Customers</a> · <a href="/counter/accounts" data-i18n="st.nav.accounts">Accounts</a> · <a href="/counter/dropoff" data-i18n="st.nav.dropoffs">Drop-offs</a> · <a href="/counter/mailboxes" data-i18n="st.nav.mailboxes">Mailboxes</a> · <a href="/counter/exceptions" data-i18n="st.nav.exceptions">Exceptions</a> · <a href="/counter/reports" data-i18n="st.nav.reports">Reports</a> · <a href="/counter/close" data-i18n="st.nav.close">End of day</a> · <a href="/counter/invoices" data-i18n="st.nav.invoices">Invoices</a> · <a href="/counter/rules" data-i18n="st.nav.prices">Prices</a> · <a href="/counter/staff" data-i18n="st.nav.staff">Staff</a> · <a href="/counter/export" data-i18n="st.nav.export">Export</a></p>
    <p class="btnrow">
      <label><span data-i18n="st.pin">Staff PIN</span> <input id="pin" type="password" inputmode="numeric" autocomplete="off" /></label>
      <button class="btn" id="load" data-i18n="st.show">Show</button>
      <button class="btn kraft hidden" id="print" data-i18n="st.r.printpage">Print this page</button>
      <button class="btn kraft hidden" id="thermal" data-i18n="st.print">Print at the counter</button>
    </p>
    <p id="msg" role="alert"></p>
  </section>

  <div id="slip" class="card slip hidden">
    <h2>{store.name}</h2>
    <p class="muted">{store.address}<br/>{store.phone}</p>
    <h3 data-i18n="st.r.title">DROP-OFF RECEIPT</h3>
    <p id="meta"></p>
    <p class="muted" data-i18n="st.r.tracking">Tracking number</p>
    <p id="code" class="code"></p>
    <p data-i18n="st.r.body">We handed this package to the carrier named above on their next pickup. Track it on the carrier's website with the number above. Keep this receipt until it is delivered.</p>
    <p class="muted"><span data-i18n="st.r.questions">Questions:</span> {store.phone}. <span data-i18n="st.r.bring">Bring this receipt or the number.</span></p>
  </div>

  <style>
    .slip { max-width: 28rem; margin: 24px auto; }
    .slip h3 { font-size: 1.6rem; margin: 16px 0 8px; letter-spacing: .04em; }
    .slip .code { font-family: ui-monospace, Consolas, monospace; font-size: 1.5rem; font-weight: 700; word-break: break-all; margin: 0 0 8px; }
    @media print { .noprint, header, footer, nav { display: none !important; } .slip { border: none; box-shadow: none; margin: 0; max-width: none; } }
  </style>

  <script define:vars={{ id }}>
    const $ = (i) => document.getElementById(i);
    const pin = () => $('pin').value;
    const msg = $('msg');
    const fmt = (iso) => new Date(iso).toLocaleString(undefined, { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' });
    async function api(body) {
      const res = await fetch('/api/dropoff', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pin: pin(), ...body }) });
      const j = await res.json();
      if (!res.ok) throw new Error(j.error);
      return j;
    }
    async function load() {
      msg.textContent = '';
      try {
        const { dropoff: d } = await api({ action: 'get', id });
        $('meta').innerHTML = '';
        const t = window.t;
        for (const line of [`${t('st.r.received')} ${fmt(d.accepted_at)}`, `${t('st.r.carrier')} ${d.carrier ?? '?'}`, `${t('st.r.no')} ${d.id}`, d.customer_name ? `${t('st.r.from')} ${d.customer_name}` : '', d.accepted_by ? `${t('st.r.acceptedby')} ${d.accepted_by}` : '']) {
          if (!line) continue;
          const s = document.createElement('span'); s.textContent = line; $('meta').appendChild(s); $('meta').appendChild(document.createElement('br'));
        }
        $('code').textContent = d.barcode;
        $('slip').classList.remove('hidden'); $('print').classList.remove('hidden'); $('thermal').classList.remove('hidden');
      } catch (e) { msg.className = 'err'; msg.textContent = e.message; }
    }
    $('load').addEventListener('click', load);
    $('pin').addEventListener('change', load);
    $('print').addEventListener('click', () => window.print());
    $('thermal').addEventListener('click', async () => { try { const j = await api({ action: 'receipt', id }); msg.className = ''; msg.textContent = j.receipt.agent ? window.t('st.r.sent') : window.t('st.r.queuednoagent'); } catch (e) { msg.className = 'err'; msg.textContent = e.message; } });
  </script>
</Base>
