---
export const prerender = false;
import Base from '../../layouts/Base.astro';

// The counter's front door (v1.78.0): /counter from the footer's Staff link or typed in. The PIN is
// checked once with the staff API's `me` and the page then lists every staff page with who you are
// and your role. Each counter page still asks for the PIN in its own box; this page is the map.
const PAGES: [string, string, string][] = [
  ['/counter/queue', 'st.nav.queue', 'Queue'], ['/counter/batch', 'st.nav.batch', 'Batch'], ['/counter/fulfillment', 'st.nav.fulfillment', 'Fulfillment'],
  ['/counter/pickups', 'st.nav.pickups', 'Pickups'], ['/counter/customers', 'st.nav.customers', 'Customers'], ['/counter/accounts', 'st.nav.accounts', 'Accounts'],
  ['/counter/dropoff', 'st.nav.dropoffs', 'Drop-offs'], ['/counter/scan', 'st.nav.scan', 'Scan a QR'], ['/counter/exceptions', 'st.nav.exceptions', 'Exceptions'],
  ['/counter/claims', 'st.nav.claims', 'Claims'], ['/counter/reports', 'st.nav.reports', 'Reports'], ['/counter/close', 'st.nav.close', 'End of day'],
  ['/counter/invoices', 'st.nav.invoices', 'Invoices'], ['/counter/rules', 'st.nav.prices', 'Prices'], ['/counter/staff', 'st.nav.staff', 'Staff'], ['/counter/export', 'st.nav.export', 'Export'],
];
---
<Base title="Counter">
  <section class="hero">
    <h1 data-i18n="st.in.h1">Staff sign-in</h1>
    <p class="lead" data-i18n="st.in.lead">Type your staff PIN to open the counter pages. Each page asks for the PIN again in its own box.</p>
  </section>
  <div class="grid">
    <form class="card" id="signin" autocomplete="off">
      <label><span data-i18n="st.pin">Staff PIN</span> <input id="pin" type="password" inputmode="numeric" autocomplete="off" autofocus /></label>
      <p><button class="btn" type="submit" data-i18n="st.in.go">Sign in</button> <span id="msg" role="alert"></span></p>
    </form>
    <div class="card hidden" id="pages">
      <p><strong data-i18n="st.in.hello">Signed in as</strong> <span id="who"></span></p>
      <ul class="ps-links">{PAGES.map(([href, key, label]) => <li><a href={href} data-i18n={key}>{label}</a></li>)}</ul>
    </div>
  </div>
  <script>
    const $ = (id: string) => document.getElementById(id)!;
    $('signin').addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const msg = $('msg'); msg.className = ''; msg.textContent = '…';
      const res = await fetch('/api/staff', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'me', pin: ($('pin') as HTMLInputElement).value }) });
      const j = await res.json();
      if (!res.ok) { msg.className = 'err'; msg.textContent = j.error || 'Wrong PIN'; return; }
      msg.textContent = '';
      $('who').textContent = `${j.user.name} (${j.user.role})`;
      $('pages').classList.remove('hidden');
      $('signin').classList.add('hidden');
    });
  </script>
</Base>
