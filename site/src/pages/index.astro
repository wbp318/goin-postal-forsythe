---
import Base from '../layouts/Base.astro';
import StoreInfo from '../components/StoreInfo.astro';
import { store } from '../data/store';
---
<Base title="Goin' Postal Forsythe">
  <section class="hero">
    <h1 data-i18n="home.h1">Ship it, pack it, print it. One stop on Forsythe.</h1>
    <p class="lead" data-i18n="home.lead">Your neighborhood shipping store at 1800 Forsythe Ave in Monroe. Every major carrier, honest rates, and people who pack it right.</p>
    <a class="btn" href="/ship" data-i18n="home.cta">Ship a package</a>
    <a class="btn kraft" href="#hours" style="margin-left:8px" data-i18n="home.hours">Hours and directions</a>
  </section>

  <section id="services">
    <h2 data-i18n="home.services">Services</h2>
    <div class="grid">
      {store.services.map(s => (
        <div class="card"><h3 data-i18n={`svc.${s.key}.n`}>{s.name}</h3><p data-i18n={`svc.${s.key}.b`}>{s.blurb}</p></div>
      ))}
    </div>
  </section>

  <section>
    <h2 data-i18n="home.findus">Find us</h2>
    <div class="grid">
      <StoreInfo />
      <div class="card">
        <iframe title="Map to Goin' Postal Forsythe" width="100%" height="280" style="border:0;border-radius:8px" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          src="https://www.google.com/maps?q=1800+Forsythe+Ave+Ste+2,+Monroe,+LA+71201&output=embed"></iframe>
      </div>
    </div>
  </section>
</Base>
