---
import Base from '../../layouts/Base.astro';
import { store } from '../../data/store';
import { renderCard, makeTemplate, PALETTES, CARD_OPTIONS, SAMPLE } from '../../lib/cards';
import { BUSINESS_TYPES, fromPrice } from '../../lib/cardShop';

// The business card shop (Peter, Nov 14 2026): what an online print shop's card page offers (papers, finishes,
// corners, designs by type of business, upload your own), in the store's own look and words. Every picture is
// drawn from the site's own card designs; every price comes from the same table the order is charged from
// (lib/cards.ts), so this page can never show a price the checkout doesn't charge. Only options the store
// sells today are shown. The designer itself is /cards/design.
const card = (b: (typeof BUSINESS_TYPES)[number], side: 'front' | 'back' = 'front') => renderCard(makeTemplate(b.template, PALETTES[b.palette], b.sample, false), side);
const by = (id: string) => BUSINESS_TYPES.find((b) => b.id === id)!;
const money = (n: number) => `$${n.toFixed(2)}`;
const base = fromPrice();
const hero = [by('realestate'), by('restaurant'), by('lawn')];
const opt = (code: string) => CARD_OPTIONS.find((o) => o.code === code)!;
const papers = [
  { code: 'standard', k: 'standard', title: 'Standard', blurb: 'Our everyday card on smooth 14 pt paper. Crisp, sturdy and the best value.', b: by('medical'), look: '' },
  { code: 'thick', k: 'thick', title: 'Thick', blurb: 'Heavier 16 pt paper that feels solid in the hand and stands out from the stack.', b: by('trades'), look: 'thick' },
  { code: 'linen', k: 'linen', title: 'Linen', blurb: 'A textured, cloth-like paper with a classic, high-end feel.', b: by('church'), look: 'linen' },
];
const finishes = [
  { code: 'matte', k: 'matte', title: 'Matte', points: ['Smooth, with no shine', 'Easy to write on', 'Our most popular finish'], b: by('beauty') },
  { code: 'gloss', k: 'gloss', title: 'Gloss', points: ['Shiny, bright colors', 'Photos really pop', 'Wipes clean'], b: by('auto') },
  { code: 'softtouch', k: 'soft', title: 'Soft touch', points: ['Velvety, silky feel', 'Rich, deep colors', 'Gets noticed when handed over'], b: by('restaurant') },
];
---
<Base title={`Business cards · ${store.name}`} description="Business cards printed at Goin' Postal Forsythe in Monroe, Louisiana. Pick a design or upload your own, choose your paper and finish, pay online and pick them up in the store.">
  <section class="shop-hero">
    <div class="shop-hero-text">
      <p class="ps-kicker"><a href="/printing" data-i18n="nav.printing">Printing</a> › <span data-i18n="nav.print.cards">Business Cards</span></p>
      <h1 data-i18n="shop.h1">Business cards, printed here in Monroe</h1>
      <p class="lead" data-i18n="shop.lead">Pick one of our designs or upload your own. Choose your paper and finish, pay online, and pick them up at the store.</p>
      <p class="shop-price"><span data-i18n="shop.from">From</span> <strong>{money(base.total)}</strong> <span class="muted">· {money(base.each)} <span data-i18n="shop.each">each</span> / {base.qty} <span data-i18n="shop.cards">cards</span></span></p>
      <p class="btnrow"><a class="btn big" href="#designs" data-i18n="shop.browse">Browse designs</a> <a class="btn big kraft" href="/cards/design?upload=1" data-i18n="shop.upload">Upload your design</a></p>
    </div>
    <div class="shop-stack" aria-hidden="true">
      {hero.map((b, i) => <div class={`card-wrap s${i}`} set:html={card(b)} />)}
    </div>
  </section>

  <ul class="shop-why">
    <li><b data-i18n="shop.why1">Pick up in the store</b><span data-i18n="shop.why1p">No shipping wait, no lost boxes.</span></li>
    <li><b data-i18n="shop.why2">A real person checks every card</b><span data-i18n="shop.why2p">We look over your design before it prints.</span></li>
    <li><b data-i18n="shop.why3">Need them fast?</b><span data-i18n="shop.why3p">Next-business-day rush is available.</span></li>
    <li><b data-i18n="shop.why4">Local help</b><span data-i18n="shop.why4p">Questions? Call or stop by and talk to us.</span></li>
  </ul>

  <section class="shop-sec" aria-labelledby="paperH">
    <h2 id="paperH" data-i18n="shop.paper.h">Pick your paper</h2>
    <p class="muted" data-i18n="shop.paper.p">From everyday to standout, every card is printed in full color on both sides.</p>
    <div class="shop-grid three">
      {papers.map((x) => { const f = fromPrice(x.code); return (
        <a class="shop-tile" href={`/cards/design?stock=${x.code}#designs`}>
          <div class={`shop-pic paper ${x.look}`}><div class="card-wrap back" set:html={card(x.b, 'back')} /><div class="card-wrap front" set:html={card(x.b)} /></div>
          <div class="shop-body">
            <h3 data-i18n={`shop.paper.${x.k}`}>{x.title}</h3>
            <p data-i18n={`shop.paper.${x.k}.p`}>{x.blurb}</p>
            <p class="shop-from"><span data-i18n="shop.from">From</span> {money(f.total)} <span class="muted">· {money(f.each)} <span data-i18n="shop.each">each</span> / {f.qty}</span></p>
            <span class="btn small kraft"><span data-i18n="shop.shop">Shop</span> <span data-i18n={`shop.paper.${x.k}`}>{x.title}</span></span>
          </div>
        </a>); })}
    </div>
  </section>

  <section class="shop-sec" aria-labelledby="finishH">
    <h2 id="finishH" data-i18n="shop.finish.h">Compare finishes</h2>
    <p class="muted" data-i18n="shop.finish.p">The finish is the coating on the paper. It changes how your card looks and feels.</p>
    <div class="finish-tabs" role="tablist">
      {finishes.map((x, i) => <button type="button" role="tab" class="finish-tab" aria-selected={i === 0 ? 'true' : 'false'} data-f={x.code}><span class={`swatch-card ${x.k}`} /><span data-i18n={`shop.fin.${x.k}`}>{x.title}</span></button>)}
    </div>
    {finishes.map((x, i) => { const o = opt(x.code); const f = fromPrice(x.code); return (
      <div class="finish-panel" data-f={x.code} hidden={i !== 0} role="tabpanel">
        <div class={`shop-pic finish ${x.k}`}><div class="card-wrap front" set:html={card(x.b)} /></div>
        <div>
          <h3 data-i18n={`shop.fin.${x.k}`}>{x.title}</h3>
          <ul>{x.points.map((p, j) => <li data-i18n={`shop.fin.${x.k}.${j + 1}`}>{p}</li>)}</ul>
          <p class="shop-from">{o.price ? <><span>+{money(o.price)}</span> <span data-i18n="shop.perorder">per order</span></> : <span data-i18n="shop.included">Included at no extra cost</span>} <span class="muted">· <span data-i18n="shop.from">From</span> {money(f.total)} / {f.qty}</span></p>
          <p class="btnrow"><a class="btn" href={`/cards/design?finish=${x.code}#designs`} data-i18n="shop.browse">Browse designs</a> <a class="btn kraft" href={`/cards/design?upload=1&finish=${x.code}`} data-i18n="shop.upload">Upload your design</a></p>
        </div>
      </div>); })}
  </section>

  <section class="shop-sec" aria-labelledby="cornerH">
    <h2 id="cornerH" data-i18n="shop.corner.h">Square or rounded corners</h2>
    <div class="shop-grid two">
      {[{ code: 'square', k: 'square', title: 'Square corners', blurb: 'The classic business card shape.', b: by('realestate') }, { code: 'rounded', k: 'rounded', title: 'Rounded corners', blurb: 'Soft, rounded corners for a friendly, modern look.', b: by('beauty') }].map((x) => { const o = opt(x.code); return (
        <a class="shop-tile" href={`/cards/design?corners=${x.code}#designs`}>
          <div class={`shop-pic corners ${x.k}`}><div class="card-wrap front" set:html={card(x.b)} /></div>
          <div class="shop-body">
            <h3 data-i18n={`shop.corner.${x.k}`}>{x.title}</h3>
            <p data-i18n={`shop.corner.${x.k}.p`}>{x.blurb}</p>
            <p class="shop-from">{o.price ? <><span>+{money(o.price)}</span> <span data-i18n="shop.perorder">per order</span></> : <span data-i18n="shop.included">Included at no extra cost</span>}</p>
          </div>
        </a>); })}
    </div>
  </section>

  <section class="shop-sec" id="designs" aria-labelledby="typeH">
    <h2 id="typeH" data-i18n="shop.type.h">Designs for your type of business</h2>
    <p class="muted" data-i18n="shop.type.p">Start with designs made for your line of work. Change every word, color and picture in the designer.</p>
    <div class="shop-grid four">
      {BUSINESS_TYPES.map((b) => (
        <a class="shop-tile type" href={`/cards/design?type=${b.id}`}>
          <div class="shop-pic type"><div class="card-wrap front" set:html={card(b)} /></div>
          <div class="shop-body"><h3 data-i18n={`shop.type.${b.id}`}>{b.name}</h3></div>
        </a>
      ))}
      <a class="shop-tile type" href="/cards/design#step1">
        <div class="shop-pic type"><div class="card-wrap front" set:html={renderCard(makeTemplate('classic', PALETTES[2], SAMPLE, false), 'front')} /></div>
        <div class="shop-body"><h3 data-i18n="shop.type.all">See every design</h3></div>
      </a>
      <a class="shop-tile type upload" href="/cards/design?upload=1">
        <div class="shop-pic type"><div class="upload-art"><span aria-hidden="true">⇪</span><b data-i18n="shop.upload">Upload your design</b></div></div>
        <div class="shop-body"><h3 data-i18n="shop.type.upload">Already have a design?</h3></div>
      </a>
    </div>
  </section>

  <section class="shop-sec shop-how" aria-labelledby="howH">
    <h2 id="howH" data-i18n="shop.how.h">How it works</h2>
    <ol class="ps-steps">
      <li class="ps-step"><b>1</b><span data-i18n="shop.how1">Pick a design or upload your own, and make it yours</span></li>
      <li class="ps-step"><b>2</b><span data-i18n="shop.how2">Choose paper, finish, corners and quantity, then pay online</span></li>
      <li class="ps-step"><b>3</b><span data-i18n="shop.how3">We print and check them, then text you when they're ready to pick up</span></li>
    </ol>
  </section>

  <script>
    // Finish tabs: one panel at a time.
    const tabs = document.querySelectorAll<HTMLButtonElement>('.finish-tab');
    tabs.forEach((b) => b.addEventListener('click', () => {
      tabs.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      document.querySelectorAll<HTMLElement>('.finish-panel').forEach((p) => { p.hidden = p.dataset.f !== b.dataset.f; });
    }));
  </script>
</Base>
