---
import Base from '../../layouts/Base.astro';
import { TEMPLATES, PALETTES, QUANTITIES, PRICES } from '../../lib/cards';
const cancelled = Astro.url.searchParams.get('cancelled');
---
<Base title="Design business cards · Goin' Postal Forsythe" description="Design your own business cards in the browser, see them live, and pick them up printed at Goin' Postal Forsythe.">
  <section class="hero">
    <h1>Design your business cards</h1>
    <p class="lead">Pick a layout, type your details, drop in a logo. What you see is what we print. Pay online, pick up in the shop.</p>
    {cancelled && <p class="card">Payment was cancelled, so no order was placed. Finish the design and pay to order.</p>}
  </section>

  <div class="designer">
    <form id="d" class="controls">
      <fieldset>
        <legend>Layout</legend>
        <div class="choices" id="templates">
          {TEMPLATES.map((t, i) => (
            <label class="choice"><input type="radio" name="template" value={t.id} checked={i === 0} /><span><strong>{t.name}</strong><br/><small>{t.blurb}</small></span></label>
          ))}
        </div>
        <label>Type
          <select name="font">
            <option value="sans">Clean sans-serif</option>
            <option value="serif">Classic serif</option>
            <option value="mono">Typewriter</option>
          </select>
        </label>
        <div class="swatches" id="palettes">
          {PALETTES.map((p, i) => (
            <label class="swatch" title={p.name}><input type="radio" name="palette" value={i} checked={i === 0} /><span style={`background:${p.accent}`}></span></label>
          ))}
        </div>
        <label>Accent color <input type="color" name="accent" value={PALETTES[0].accent} /></label>
      </fieldset>

      <fieldset>
        <legend>Your details</legend>
        <label>Name <input name="name" maxlength="40" value="" placeholder="Rin Ho" /></label>
        <label>Title <input name="title" maxlength="40" placeholder="Owner" /></label>
        <label>Company <input name="company" maxlength="50" placeholder="Goin' Postal Forsythe" /></label>
        <label>Phone <input name="phone" maxlength="30" placeholder="(318) 000-0000" /></label>
        <label>Email <input name="email" maxlength="60" placeholder="you@example.com" /></label>
        <label>Website <input name="website" maxlength="60" placeholder="example.com" /></label>
        <label>Address <input name="address" maxlength="80" placeholder="Forsythe Ave & N 18th St, Monroe, LA" /></label>
        <label id="bandTextRow">Band text, shown when there is no logo (initials or a short word) <input name="bandText" maxlength="12" placeholder="GP" /></label>
        <label>Logo (PNG, JPG or SVG, under 400 KB) <input name="logoFile" type="file" accept="image/png,image/jpeg,image/svg+xml" /></label>
        <button type="button" class="btn kraft small" id="clearLogo" hidden>Remove logo</button>
      </fieldset>

      <fieldset>
        <legend>Back of card</legend>
        <label><input type="radio" name="back" value="logo" checked /> Logo or company name on the accent color</label>
        <label><input type="radio" name="back" value="tagline" /> A tagline</label>
        <label><input type="radio" name="back" value="none" /> Blank</label>
        <label>Tagline <input name="tagline" maxlength="60" placeholder="Ship it. Pack it. Print it." /></label>
      </fieldset>
    </form>

    <div class="preview">
      <h3>Example <span class="muted">(this layout and colors, sample details)</span></h3>
      <div class="card-wrap example" id="example"></div>
      <h3>Your card, front <span class="muted">(fills in as you type)</span></h3>
      <div class="card-wrap" id="front"></div>
      <h3>Your card, back</h3>
      <div class="card-wrap" id="back"></div>
      <p class="muted">Dashed line is the safe area. Keep text inside it. 3.5 × 2 in, 300 dpi.</p>
      <p><button class="btn kraft" type="button" id="png">Download PNG</button></p>

      <form id="order" class="order card">
        <h3>Order and pay</h3>
        <p class="muted">Pay by card now. We print them and you pick them up in the shop.</p>
        <label>Quantity
          <select name="quantity">
            {QUANTITIES.map((q) => <option value={q}>{q} cards · ${PRICES[q].toFixed(2)}</option>)}
          </select>
        </label>
        <label>Your name <input name="cname" required /></label>
        <label>Email <input name="cemail" type="email" required /></label>
        <label>Phone (we text when ready) <input name="cphone" type="tel" /></label>
        <label>Notes <input name="notes" maxlength="300" placeholder="Matte or glossy, rounded corners..." /></label>
        <button class="btn" type="submit" id="orderBtn">Pay and order</button>
        <p class="err" id="err" hidden></p>
      </form>
    </div>
  </div>

  <script>
    import { renderCard, PALETTES, DEFAULT_DESIGN, CARD_W, CARD_H, type Design } from '../../lib/cards';

    const f = document.getElementById('d') as HTMLFormElement;
    const exampleEl = document.getElementById('example')!;
    const frontEl = document.getElementById('front')!;
    const backEl = document.getElementById('back')!;
    const clearLogo = document.getElementById('clearLogo')!;
    let logo: string | null = null;

    const initials = (n: string) => n.split(/\s+/).map((w) => w[0] ?? '').join('').slice(0, 3).toUpperCase();
    function design(): Design {
      const d = Object.fromEntries(new FormData(f).entries()) as Record<string, string>;
      const pal = PALETTES[Number(d.palette)] ?? PALETTES[0];
      const v = (k: string) => (d[k] ?? '').trim();
      return {
        template: d.template as Design['template'],
        font: d.font as Design['font'],
        accent: d.accent || pal.accent, ink: pal.ink, paper: pal.paper,
        name: v('name'), title: v('title'), company: v('company'),
        phone: v('phone'), email: v('email'), website: v('website'),
        address: v('address'), tagline: v('tagline'),
        bandText: v('bandText') || initials(v('name')),
        logo, back: d.back as Design['back'],
      };
    }
    // Same layout, type and colors as the customer picked, but with the sample details.
    function example(d: Design): Design {
      return { ...DEFAULT_DESIGN, template: d.template, font: d.font, accent: d.accent, ink: d.ink, paper: d.paper, back: d.back, logo: null };
    }

    function draw() {
      const d = design();
      (document.getElementById('bandTextRow') as HTMLElement).hidden = d.template !== 'band' || !!logo;
      exampleEl.innerHTML = renderCard(example(d), 'front');
      frontEl.innerHTML = renderCard(d, 'front', { guides: true });
      const b = renderCard(d, 'back', { guides: true });
      backEl.innerHTML = b || '<p class="muted">Blank</p>';
    }

    f.addEventListener('input', draw);
    f.addEventListener('change', draw);
    (f.querySelector('[name=palette]') as HTMLElement).closest('.swatches')!.addEventListener('change', () => {
      const pal = PALETTES[Number((new FormData(f)).get('palette'))];
      (f.querySelector('[name=accent]') as HTMLInputElement).value = pal.accent;
      draw();
    });

    (f.querySelector('[name=logoFile]') as HTMLInputElement).addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      if (file.size > 400_000) { alert('Logo must be under 400 KB. Try a smaller PNG.'); return; }
      const r = new FileReader();
      r.onload = () => { logo = String(r.result); clearLogo.hidden = false; draw(); };
      r.readAsDataURL(file);
    });
    clearLogo.addEventListener('click', () => { logo = null; clearLogo.hidden = true; (f.querySelector('[name=logoFile]') as HTMLInputElement).value = ''; draw(); });

    document.getElementById('png')!.addEventListener('click', async () => {
      const d = design();
      for (const side of ['front', 'back'] as const) {
        const svg = renderCard(d, side);
        if (!svg) continue;
        const img = new Image();
        img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
        await img.decode();
        const c = document.createElement('canvas'); c.width = CARD_W; c.height = CARD_H;
        c.getContext('2d')!.drawImage(img, 0, 0);
        const a = document.createElement('a'); a.download = `business-card-${side}.png`; a.href = c.toDataURL('image/png'); a.click();
      }
    });

    const order = document.getElementById('order') as HTMLFormElement;
    const err = document.getElementById('err')!;
    order.addEventListener('submit', async (e) => {
      e.preventDefault();
      const o = Object.fromEntries(new FormData(order).entries()) as Record<string, string>;
      if (!design().name) { err.textContent = 'Type at least a name on the card first.'; err.hidden = false; return; }
      const btn = document.getElementById('orderBtn')!; btn.setAttribute('disabled', '');
      const res = await fetch('/api/cards', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ design: design(), quantity: Number(o.quantity), customer: { name: o.cname, email: o.cemail, phone: o.cphone }, notes: o.notes }) });
      const j = await res.json();
      if (!res.ok) { err.textContent = j.error; err.hidden = false; btn.removeAttribute('disabled'); return; }
      location.href = j.next;
    });

    draw();
  </script>
</Base>
