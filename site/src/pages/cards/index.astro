---
import { store } from '../../data/store';
import Base from '../../layouts/Base.astro';
import { TEMPLATES, PALETTES, QUANTITIES, PRICES, FONT_NAMES } from '../../lib/cards';
const cancelled = Astro.url.searchParams.get('cancelled');
---
<Base title={`Design business cards · ${store.name}`} description="Design your own business cards in the browser like Vistaprint, pay online, and pick them up at Goin' Postal Forsythe.">
  <section class="hero">
    <h1 data-i18n="cards.h1">Design your business cards</h1>
    <p class="lead" data-i18n="cards.lead">Pick a design, then click any text on the card to change it. Drag things where you want them. Pay online, pick up in the shop.</p>
    {cancelled && <p class="card" data-i18n="cards.cancelled">Payment was cancelled, so no order was placed. Your design is still here.</p>}
  </section>

  <!-- Step 1: gallery -->
  <section id="step1">
    <h2 data-i18n="cards.step1">1. Pick a design</h2>
    <p class="card" id="resume" hidden><span data-i18n="cards.resume">You have a design in progress on this device.</span> <button type="button" class="btn small" id="resumeBtn" data-i18n="cards.continue">Continue it</button> <button type="button" class="tool" id="discardBtn" data-i18n="cards.discard">Discard it</button></p>
    <p class="muted">{TEMPLATES.length} <span data-i18n="cards.pick">layouts in</span> {PALETTES.length} <span data-i18n="cards.pick2">color schemes, shown with sample details. Pick a color, then a layout. Everything can be changed in the next step.</span></p>
    <div class="swatches" id="palettes">
      {PALETTES.map((p, i) => (
        <label class="swatch" title={p.name}><input type="radio" name="palette" value={i} checked={i === 0} /><span style={`background:${p.accent}`}></span></label>
      ))}
      <span class="muted" id="palName">{PALETTES[0].name}</span>
    </div>
    <div class="gallery" id="gallery"></div>
  </section>

  <!-- Step 2: editor -->
  <section id="step2" hidden>
    <h2 data-i18n="cards.step2">2. Make it yours</h2>
    <div class="editor">
      <div class="stage">
        <div class="toolbar">
          <div class="tabs">
            <button type="button" class="tab active" data-side="front" data-i18n="cards.front">Front</button>
            <button type="button" class="tab" data-side="back" data-i18n="cards.back">Back</button>
          </div>
          <button type="button" class="tool" id="addText" data-i18n="cards.addtext">+ Text</button>
          <label class="tool"><span data-i18n="cards.addimg">+ Logo or photo</span> <input type="file" id="addImage" accept="image/png,image/jpeg,image/svg+xml" hidden /></label>
          <label class="tool"><span data-i18n="cards.bg">Background</span> <input type="color" id="bg" /></label>
          <label class="tool"><span data-i18n="cards.type">Type</span>
            <select id="font">{Object.entries(FONT_NAMES).map(([k, v]) => <option value={k}>{v}</option>)}</select>
          </label>
          <button type="button" class="tool" id="undo" title="Ctrl+Z" data-i18n="cards.undo">Undo</button>
          <button type="button" class="tool" id="redo" title="Ctrl+Y" data-i18n="cards.redo">Redo</button>
          <button type="button" class="tool" id="changeDesign" data-i18n="cards.change">Change design</button>
        </div>
        <div class="canvas card-wrap" id="canvas"></div>
        <p class="muted" data-i18n="cards.safe">Dashed line is the safe area. Keep text inside it. Grey text is sample copy, click it and type yours. Delete key removes the selected item, arrow keys nudge it.</p>
        <p><button class="btn kraft" type="button" id="png" data-i18n="cards.png">Download PNG (free)</button></p>
      </div>

      <aside class="props card" id="props">
        <p class="muted" id="noSel" data-i18n="cards.clicksel">Click something on the card to edit it.</p>
        <div id="textProps" hidden>
          <label><span data-i18n="cards.text">Text</span> <textarea id="pText" rows="3"></textarea></label>
          <label><span data-i18n="cards.size">Size</span> <input id="pSize" type="range" min="12" max="160" /> <span id="pSizeVal"></span></label>
          <div class="btnrow">
            <button type="button" class="tool" id="pBold"><b>B</b></button>
            <button type="button" class="tool" id="pItalic"><i>I</i></button>
            <button type="button" class="tool" data-align="start" data-i18n="cards.left">Left</button>
            <button type="button" class="tool" data-align="middle" data-i18n="cards.center">Center</button>
            <button type="button" class="tool" data-align="end" data-i18n="cards.right">Right</button>
          </div>
          <label><span data-i18n="cards.color">Color</span> <input id="pColor" type="color" /></label>
          <label><span data-i18n="cards.width">Width</span> <input id="pWidth" type="range" min="60" max="1050" /></label>
        </div>
        <div id="imageProps" hidden>
          <label><span data-i18n="cards.width">Width</span> <input id="iWidth" type="range" min="20" max="1050" /></label>
          <label><span data-i18n="cards.height">Height</span> <input id="iHeight" type="range" min="4" max="600" /></label>
          <label><input id="iLock" type="checkbox" checked /> <span data-i18n="cards.lock">Keep proportions</span></label>
        </div>
        <div class="btnrow" id="selActions" hidden>
          <button type="button" class="tool" id="pFront" data-i18n="cards.tofront">Bring to front</button>
          <button type="button" class="tool" id="pBack" data-i18n="cards.toback">Send to back</button>
          <button type="button" class="tool" id="pDup" data-i18n="cards.dup">Duplicate</button>
          <button type="button" class="tool danger" id="pDel" data-i18n="cards.del">Delete</button>
        </div>
      </aside>
    </div>

    <form id="order" class="order card">
      <h3 data-i18n="cards.step3">3. Order and pay</h3>
      <p class="muted" data-i18n="cards.paynow">Pay by card now. We print them and you pick them up in the shop.</p>
      <label><span data-i18n="cards.qty">Quantity</span>
        <select name="quantity">
          {QUANTITIES.map((q) => <option value={q}>{q} · ${PRICES[q].toFixed(2)}</option>)}
        </select>
      </label>
      <label><span data-i18n="cards.yourname">Your name</span> <input name="cname" required /></label>
      <label><span data-i18n="f.email">Email</span> <input name="cemail" type="email" required /></label>
      <label><span data-i18n="cards.phone">Phone (we text when ready)</span> <input name="cphone" type="tel" /></label>
      <label><span data-i18n="cards.notes">Notes</span> <input name="notes" maxlength="300" placeholder="Matte or glossy, rounded corners..." /></label>
      <button class="btn" type="submit" id="orderBtn" data-i18n="cards.order">Pay and order</button>
      <p class="err" id="err" hidden></p>
    </form>
  </section>

  <script>
    import { renderCard, makeTemplate, PALETTES, TEMPLATES, SAMPLE, uid, CARD_W, CARD_H, type Design, type TextEl, type ImageEl, type TemplateId } from '../../lib/cards';
    import { t } from '../../i18n';

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const step1 = $('step1'), step2 = $('step2'), canvas = $('canvas');

    // Placeholder copy the customer replaces. Same layout as the sample, generic words.
    const BLANK = { name: 'Your Name', title: 'Your Title', company: 'Company Name', phone: '(000) 000-0000', email: 'you@example.com', website: 'yourwebsite.com', address: 'Street, City, State', tagline: 'Your tagline here' };

    let design: Design;
    let side: 'front' | 'back' = 'front';
    let selected: string | null = null;
    const undoStack: string[] = [], redoStack: string[] = [];

    function snapshot() { undoStack.push(JSON.stringify(design)); if (undoStack.length > 60) undoStack.shift(); redoStack.length = 0; }
    function restore(s: string) { design = JSON.parse(s); selected = null; render(); }

    const cur = () => design[side];
    const sel = () => cur().elements.find((e) => e.id === selected) ?? null;

    function render() {
      canvas.innerHTML = renderCard(design, side, { guides: true, editing: true, selected });
      ($('bg') as HTMLInputElement).value = cur().bg;
      ($('font') as HTMLSelectElement).value = design.font;
      document.querySelectorAll('.tab').forEach((t) => t.classList.toggle('active', (t as HTMLElement).dataset.side === side));
      renderProps();
      try { localStorage.setItem('gp-card-design', JSON.stringify(design)); } catch {}
    }

    function renderProps() {
      const e = sel();
      $('noSel').hidden = !!e;
      $('selActions').hidden = !e;
      $('textProps').hidden = !(e && e.type === 'text');
      $('imageProps').hidden = !(e && e.type === 'image');
      if (!e) return;
      if (e.type === 'text') {
        const ta = $('pText') as HTMLTextAreaElement;
        if (document.activeElement !== ta) { ta.value = e.placeholder ? '' : e.text; ta.placeholder = e.placeholder ? e.text : ''; }
        ($('pSize') as HTMLInputElement).value = String(e.size); $('pSizeVal').textContent = `${e.size}`;
        ($('pColor') as HTMLInputElement).value = e.color;
        ($('pWidth') as HTMLInputElement).value = String(e.w);
        $('pBold').classList.toggle('active', e.weight === 700);
        $('pItalic').classList.toggle('active', e.italic);
        document.querySelectorAll('[data-align]').forEach((b) => b.classList.toggle('active', (b as HTMLElement).dataset.align === e.align));
      } else {
        ($('iWidth') as HTMLInputElement).value = String(e.w);
        ($('iHeight') as HTMLInputElement).value = String(e.h);
      }
    }

    function start(t: TemplateId, pi: number) {
      design = makeTemplate(t, PALETTES[pi], BLANK, true);
      undoStack.length = 0; redoStack.length = 0; selected = null; side = 'front';
      step1.hidden = true; step2.hidden = false; render();
      step2.scrollIntoView({ behavior: 'smooth' });
    }

    // ---- gallery: one thumbnail per layout in the chosen palette, drawn with Rin Ho's sample details
    const gallery = $('gallery');
    function drawGallery() {
      const pi = Number((document.querySelector('[name=palette]:checked') as HTMLInputElement).value);
      $('palName').textContent = PALETTES[pi].name;
      gallery.innerHTML = TEMPLATES.map((tp) => `<button type="button" class="thumb" data-t="${tp.id}" data-p="${pi}" title="${tp.name}"><div class="card-wrap">${renderCard(makeTemplate(tp.id, PALETTES[pi], SAMPLE, false), 'front')}</div><span>${tp.name}</span></button>`).join('');
      gallery.querySelectorAll<HTMLElement>('.thumb').forEach((b) => b.addEventListener('click', () => start(b.dataset.t as TemplateId, Number(b.dataset.p))));
    }
    $('palettes').addEventListener('change', drawGallery);
    drawGallery();
    $('changeDesign').addEventListener('click', () => { if (confirm(t('cards.changeconfirm'))) { step2.hidden = true; step1.hidden = false; step1.scrollIntoView(); } });

    // A saved design is offered, never forced: the gallery always shows first.
    try {
      const saved = localStorage.getItem('gp-card-design');
      if (saved) {
        $('resume').hidden = false;
        $('resumeBtn').addEventListener('click', () => { design = JSON.parse(saved); side = 'front'; selected = null; step1.hidden = true; step2.hidden = false; render(); step2.scrollIntoView({ behavior: 'smooth' }); });
        $('discardBtn').addEventListener('click', () => { localStorage.removeItem('gp-card-design'); $('resume').hidden = true; });
      }
    } catch {}

    // ---- tabs, background, font, undo
    document.querySelectorAll<HTMLElement>('.tab').forEach((t) => t.addEventListener('click', () => { side = t.dataset.side as 'front' | 'back'; selected = null; render(); }));
    $('bg').addEventListener('input', (e) => { cur().bg = (e.target as HTMLInputElement).value; render(); });
    $('bg').addEventListener('change', snapshot);
    $('font').addEventListener('change', (e) => { snapshot(); design.font = (e.target as HTMLSelectElement).value as Design['font']; render(); });
    $('undo').addEventListener('click', () => { const s = undoStack.pop(); if (s) { redoStack.push(JSON.stringify(design)); restore(s); } });
    $('redo').addEventListener('click', () => { const s = redoStack.pop(); if (s) { undoStack.push(JSON.stringify(design)); restore(s); } });

    // ---- add elements
    $('addText').addEventListener('click', () => {
      snapshot();
      const el: TextEl = { id: uid(), type: 'text', x: 200, y: 260, w: 650, text: 'New text', size: 32, weight: 400, italic: false, color: side === 'back' ? '#ffffff' : '#17202d', align: 'middle' };
      cur().elements.push(el); selected = el.id; render(); ($('pText') as HTMLTextAreaElement).focus();
    });
    $('addImage').addEventListener('change', (e) => {
      const input = e.target as HTMLInputElement;
      const file = input.files?.[0]; if (!file) return;
      if (file.size > 400_000) { alert(t('cards.imgbig')); input.value = ''; return; }
      const r = new FileReader();
      r.onload = () => {
        const img = new Image();
        img.onload = () => {
          snapshot();
          const w = 300, h = Math.round(w * img.height / img.width) || 150;
          const el: ImageEl = { id: uid(), type: 'image', x: (CARD_W - w) / 2, y: (CARD_H - h) / 2, w, h, href: String(r.result) };
          cur().elements.push(el); selected = el.id; render();
        };
        img.src = String(r.result);
      };
      r.readAsDataURL(file);
      input.value = '';
    });

    // ---- properties
    const upd = (fn: (e: any) => void, snap = false) => () => { const e = sel(); if (!e) return; if (snap) snapshot(); fn(e); render(); };
    $('pText').addEventListener('input', upd((e: TextEl) => { e.text = ($('pText') as HTMLTextAreaElement).value; e.placeholder = false; }));
    $('pText').addEventListener('focus', () => { if (sel()?.type === 'text') snapshot(); });
    $('pSize').addEventListener('input', upd((e: TextEl) => { e.size = Number(($('pSize') as HTMLInputElement).value); }));
    $('pWidth').addEventListener('input', upd((e: TextEl) => { e.w = Number(($('pWidth') as HTMLInputElement).value); }));
    $('pColor').addEventListener('input', upd((e: TextEl) => { e.color = ($('pColor') as HTMLInputElement).value; }));
    for (const id of ['pSize', 'pWidth', 'pColor', 'iWidth', 'iHeight']) $(id).addEventListener('change', snapshot);
    $('pBold').addEventListener('click', upd((e: TextEl) => { e.weight = e.weight === 700 ? 400 : 700; }, true));
    $('pItalic').addEventListener('click', upd((e: TextEl) => { e.italic = !e.italic; }, true));
    document.querySelectorAll<HTMLElement>('[data-align]').forEach((b) => b.addEventListener('click', upd((e: TextEl) => { e.align = b.dataset.align as TextEl['align']; }, true)));
    $('iWidth').addEventListener('input', upd((e: ImageEl) => { const w = Number(($('iWidth') as HTMLInputElement).value); if (($('iLock') as HTMLInputElement).checked) e.h = Math.max(4, Math.round(e.h * w / e.w)); e.w = w; }));
    $('iHeight').addEventListener('input', upd((e: ImageEl) => { const h = Number(($('iHeight') as HTMLInputElement).value); if (($('iLock') as HTMLInputElement).checked) e.w = Math.max(20, Math.round(e.w * h / e.h)); e.h = h; }));
    $('pDel').addEventListener('click', () => { if (!sel()) return; snapshot(); cur().elements = cur().elements.filter((e) => e.id !== selected); selected = null; render(); });
    $('pDup').addEventListener('click', () => { const e = sel(); if (!e) return; snapshot(); const c = { ...e, id: uid(), x: e.x + 30, y: e.y + 30 }; cur().elements.push(c); selected = c.id; render(); });
    $('pFront').addEventListener('click', () => { const e = sel(); if (!e) return; snapshot(); cur().elements = [...cur().elements.filter((x) => x !== e), e]; render(); });
    $('pBack').addEventListener('click', () => { const e = sel(); if (!e) return; snapshot(); cur().elements = [e, ...cur().elements.filter((x) => x !== e)]; render(); });

    // ---- select and drag on the canvas
    let drag: { id: string; dx: number; dy: number; moved: boolean } | null = null;
    function toCard(ev: PointerEvent) {
      const svg = canvas.querySelector('svg')!;
      const r = svg.getBoundingClientRect();
      return { x: (ev.clientX - r.left) * CARD_W / r.width, y: (ev.clientY - r.top) * CARD_H / r.height };
    }
    canvas.addEventListener('pointerdown', (ev) => {
      const id = (ev.target as Element).closest('[data-id]')?.getAttribute('data-id') ?? null;
      selected = id;
      if (id) {
        const e = sel()!; const p = toCard(ev);
        drag = { id, dx: p.x - e.x, dy: p.y - e.y, moved: false };
        canvas.setPointerCapture(ev.pointerId);
      }
      render();
    });
    canvas.addEventListener('pointermove', (ev) => {
      if (!drag) return;
      const e = sel(); if (!e) return;
      if (!drag.moved) { snapshot(); drag.moved = true; }
      const p = toCard(ev);
      e.x = Math.round(p.x - drag.dx); e.y = Math.round(p.y - drag.dy);
      render();
    });
    canvas.addEventListener('pointerup', () => { drag = null; });
    canvas.addEventListener('dblclick', () => { if (sel()?.type === 'text') ($('pText') as HTMLTextAreaElement).focus(); });

    document.addEventListener('keydown', (ev) => {
      const inField = ['INPUT', 'TEXTAREA', 'SELECT'].includes((ev.target as HTMLElement).tagName);
      if ((ev.ctrlKey || ev.metaKey) && ev.key.toLowerCase() === 'z') { ev.preventDefault(); $('undo').click(); return; }
      if ((ev.ctrlKey || ev.metaKey) && ev.key.toLowerCase() === 'y') { ev.preventDefault(); $('redo').click(); return; }
      if (inField) return;
      const e = sel(); if (!e) return;
      const step = ev.shiftKey ? 20 : 4;
      if (ev.key === 'Delete' || ev.key === 'Backspace') { ev.preventDefault(); $('pDel').click(); }
      else if (ev.key.startsWith('Arrow')) {
        ev.preventDefault(); snapshot();
        if (ev.key === 'ArrowLeft') e.x -= step; if (ev.key === 'ArrowRight') e.x += step; if (ev.key === 'ArrowUp') e.y -= step; if (ev.key === 'ArrowDown') e.y += step;
        render();
      }
    });

    // ---- export
    function printable(): Design {
      // Placeholder text the customer never edited is dropped, not printed.
      const strip = (s: Design['front']) => ({ ...s, elements: s.elements.filter((e) => !(e.type === 'text' && e.placeholder)) });
      return { ...design, front: strip(design.front), back: strip(design.back) };
    }
    $('png').addEventListener('click', async () => {
      const d = printable();
      for (const s of ['front', 'back'] as const) {
        const img = new Image();
        img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(renderCard(d, s));
        await img.decode();
        const c = document.createElement('canvas'); c.width = CARD_W; c.height = CARD_H;
        c.getContext('2d')!.drawImage(img, 0, 0);
        const a = document.createElement('a'); a.download = `business-card-${s}.png`; a.href = c.toDataURL('image/png'); a.click();
      }
    });

    const order = $('order') as HTMLFormElement, err = $('err');
    order.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const d = printable();
      const left = [...design.front.elements, ...design.back.elements].filter((e) => e.type === 'text' && e.placeholder).length;
      if (left && !confirm(`${left} ${t('cards.leftph')}`)) return;
      if (!d.front.elements.some((e) => e.type === 'text')) { err.textContent = t('cards.nofront'); err.hidden = false; return; }
      const o = Object.fromEntries(new FormData(order).entries()) as Record<string, string>;
      const btn = $('orderBtn'); btn.setAttribute('disabled', '');
      const res = await fetch('/api/cards', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ design: d, quantity: Number(o.quantity), customer: { name: o.cname, email: o.cemail, phone: o.cphone }, notes: o.notes }) });
      const j = await res.json();
      if (!res.ok) { err.textContent = j.error; err.hidden = false; btn.removeAttribute('disabled'); return; }
      try { localStorage.removeItem('gp-card-design'); } catch {}
      location.href = j.next;
    });
  </script>
</Base>
