---
import Base from '../layouts/Base.astro';
import { store } from '../data/store';
import spec from '../../public/openapi.json';

// Hosted API docs (T25), rendered from public/openapi.json at build time so the page and the spec
// cannot drift. The JSON itself is at /openapi.json for Postman, Insomnia, code generators.
type Schema = any;
const s: any = spec;
const schemas: Record<string, Schema> = s.components.schemas;
const deref = (x: any): any => (x && x.$ref ? deref(x.$ref.split('/').reduce((o: any, k: string) => (k === '#' ? s : o[k]), s)) : x);
const typeOf = (p: any): string => {
  p = deref(p);
  if (!p) return '';
  if (p.allOf) return p.allOf.map(typeOf).join(' + ');
  if (p.$ref) return p.$ref.split('/').pop();
  const t = Array.isArray(p.type) ? p.type.join(' | ') : p.type ?? '';
  if (t === 'array') return `array of ${p.items?.$ref ? p.items.$ref.split('/').pop() : typeOf(p.items)}`;
  if (p.enum) return p.enum.join(' | ');
  if (p.const) return `"${p.const}"`;
  return t + (p.format ? ` (${p.format})` : '');
};
const props = (schema: any): { name: string; type: string; required: boolean; desc: string }[] => {
  schema = deref(schema);
  if (!schema) return [];
  if (schema.allOf) return schema.allOf.flatMap(props);
  const req: string[] = schema.required ?? [];
  return Object.entries(schema.properties ?? {}).map(([name, p]: [string, any]) => ({ name, type: typeOf(p), required: req.includes(name), desc: deref(p)?.description ?? p.description ?? '' }));
};
const ops: { path: string; method: string; op: any }[] = [];
for (const [path, item] of Object.entries<any>(s.paths)) for (const [method, op] of Object.entries<any>(item)) ops.push({ path, method: method.toUpperCase(), op });
const refName = (x: any) => (x?.$ref ? x.$ref.split('/').pop() : null);
// Spec text is translated by its English text as the key (src/i18n/api.ts); the browser swaps it on language change.
const code = (x: string) => x.replace(/`([^`]+)`/g, '<code>$1</code>');
---
<Base title={`API for developers · ${store.name}`} description="The PeterShip public API: rates, labels, tracking, batches and pickups for business accounts, with an OpenAPI 3.1 spec.">
  <section class="hero">
    <h1>PeterShip API, <span data-i18n="dev.version">version</span> {s.info.version}</h1>
    <p class="lead" data-i18n={s.info.summary}>{s.info.summary}</p>
    <p class="btnrow"><a class="btn" href="/openapi.json" download data-i18n="dev.json">OpenAPI 3.1 JSON</a> <a class="btn kraft" href="https://github.com/wbp318/goin-postal-forsythe/blob/main/shipping-client/api/README.md" target="_blank" rel="noopener" data-i18n="dev.guide">Guide with curl examples</a> <a class="btn kraft" href="/contact" data-i18n="dev.key">Ask for a key</a></p>
  </section>
  <div class="card">
    <h3 data-i18n="dev.before">Before you start</h3>
    <p data-i18n={s.info.description} data-i18n-html set:html={code(s.info.description)} />
    <p><strong data-i18n="dev.base">Base URL:</strong> <code>{s.servers[0].url}</code>. <span data-i18n={s.servers[0].description}>{s.servers[0].description}</span></p>
    <p><strong data-i18n="dev.auth">Auth:</strong> <code>Authorization: Bearer psk_…</code>. <span data-i18n={s.components.securitySchemes.bearer.description}>{s.components.securitySchemes.bearer.description}</span>.</p>
  </div>
  {ops.map(({ path, method, op }) => {
    const body = op.requestBody?.content?.['application/json']?.schema;
    const ok = Object.entries<any>(op.responses).find(([code]) => code.startsWith('2'));
    const okSchema = ok?.[1]?.content?.['application/json']?.schema;
    return (
      <div class="card" id={op.operationId}>
        <h3><code>{method} {path}</code></h3>
        <p data-i18n={op.summary}>{op.summary}</p>
        {op.parameters?.length > 0 && <p class="muted">{op.parameters.map((p: any) => { const d = deref(p); return <span>{d.in} {d.name}{d.required ? <> (<span data-i18n="dev.required">required</span>)</> : null}: {typeOf(d.schema)}{d.description ? <>, <span data-i18n={d.description}>{d.description}</span></> : null} </span>; })}</p>}
        {body && <>
          <h4 data-i18n="dev.request">Request</h4>
          <table class="list"><thead><tr><th data-i18n="dev.field">Field</th><th data-i18n="dev.type">Type</th><th></th></tr></thead><tbody>{props(body).map((f) => <tr><td><code>{f.name}</code>{f.required && <span class="muted"> <span data-i18n="dev.required">required</span></span>}</td><td>{f.type}</td><td class="muted" data-i18n={f.desc || undefined}>{f.desc}</td></tr>)}</tbody></table>
        </>}
        {ok && <>
          <h4><span data-i18n="dev.response">Response</span> {ok[0]}</h4>
          <p class="muted" data-i18n={ok[1].description}>{ok[1].description}</p>
          {okSchema && props(okSchema).length > 0 && <table class="list"><thead><tr><th data-i18n="dev.field">Field</th><th data-i18n="dev.type">Type</th><th></th></tr></thead><tbody>{props(okSchema).map((f) => <tr><td><code>{f.name}</code></td><td>{f.type}</td><td class="muted" data-i18n={f.desc || undefined}>{f.desc}</td></tr>)}</tbody></table>}
        </>}
        <p class="muted"><span data-i18n="dev.errors">Errors:</span> {Object.entries<any>(op.responses).filter(([c]) => !c.startsWith('2')).map(([c, r]) => <span>{c} <span data-i18n={deref(r).description}>{deref(r).description}</span> </span>)}</p>
      </div>
    );
  })}
  <div class="card" id="webhooks">
    <h3><span data-i18n="dev.webhook">Webhook</span> <code>shipment.tracking</code></h3>
    <p><span data-i18n={s.webhooks['shipment.tracking'].post.summary}>{s.webhooks['shipment.tracking'].post.summary}</span>.</p>
    <p class="muted" data-i18n={s.webhooks['shipment.tracking'].post.description} data-i18n-html set:html={code(s.webhooks['shipment.tracking'].post.description)} />
    <table class="list"><thead><tr><th data-i18n="dev.field">Field</th><th data-i18n="dev.type">Type</th></tr></thead><tbody>{props(s.webhooks['shipment.tracking'].post.requestBody.content['application/json'].schema).map((f) => <tr><td><code>{f.name}</code></td><td>{f.type}</td></tr>)}</tbody></table>
  </div>
  <div class="card" id="schemas">
    <h3 data-i18n="dev.objects">Objects</h3>
    {Object.entries(schemas).map(([name, sch]) => <details><summary><code>{name}</code>{(sch as any).description ? <span class="muted"> <span data-i18n={(sch as any).description}>{(sch as any).description}</span></span> : null}</summary><table class="list"><tbody>{props(sch).map((f) => <tr><td><code>{f.name}</code>{f.required && <span class="muted"> <span data-i18n="dev.required">required</span></span>}</td><td>{f.type}</td><td class="muted" data-i18n={f.desc || undefined}>{f.desc}</td></tr>)}</tbody></table></details>)}
  </div>
  <p class="muted" data-i18n="dev.shopify">A listed Shopify app (OAuth) is on the to-do list; today a Shopify shop connects with the custom-app token the connector README describes.</p>
</Base>
