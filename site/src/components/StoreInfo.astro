---
import { store } from '../data/store';
const tel = store.phone.replace(/\D/g, '');
---
<dl class="label" id="hours">
  <dt>Ship to</dt><dd>{store.name}</dd>
  <dt>Address</dt><dd>{store.address}</dd>
  <dt>Phone</dt><dd><a href={`tel:${tel}`}>{store.phone}</a></dd>
  <dt>Hours</dt>
  {store.hours.map(h => <dd>{h.days}: {h.open}</dd>)}
</dl>
