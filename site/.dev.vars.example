# Copy to .dev.vars for local development. Leave a value blank to run that piece in mock mode.
# Nothing in this file is ever committed.

# Staff PIN for the counter pages and the parity endpoint.
COUNTER_PIN=1234
# Optional owner PIN. When set, only it can save price rules at /counter/rules; staff can still view them.
# Both shared PINs are stop-gaps: give everyone a personal PIN at /counter/staff, then remove these two
# so the audit log always carries a real name.
OWNER_PIN=

# Shared secret for the counter printer agent (shipping-client/printer-agent). Any long random string.
PRINTER_KEY=change-me
# Receipts and Z-reports print as 4x6 ZPL on the Zebra. Set escpos if the shop has a till-roll receipt printer configured in the agent.
RECEIPT_FORMAT=

# Customer updates (PeterShip Phase 4). Blank = messages are logged in the terminal, nothing sent.
# Resend: resend.com, API Keys. MAIL_FROM must be on a domain verified there. STAFF_EMAIL gets exception alerts.
RESEND_API_KEY=
MAIL_FROM=
STAFF_EMAIL=
# Twilio: console.twilio.com. TWILIO_FROM is the shop's texting number in +1 form.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Stripe: dashboard > Developers > API keys (sk_test_ for testing). Webhook secret from Developers > Webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rates and labels. Easyship is the single-call fallback covering all four carriers.
# Dashboard > APIs & Webhooks > Create API Connection. sand_ for testing, prod_ live.
EASYSHIP_TOKEN=

# Direct carriers (PeterShip, agenda item 44). Each switches on when its keys are present
# and takes over its own carrier; Easyship fills in the rest. Leave blank until the owners
# finish each developer-portal sign-up (issue 12).
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
USPS_CRID=
USPS_MID=
USPS_MANIFEST_MID=
USPS_ACCOUNT_NUMBER=
USPS_SANDBOX=1

UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_SANDBOX=1

FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_SANDBOX=1

DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
DHL_SANDBOX=1
